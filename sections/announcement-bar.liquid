{%- style -%}
  #shopify-section-{{ section.id }} .pst-announcement-bar {
    background-color: {{ section.settings.bar_background }};
    color: {{ section.settings.text_color }};
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    padding: 0.9rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      gap: 1.5rem;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__left {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__badge {
    display: inline-flex;
    align-items: center;
    background-color: {{ section.settings.badge_color }};
    color: #fff;
    font-weight: 600;
    font-size: 1.2rem;
    padding: 0.35rem 0.9rem;
    border-radius: 0.4rem;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__tagline {
    color: {{ section.settings.text_color }};
    font-weight: 400;
    opacity: 0.95;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar__right {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__link-accent {
    color: var(--pst-color-gold, #f5b731);
    text-decoration: none;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__link-accent:hover,
  #shopify-section-{{ section.id }} .pst-announcement-bar__link-accent:focus {
    text-decoration: underline;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar {
      padding: 0.6rem 1rem;
      font-size: clamp(1.15rem, 3.2vw, 1.3rem);
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__inner {
      padding: 0.65rem 1rem;
      width: 100%;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__badge {
      white-space: normal;
      text-align: center;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__tagline {
      max-width: 100%;
    }
  }

{%- endstyle -%}

<div class="pst-announcement-bar">
  <div class="pst-announcement-bar__inner page-width">
    <div class="pst-announcement-bar__left">
      {%- if section.settings.badge_text != blank -%}
        <span class="pst-announcement-bar__badge">{{ section.settings.badge_text | escape }}</span>
      {%- endif -%}
      {%- if section.settings.tagline_text != blank -%}
        <span class="pst-announcement-bar__tagline">{{ section.settings.tagline_text | escape }}</span>
      {%- endif -%}
    </div>
    <div class="pst-announcement-bar__right">
      {%- if section.settings.phone_number != blank -%}
        <a
          class="pst-announcement-bar__link-accent"
          href="{{- section.settings.phone_link | default: 'tel:8885354431' | escape -}}"
        >
          {{- section.settings.phone_number | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.email_address != blank -%}
        <a
          class="pst-announcement-bar__email pst-email pst-announcement-bar__link-accent"
          href="mailto:{{ section.settings.email_address | escape }}"
        >
          {{- section.settings.email_address | escape -}}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "pst-announcement-section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge Text",
      "default": "✓ Purchase Orders Accepted"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Badge Color",
      "default": "#E91E8C"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Tagline Text",
      "default": "Serving schools & districts for 30+ years"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Phone Number",
      "default": "(888) 535-4431"
    },
    {
      "type": "text",
      "id": "phone_link",
      "label": "Phone Link",
      "default": "tel:8885354431"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Email Address",
      "default": "orders@perfectschooltools.com"
    },
    {
      "type": "checkbox",
      "id": "show_email_mobile",
      "label": "Show Email on Mobile",
      "default": false
    },
    {
      "type": "color",
      "id": "bar_background",
      "label": "Bar Background Color",
      "default": "#0A2540"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FDF8F0"
    },
    {
      "type": "text",
      "id": "mobile_line1",
      "label": "Mobile Line 1 Text",
      "default": "✓ Purchase Orders Accepted"
    },
    {
      "type": "text",
      "id": "mobile_line2",
      "label": "Mobile Line 2 Text",
      "default": "(888) 535-4431"
    }
  ]
}
{% endschema %}
