{%- style -%}
  #shopify-section-{{ section.id }} {
    overflow-x: hidden;
    max-width: 100%;
  }

  /* Desktop bar — hide on mobile */
  #shopify-section-{{ section.id }} .pst-announcement-bar--desktop {
    display: flex;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar--mobile {
    display: none;
  }

  /* Mobile bar — hide on desktop, show on mobile */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar--desktop {
      display: none;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar--mobile {
      display: flex;
      flex-direction: column;
      align-items: center;
      text-align: center;
      padding: 6px 16px;
      font-size: 12px;
      gap: 2px;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__mobile-line {
      width: 100%;
    }
  }

  /* Theme editor (html.shopify-design-mode): show both bars — scoped to this section only */
  html.shopify-design-mode #shopify-section-{{ section.id }} .pst-announcement-bar--desktop,
  html.shopify-design-mode #shopify-section-{{ section.id }} .pst-announcement-bar--mobile {
    display: flex;
  }

  html.shopify-design-mode #shopify-section-{{ section.id }} .pst-announcement-bar--mobile {
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: 6px 16px;
    font-size: 12px;
    gap: 2px;
    margin-top: 0.35rem;
    border-top: 1px dashed rgba(255, 255, 255, 0.28);
  }

  html.shopify-design-mode #shopify-section-{{ section.id }} .pst-announcement-bar__mobile-line {
    width: 100%;
  }

  /* Shared styles */
  #shopify-section-{{ section.id }} .pst-announcement-bar {
    width: 100%;
    padding: 8px 20px;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 13px;
    position: relative;
    z-index: 100;
    box-sizing: border-box;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    flex: 1;
    width: 100%;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__left {
    display: flex;
    align-items: center;
    gap: 10px;
    flex-wrap: wrap;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__right {
    display: flex;
    align-items: center;
    gap: 16px;
    flex-wrap: wrap;
    justify-content: flex-end;
  }

  #shopify-section-{{ section.id }} .pst-announcement-badge {
    padding: 2px 10px;
    border-radius: 20px;
    font-size: 12px;
    font-weight: 600;
    color: #fff;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__tagline {
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__phone,
  #shopify-section-{{ section.id }} .pst-announcement-bar__email {
    text-decoration: none;
    font-weight: 600;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__phone:hover,
  #shopify-section-{{ section.id }} .pst-announcement-bar__email:hover,
  #shopify-section-{{ section.id }} .pst-announcement-bar__phone:focus,
  #shopify-section-{{ section.id }} .pst-announcement-bar__email:focus {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__mobile-inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 2px;
  }
{%- endstyle -%}

<!-- DESKTOP BAR — hidden on mobile -->
<div
  class="pst-announcement-bar pst-announcement-bar--desktop"
  style="background-color: {{ section.settings.bar_bg_color }}; color: {{ section.settings.text_color }};"
>
  <div class="pst-announcement-bar__inner">
    <div class="pst-announcement-bar__left">
      {%- if section.settings.badge_text != blank -%}
        <span
          class="pst-announcement-badge"
          style="background-color: {{ section.settings.badge_color }};"
        >
          {{- section.settings.badge_text | escape -}}
        </span>
      {%- endif -%}
      {%- if section.settings.tagline_text != blank -%}
        <span class="pst-announcement-bar__tagline">
          {{- section.settings.tagline_text | escape -}}
        </span>
      {%- endif -%}
    </div>
    <div class="pst-announcement-bar__right">
      {%- if section.settings.phone_number != blank -%}
        <a
          href="{{ section.settings.phone_link | default: 'tel:8885354431' | escape }}"
          class="pst-announcement-bar__phone"
          style="color: {{ section.settings.text_color }};"
        >
          <span aria-hidden="true">📞</span>
          {{ section.settings.phone_number | escape }}
        </a>
      {%- endif -%}
      {%- if section.settings.show_email_desktop and section.settings.email_address != blank -%}
        <a
          href="mailto:{{ section.settings.email_address | escape }}"
          class="pst-announcement-bar__email pst-email"
          style="color: {{ section.settings.text_color }};"
        >
          <span aria-hidden="true">✉️</span>
          {{ section.settings.email_address | escape }}
        </a>
      {%- endif -%}
    </div>
  </div>
</div>

<!-- MOBILE BAR — hidden on desktop -->
<div
  class="pst-announcement-bar pst-announcement-bar--mobile"
  style="background-color: {{ section.settings.bar_bg_color }}; color: {{ section.settings.text_color }};"
>
  <div class="pst-announcement-bar__mobile-inner">
    {%- if section.settings.mobile_line1 != blank -%}
      <div class="pst-announcement-bar__mobile-line">
        {{- section.settings.mobile_line1 | escape -}}
      </div>
    {%- endif -%}
    {%- if section.settings.mobile_line2 != blank -%}
      <div class="pst-announcement-bar__mobile-line">
        {{- section.settings.mobile_line2 | escape -}}
      </div>
    {%- endif -%}
    {%- if section.settings.show_email_mobile and section.settings.mobile_email != blank -%}
      <div class="pst-announcement-bar__mobile-line">
        {{- section.settings.mobile_email | escape -}}
      </div>
    {%- endif -%}
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "pst-announcement-section",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Desktop Bar Settings"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Desktop — Badge Text",
      "default": "Purchase Orders Accepted"
    },
    {
      "type": "color",
      "id": "badge_color",
      "label": "Desktop — Badge Color",
      "default": "#E91E8C"
    },
    {
      "type": "text",
      "id": "tagline_text",
      "label": "Desktop — Tagline Text",
      "default": "Serving schools & districts nationwide"
    },
    {
      "type": "text",
      "id": "phone_number",
      "label": "Desktop — Phone Number",
      "default": "(888) 535-4431"
    },
    {
      "type": "text",
      "id": "phone_link",
      "label": "Desktop — Phone Link",
      "default": "tel:8885354431"
    },
    {
      "type": "text",
      "id": "email_address",
      "label": "Desktop — Email Address",
      "default": "orders@perfectschooltools.com"
    },
    {
      "type": "checkbox",
      "id": "show_email_desktop",
      "label": "Desktop — Show Email",
      "default": true
    },
    {
      "type": "header",
      "content": "Mobile Bar Settings"
    },
    {
      "type": "text",
      "id": "mobile_line1",
      "label": "Mobile — Line 1 Text",
      "default": "(888) 535-4431"
    },
    {
      "type": "text",
      "id": "mobile_line2",
      "label": "Mobile — Line 2 Text",
      "default": "Purchase Orders Accepted"
    },
    {
      "type": "checkbox",
      "id": "show_email_mobile",
      "label": "Mobile — Show Email",
      "default": true
    },
    {
      "type": "text",
      "id": "mobile_email",
      "label": "Mobile — Email Address",
      "default": "orders@perfectschooltools.com"
    },
    {
      "type": "header",
      "content": "Bar Styling"
    },
    {
      "type": "color",
      "id": "bar_bg_color",
      "label": "Background Color",
      "default": "#0A2540"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text Color",
      "default": "#FDF8F0"
    }
  ]
}
{% endschema %}
