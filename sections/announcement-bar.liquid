{%- style -%}
  #shopify-section-{{ section.id }} .pst-announcement-bar {
    background-color: var(--pst-color-primary-dark-navy, #0a2540);
    color: rgba(255, 255, 255, 0.95);
    font-family: var(--font-body-family);
    font-size: 1.3rem;
    line-height: 1.4;
    letter-spacing: 0.02em;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    padding: 0.9rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 0.8rem;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar {
      font-size: 12px;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__inner {
      flex-direction: column;
      gap: 0.5rem;
      padding: 0.65rem 1rem;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__text {
      display: none;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__badge {
      font-size: 12px;
      padding: 0.3rem 0.65rem;
      white-space: normal;
      text-align: center;
      max-width: 100%;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__left {
      width: 100%;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__right {
      width: 100%;
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__email {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .pst-announcement-bar__right a[href^='tel'] {
      font-size: 12px;
    }
  }

  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar__inner {
      flex-direction: row;
      justify-content: space-between;
      text-align: left;
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__left {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.6rem;
  }

  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar__left {
      flex-direction: row;
      align-items: center;
      flex-wrap: wrap;
    }
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__badge {
    display: inline-flex;
    align-items: center;
    background-color: var(--pst-color-magenta, #e91e8c);
    color: #fff;
    font-weight: 600;
    font-size: 1.2rem;
    padding: 0.35rem 0.9rem;
    border-radius: 0.4rem;
    white-space: nowrap;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__text {
    color: rgba(253, 248, 240, 0.95);
    font-weight: 400;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__right {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.4rem;
  }

  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .pst-announcement-bar__right {
      flex-direction: row;
      align-items: center;
      gap: 2rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__right a {
    color: var(--pst-color-gold, #f5b731);
    text-decoration: none;
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .pst-announcement-bar__right a:hover,
  #shopify-section-{{ section.id }} .pst-announcement-bar__right a:focus {
    text-decoration: underline;
  }
{%- endstyle -%}

<div class="pst-announcement-bar">
  <div class="pst-announcement-bar__inner page-width">
    <div class="pst-announcement-bar__left">
      {%- if section.settings.badge_text != blank -%}
        <span class="pst-announcement-bar__badge">{{ section.settings.badge_text | escape }}</span>
      {%- endif -%}
      {%- if section.settings.serving_text != blank -%}
        <span class="pst-announcement-bar__text">{{ section.settings.serving_text | escape }}</span>
      {%- endif -%}
    </div>
    <div class="pst-announcement-bar__right">
      {%- if section.settings.phone != blank -%}
        <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">
          {{- section.settings.phone | escape -}}
        </a>
      {%- endif -%}
      {%- if section.settings.email != blank -%}
        <a class="pst-announcement-bar__email" href="mailto:{{ section.settings.email | escape }}">{{ section.settings.email | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Announcement bar",
  "class": "pst-announcement-section",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "✓ Purchase Orders Accepted"
    },
    {
      "type": "text",
      "id": "serving_text",
      "label": "Serving line",
      "default": "Serving schools & districts for 30+ years"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(888) 535-4431"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email",
      "default": "orders@perfectposter.com"
    }
  ]
}
{% endschema %}
