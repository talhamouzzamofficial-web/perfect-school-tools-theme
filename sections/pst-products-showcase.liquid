<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&family=Outfit:wght@600;700;800&display=swap"
  rel="stylesheet"
>

{%- liquid
  assign pst_pad_top = section.settings.section_padding_top | default: section.settings.padding_top | default: 80
  assign pst_pad_bottom = section.settings.section_padding_bottom | default: section.settings.padding_bottom | default: 80
  assign pst_cards_gap = section.settings.cards_gap | default: 20
  assign pst_card_radius = section.settings.card_border_radius | default: 16
  assign pst_card_padding = section.settings.card_padding | default: 24
  assign pst_hero_h = section.settings.hero_height | default: 200
  assign pst_hero_img_max = pst_hero_h | minus: 32
  if pst_hero_img_max < 40
    assign pst_hero_img_max = 40
  endif
  assign pst_icon_max = pst_hero_h | minus: 48
  if pst_icon_max < 32
    assign pst_icon_max = 32
  endif
  assign pst_title_fs = section.settings.title_font_size | default: 17
  assign pst_feature_fs = section.settings.feature_font_size | default: 14
-%}

{%- style -%}
  /* Section wrapper */
  #shopify-section-{{ section.id }} .pst-showcase {
    padding: {{ pst_pad_top }}px 20px {{ pst_pad_bottom }}px;
    background: #fdf8f0;
  }

  /* Section heading */
  #shopify-section-{{ section.id }} .pst-showcase__heading {
    text-align: center;
    font-family: 'Outfit', sans-serif;
    font-size: clamp(24px, 3vw, 38px);
    font-weight: 800;
    color: #0a2540;
    margin: 0 0 10px;
  }

  #shopify-section-{{ section.id }} .pst-showcase__subheading {
    text-align: center;
    font-family: 'Nunito Sans', sans-serif;
    font-size: 16px;
    color: #334155;
    margin: 0 0 40px;
  }

  /* Grid */
  #shopify-section-{{ section.id }} .pst-showcase__grid {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ pst_cards_gap }}px;
    max-width: 1200px;
    margin: 0 auto;
    align-items: stretch;
  }

  @media (max-width: 900px) {
    #shopify-section-{{ section.id }} .pst-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media (max-width: 540px) {
    #shopify-section-{{ section.id }} .pst-showcase__grid {
      grid-template-columns: 1fr;
    }
  }

  /* Card */
  #shopify-section-{{ section.id }} .pst-showcase__card {
    background: #ffffff;
    border-radius: {{ pst_card_radius }}px;
    box-shadow: 0 2px 16px rgba(10, 37, 64, 0.08);
    border: 1px solid rgba(10, 37, 64, 0.07);
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    transition: transform 0.2s ease, box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-showcase__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 8px 32px rgba(10, 37, 64, 0.13);
  }

  /* Card hero image area — FIXED HEIGHT so all cards consistent */
  #shopify-section-{{ section.id }} .pst-showcase__card-hero {
    width: 100%;
    height: {{ pst_hero_h }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 16px;
    box-sizing: border-box;
    background: transparent;
    overflow: hidden;
  }

  /* Uploaded images — contain within fixed hero height */
  #shopify-section-{{ section.id }} .pst-showcase__hero-img {
    width: auto;
    max-width: 100%;
    height: 100%;
    max-height: {{ pst_hero_img_max }}px;
    object-fit: contain;
    object-position: center;
    display: block;
  }

  /* Emoji fallback */
  #shopify-section-{{ section.id }} .pst-showcase__icon {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 100%;
    line-height: 1;
    font-size: clamp(40px, 18vw, {{ pst_icon_max }}px);
  }

  /* Card body */
  #shopify-section-{{ section.id }} .pst-showcase__card-body {
    padding: {{ pst_card_padding }}px;
    padding-top: 0;
    display: flex;
    flex-direction: column;
    flex: 1;
  }

  /* Card title */
  #shopify-section-{{ section.id }} .pst-showcase__card-title {
    font-family: 'Outfit', sans-serif;
    font-size: {{ pst_title_fs }}px;
    font-weight: 700;
    color: #0a2540;
    margin: 0 0 14px;
    line-height: 1.3;
  }

  /* Feature list */
  #shopify-section-{{ section.id }} .pst-showcase__features {
    list-style: none;
    padding: 0;
    margin: 0 0 20px;
    flex: 1;
  }

  #shopify-section-{{ section.id }} .pst-showcase__features li {
    font-family: 'Nunito Sans', sans-serif;
    font-size: {{ pst_feature_fs }}px;
    color: #334155;
    padding: 4px 0;
    display: flex;
    align-items: center;
    gap: 8px;
    line-height: 1.4;
  }

  #shopify-section-{{ section.id }} .pst-showcase__features li::before {
    content: '\2713';
    color: #e91e8c;
    font-weight: 700;
    font-size: 13px;
    flex-shrink: 0;
  }

  /* Buttons area */
  #shopify-section-{{ section.id }} .pst-showcase__actions {
    display: flex;
    flex-direction: column;
    gap: 10px;
    margin-top: auto;
  }

  /* Quote button */
  #shopify-section-{{ section.id }} .pst-showcase__btn-quote {
    display: block;
    width: 100%;
    padding: 12px 16px;
    background: #e91e8c;
    color: #ffffff;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 700;
    text-align: center;
    border-radius: 8px;
    text-decoration: none;
    transition: background 0.2s ease;
    border: none;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .pst-showcase__btn-quote:hover {
    background: #c4186f;
  }

  /* Learn More button */
  #shopify-section-{{ section.id }} .pst-showcase__btn-learn {
    display: block;
    width: 100%;
    padding: 11px 16px;
    background: transparent;
    color: #0a2540;
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    border-radius: 8px;
    text-decoration: none;
    border: 2px solid #0a2540;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .pst-showcase__btn-learn:hover {
    background: #0a2540;
    color: #ffffff;
  }

  /* Badge (Most Popular / Best Value) */
  #shopify-section-{{ section.id }} .pst-showcase__badge {
    position: absolute;
    top: 12px;
    left: 12px;
    font-family: 'Outfit', sans-serif;
    font-size: 11px;
    font-weight: 700;
    padding: 4px 10px;
    border-radius: 20px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .pst-showcase__badge--popular {
    background: #e91e8c;
    color: #ffffff;
  }

  #shopify-section-{{ section.id }} .pst-showcase__badge--value {
    background: #f5b731;
    color: #0a2540;
  }

  /* Card wrapper for badge positioning */
  #shopify-section-{{ section.id }} .pst-showcase__card-wrap {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
  }
{%- endstyle -%}

<section class="pst-showcase">
  {%- liquid
    assign pst_subheading = section.settings.subheading | default: section.settings.subtitle
    assign pst_quote_label = section.settings.quote_btn_label | default: section.settings.quote_label
    assign pst_quote_href = section.settings.quote_btn_link | default: section.settings.quote_link | default: '/pages/contact'
    assign pst_learn_label = section.settings.learn_btn_label | default: section.settings.learn_label
  -%}
  {%- if section.settings.heading != blank -%}
    <h2 class="pst-showcase__heading">{{ section.settings.heading | escape }}</h2>
  {%- endif -%}
  {%- if pst_subheading != blank -%}
    <p class="pst-showcase__subheading">{{ pst_subheading | escape }}</p>
  {%- endif -%}

  <div class="pst-showcase__grid">
    <article class="pst-showcase__card pst-showcase__card--1">
      {%- assign pm_align = section.settings.poster_maker_align | default: section.settings.cards_default_align | default: 'center' -%}
      <div class="pst-showcase__card-wrap">
        <span class="pst-showcase__badge pst-showcase__badge--popular">{{ 'Most Popular' | escape }}</span>
        <div class="pst-showcase__card-hero">
          {%- if section.settings.poster_maker_image != blank -%}
            {%- assign pm_alt = section.settings.poster_maker_image.alt | default: section.settings.poster_maker_title | default: 'Perfect Poster Maker System' -%}
            {{
              section.settings.poster_maker_image
              | image_url: width: 800
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: pm_alt
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true">&#128424;&#65039;</span>
          {%- endif -%}
        </div>
        <div class="pst-showcase__card-body">
          {%- if section.settings.poster_maker_show_title != false -%}
            <h3 class="pst-showcase__card-title" style="text-align: {{ pm_align }};">
              {{- section.settings.poster_maker_title | escape -}}
            </h3>
          {%- endif -%}
          <ul class="pst-showcase__features">
            <li>24&quot; Full Color Printer</li>
            <li>Full Set of 55ml Ink</li>
            <li>Premium Paper Roll</li>
            <li>Free Digital Content Access</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if pst_quote_label != blank and pst_quote_href != blank -%}
              <a class="pst-showcase__btn-quote" href="{{ pst_quote_href }}">
                {{- pst_quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_pm = section.settings.learn_link_poster_maker
              if _learn_pm == blank
                assign _learn_pm = '/collections/poster-makers-for-schools'
              endif
            -%}
            {%- if pst_learn_label != blank -%}
              <a class="pst-showcase__btn-learn" href="{{ _learn_pm }}">
                {{- pst_learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </article>

    <article class="pst-showcase__card pst-showcase__card--2">
      {%- assign ac_align = section.settings.awards_cut_align | default: section.settings.cards_default_align | default: 'center' -%}
      <div class="pst-showcase__card-wrap">
        <span class="pst-showcase__badge pst-showcase__badge--value">{{ 'Best Value' | escape }}</span>
        <div class="pst-showcase__card-hero">
          {%- if section.settings.awards_cut_image != blank -%}
            {%- assign ac_alt = section.settings.awards_cut_image.alt | default: section.settings.awards_cut_title | default: 'Perfect Awards & Cut System' -%}
            {{
              section.settings.awards_cut_image
              | image_url: width: 800
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: ac_alt
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true">&#127942;</span>
          {%- endif -%}
        </div>
        <div class="pst-showcase__card-body">
          {%- if section.settings.awards_cut_show_title != false -%}
            <h3 class="pst-showcase__card-title" style="text-align: {{ ac_align }};">
              {{- section.settings.awards_cut_title | escape -}}
            </h3>
          {%- endif -%}
          <ul class="pst-showcase__features">
            <li>Full Color High Production Printer</li>
            <li>Full Set 130ml Ink</li>
            <li>Poster Maker Stand With Poster Catch</li>
            <li>Premium Paper Roll & Digital Resources</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if pst_quote_label != blank and pst_quote_href != blank -%}
              <a class="pst-showcase__btn-quote" href="{{ pst_quote_href }}">
                {{- pst_quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_ac = section.settings.learn_link_awards_cut
              if _learn_ac == blank
                assign _learn_ac = '/pages/for-awards-cut-system'
              endif
            -%}
            {%- if pst_learn_label != blank -%}
              <a class="pst-showcase__btn-learn" href="{{ _learn_ac }}">
                {{- pst_learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </article>

    <article class="pst-showcase__card pst-showcase__card--3">
      {%- assign am_align = section.settings.awards_maker_align | default: section.settings.cards_default_align | default: 'center' -%}
      <div class="pst-showcase__card-wrap">
        <div class="pst-showcase__card-hero">
          {%- if section.settings.awards_maker_image != blank -%}
            {%- assign awards_alt = section.settings.awards_maker_image.alt | default: section.settings.awards_maker_title | default: 'Perfect Awards Maker' -%}
            {{
              section.settings.awards_maker_image
              | image_url: width: 800
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: awards_alt
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true">&#127894;&#65039;</span>
          {%- endif -%}
        </div>
        <div class="pst-showcase__card-body">
          {%- if section.settings.awards_maker_show_title != false -%}
            <h3 class="pst-showcase__card-title" style="text-align: {{ am_align }};">
              {{- section.settings.awards_maker_title | escape -}}
            </h3>
          {%- endif -%}
          <ul class="pst-showcase__features">
            <li>Awards Printer</li>
            <li>Template Library</li>
            <li>Plaque Supplies</li>
            <li>Full Ink Set</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if pst_quote_label != blank and pst_quote_href != blank -%}
              <a class="pst-showcase__btn-quote" href="{{ pst_quote_href }}">
                {{- pst_quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_am = section.settings.learn_link_awards_maker
              if _learn_am == blank
                assign _learn_am = '/pages/for-awards-maker'
              endif
            -%}
            {%- if pst_learn_label != blank -%}
              <a class="pst-showcase__btn-learn" href="{{ _learn_am }}">
                {{- pst_learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </article>

    <article class="pst-showcase__card pst-showcase__card--4">
      {%- assign lam_align = section.settings.cold_laminator_align | default: section.settings.cards_default_align | default: 'center' -%}
      <div class="pst-showcase__card-wrap">
        <div class="pst-showcase__card-hero">
          {%- if section.settings.cold_laminator_image != blank -%}
            {%- assign lam_alt = section.settings.cold_laminator_image.alt | default: section.settings.cold_laminator_title | default: 'Cold Laminator System' -%}
            {{
              section.settings.cold_laminator_image
              | image_url: width: 800
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: lam_alt
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true">&#128450;&#65039;</span>
          {%- endif -%}
        </div>
        <div class="pst-showcase__card-body">
          {%- if section.settings.cold_laminator_show_title != false -%}
            <h3 class="pst-showcase__card-title" style="text-align: {{ lam_align }};">
              {{- section.settings.cold_laminator_title | escape -}}
            </h3>
          {%- endif -%}
          <ul class="pst-showcase__features">
            <li>No Heat Required</li>
            <li>Safe for Schools</li>
            <li>Multiple Sizes</li>
            <li>No Electricity</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if pst_quote_label != blank and pst_quote_href != blank -%}
              <a class="pst-showcase__btn-quote" href="{{ pst_quote_href }}">
                {{- pst_quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_lam = section.settings.learn_link_laminator
              if _learn_lam == blank
                assign _learn_lam = '/collections/cold-laminators-for-schools'
              endif
            -%}
            {%- if pst_learn_label != blank -%}
              <a class="pst-showcase__btn-learn" href="{{ _learn_lam }}">
                {{- pst_learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </div>
    </article>
  </div>
</section>

{% schema %}
{
  "name": "PST Products showcase",
  "tag": "section",
  "class": "pst-products-showcase-section",
  "settings": [
    {
      "type": "header",
      "content": "Section layout"
    },
    {
      "type": "range",
      "id": "section_padding_top",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 80
    },
    {
      "type": "range",
      "id": "section_padding_bottom",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 80
    },
    {
      "type": "range",
      "id": "cards_gap",
      "min": 8,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Gap between cards",
      "default": 20
    },
    {
      "type": "range",
      "id": "card_border_radius",
      "min": 0,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card corner radius",
      "default": 16
    },
    {
      "type": "range",
      "id": "card_padding",
      "min": 12,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Card content padding (sides & bottom)",
      "default": 24,
      "info": "Used for the text/button area below the image. Top padding is 0 so it meets the hero."
    },
    {
      "type": "header",
      "content": "Card images"
    },
    {
      "type": "range",
      "id": "hero_height",
      "min": 120,
      "max": 320,
      "step": 4,
      "unit": "px",
      "label": "Hero image area height",
      "default": 200,
      "info": "Applies to all product cards."
    },
    {
      "type": "header",
      "content": "Card typography"
    },
    {
      "type": "range",
      "id": "title_font_size",
      "min": 14,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Card title size",
      "default": 17
    },
    {
      "type": "range",
      "id": "feature_font_size",
      "min": 12,
      "max": 18,
      "step": 1,
      "unit": "px",
      "label": "Feature list text size",
      "default": 14
    },
    {
      "type": "header",
      "content": "Card content"
    },
    {
      "type": "select",
      "id": "cards_default_align",
      "label": "All cards — default title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "poster_maker_image",
      "label": "Poster Maker — product image",
      "info": "Optional. If empty, an emoji placeholder is shown."
    },
    {
      "type": "checkbox",
      "id": "poster_maker_show_title",
      "label": "Poster Maker — show title",
      "default": true
    },
    {
      "type": "text",
      "id": "poster_maker_title",
      "label": "Poster Maker — title",
      "default": "Perfect Poster Maker System"
    },
    {
      "type": "select",
      "id": "poster_maker_align",
      "label": "Poster Maker — title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "awards_cut_image",
      "label": "Awards & Cut — product image"
    },
    {
      "type": "checkbox",
      "id": "awards_cut_show_title",
      "label": "Awards & Cut — show title",
      "default": true
    },
    {
      "type": "text",
      "id": "awards_cut_title",
      "label": "Awards & Cut — title",
      "default": "Perfect Awards & Cut System"
    },
    {
      "type": "select",
      "id": "awards_cut_align",
      "label": "Awards & Cut — title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "awards_maker_image",
      "label": "Awards Maker — product image"
    },
    {
      "type": "checkbox",
      "id": "awards_maker_show_title",
      "label": "Awards Maker — show title",
      "default": true
    },
    {
      "type": "text",
      "id": "awards_maker_title",
      "label": "Awards Maker — title",
      "default": "Perfect Awards Maker"
    },
    {
      "type": "select",
      "id": "awards_maker_align",
      "label": "Awards Maker — title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "image_picker",
      "id": "cold_laminator_image",
      "label": "Cold Laminator — product image"
    },
    {
      "type": "checkbox",
      "id": "cold_laminator_show_title",
      "label": "Cold Laminator — show title",
      "default": true
    },
    {
      "type": "text",
      "id": "cold_laminator_title",
      "label": "Cold Laminator — title",
      "default": "Cold Laminator System"
    },
    {
      "type": "select",
      "id": "cold_laminator_align",
      "label": "Cold Laminator — title alignment",
      "options": [
        { "value": "left", "label": "Left" },
        { "value": "center", "label": "Center" },
        { "value": "right", "label": "Right" }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Buttons"
