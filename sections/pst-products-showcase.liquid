{%- style -%}
  #shopify-section-{{ section.id }} {
    --pst-ps-navy: #0a2540;
    --pst-ps-navy-mid: #0f4872;
    --pst-ps-blue: #1a6ba0;
    --pst-ps-magenta: #e91e8c;
    --pst-ps-magenta-deep: #c2185b;
    --pst-ps-gold: #f5b731;
    --pst-ps-orange: #e65100;
    --pst-ps-slate: #334155;
    --pst-ps-white: #ffffff;
    --pst-ps-shadow: rgba(10, 37, 64, 0.14);
    --pst-ps-shadow-deep: rgba(10, 37, 64, 0.22);
    --pst-ps-radius: 1.2rem;
    --pst-ps-radius-sm: 999px;
  }

  @keyframes pst-ps-fade-in-up {
    from {
      opacity: 0;
      transform: translateY(28px);
    }
    to {
      opacity: 1;
      transform: translateY(0);
    }
  }

  @keyframes pst-ps-badge-pulse {
    0%,
    100% {
      transform: scale(1);
      box-shadow: 0 2px 12px rgba(0, 0, 0, 0.12);
    }
    50% {
      transform: scale(1.04);
      box-shadow: 0 4px 18px rgba(0, 0, 0, 0.18);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    #shopify-section-{{ section.id }} .pst-showcase__card,
    #shopify-section-{{ section.id }} .pst-showcase__badge {
      animation: none !important;
    }

    #shopify-section-{{ section.id }} .pst-showcase__card {
      opacity: 1;
      transform: none;
    }

    #shopify-section-{{ section.id }} .pst-showcase__card:hover {
      transform: none;
    }
  }

  #shopify-section-{{ section.id }} .pst-showcase {
    background-color: var(--pst-ps-white);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    font-family: var(--font-body-family);
  }

  #shopify-section-{{ section.id }} .pst-showcase__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-showcase__inner {
      padding: 0 1rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-showcase__header {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto 3.5rem;
  }

  #shopify-section-{{ section.id }} .pst-showcase__title {
    position: relative;
    display: inline-block;
    margin: 0 0 1rem;
    padding-bottom: 0.85rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--pst-ps-navy);
  }

  #shopify-section-{{ section.id }} .pst-showcase__title::after {
    content: '';
    position: absolute;
    left: 50%;
    bottom: 0;
    transform: translateX(-50%);
    width: min(12rem, 50%);
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, var(--pst-ps-gold), #ffd666);
  }

  #shopify-section-{{ section.id }} .pst-showcase__subtitle {
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 1.75rem);
    line-height: 1.55;
    font-weight: 500;
    color: var(--pst-ps-navy-mid);
  }

  #shopify-section-{{ section.id }} .pst-showcase__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 769px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .pst-showcase__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pst-showcase__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
      align-items: stretch;
    }
  }

  #shopify-section-{{ section.id }} .pst-showcase__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    background: var(--pst-ps-white);
    border-radius: var(--pst-ps-radius);
    overflow: hidden;
    box-shadow: 0 8px 32px var(--pst-ps-shadow);
    transition: transform 0.35s cubic-bezier(0.34, 1.2, 0.64, 1), box-shadow 0.35s ease;
    opacity: 0;
    animation: pst-ps-fade-in-up 0.65s cubic-bezier(0.34, 1.2, 0.64, 1) forwards;
  }

  #shopify-section-{{ section.id }} .pst-showcase__grid .pst-showcase__card:nth-child(1) {
    animation-delay: 0.1s;
  }

  #shopify-section-{{ section.id }} .pst-showcase__grid .pst-showcase__card:nth-child(2) {
    animation-delay: 0.2s;
  }

  #shopify-section-{{ section.id }} .pst-showcase__grid .pst-showcase__card:nth-child(3) {
    animation-delay: 0.3s;
  }

  #shopify-section-{{ section.id }} .pst-showcase__grid .pst-showcase__card:nth-child(4) {
    animation-delay: 0.4s;
  }

  #shopify-section-{{ section.id }} .pst-showcase__card:hover {
    transform: translateY(-8px);
    box-shadow: 0 22px 48px var(--pst-ps-shadow-deep);
  }

  #shopify-section-{{ section.id }} .pst-showcase__card-hero {
    position: relative;
    flex-shrink: 0;
    box-sizing: border-box;
    min-height: 140px;
    height: auto;
    padding: 2.5rem 1.5rem 2rem;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    gap: 0.75rem;
    overflow: visible;
    background: transparent;
  }

  #shopify-section-{{ section.id }} .pst-showcase__badge {
    position: absolute;
    top: 1rem;
    left: 1rem;
    z-index: 2;
    padding: 0.4rem 1rem;
    font-size: 1.15rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    border-radius: var(--pst-ps-radius-sm);
    line-height: 1.3;
    animation: pst-ps-badge-pulse 2.8s ease-in-out infinite;
  }

  #shopify-section-{{ section.id }} .pst-showcase__badge--magenta {
    background: var(--pst-ps-magenta);
    color: var(--pst-ps-white);
    box-shadow: 0 4px 14px rgba(233, 30, 140, 0.45);
  }

  #shopify-section-{{ section.id }} .pst-showcase__badge--gold {
    background: var(--pst-ps-gold);
    color: var(--pst-ps-navy);
    box-shadow: 0 4px 14px rgba(245, 183, 49, 0.45);
  }

  #shopify-section-{{ section.id }} .pst-showcase__icon {
    font-size: 80px;
    line-height: 1;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.15));
  }

  #shopify-section-{{ section.id }} .pst-showcase__hero-img {
    width: auto;
    max-width: 100%;
    height: auto;
    object-fit: contain;
    object-position: center;
    display: block;
    margin: 0 auto;
    flex-shrink: 0;
    filter: drop-shadow(0 4px 12px rgba(0, 0, 0, 0.15));
  }

  #shopify-section-{{ section.id }} .pst-showcase__card-title {
    margin: 0;
    max-width: 20ch;
    font-family: var(--font-heading-family);
    font-size: 1.55rem;
    font-weight: 800;
    line-height: 1.2;
    color: #0a2540;
  }

  #shopify-section-{{ section.id }} .pst-showcase__body {
    flex: 1;
    display: flex;
    flex-direction: column;
    padding: 1.75rem 1.5rem 2rem;
    background: var(--pst-ps-white);
  }

  #shopify-section-{{ section.id }} .pst-showcase__list {
    margin: 0 0 1.75rem;
    padding: 0;
    list-style: none;
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .pst-showcase__list li {
    position: relative;
    padding-left: 1.65rem;
    margin-bottom: 0.55rem;
    font-size: 1.38rem;
    line-height: 1.45;
    color: var(--pst-ps-slate);
  }

  #shopify-section-{{ section.id }} .pst-showcase__list li::before {
    content: '✓';
    position: absolute;
    left: 0;
    top: 0.05em;
    color: var(--pst-ps-gold);
    font-weight: 800;
    font-size: 1.15em;
  }

  #shopify-section-{{ section.id }} .pst-showcase__actions {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .pst-showcase__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.75rem;
    padding: 0 1.35rem;
    font-size: 1.38rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    border-radius: 0.55rem;
    border: 2px solid transparent;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease, transform 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-showcase__btn--quote {
    background-color: var(--pst-ps-magenta);
    color: var(--pst-ps-white);
    border-color: var(--pst-ps-magenta);
  }

  #shopify-section-{{ section.id }} .pst-showcase__btn--quote:hover,
  #shopify-section-{{ section.id }} .pst-showcase__btn--quote:focus {
    background-color: var(--pst-ps-magenta-deep);
    border-color: var(--pst-ps-magenta-deep);
    color: var(--pst-ps-white);
  }

  #shopify-section-{{ section.id }} .pst-showcase__btn--learn {
    background-color: transparent;
    color: var(--pst-ps-navy);
    border-color: var(--pst-ps-navy);
  }

  #shopify-section-{{ section.id }} .pst-showcase__btn--learn:hover,
  #shopify-section-{{ section.id }} .pst-showcase__btn--learn:focus {
    background-color: var(--pst-ps-navy);
    color: var(--pst-ps-white);
    border-color: var(--pst-ps-navy);
  }
{%- endstyle -%}

<section class="pst-showcase">
  <div class="pst-showcase__inner">
    <header class="pst-showcase__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="pst-showcase__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="pst-showcase__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div class="pst-showcase__grid">
      <article class="pst-showcase__card pst-showcase__card--1">
        <div class="pst-showcase__card-hero">
          {%- liquid
            assign poster_maker_size = section.settings.poster_maker_image_size | default: 160
            assign poster_maker_style = 'width: auto; max-width: 100%; height: auto; max-height: ' | append: poster_maker_size | append: 'px; object-fit: contain;'
          -%}
          <span class="pst-showcase__badge pst-showcase__badge--magenta">{{ 'Most Popular' | escape }}</span>
          {%- if section.settings.poster_maker_image != blank -%}
            {%- assign pm_alt = section.settings.poster_maker_image.alt | default: 'Perfect Poster Maker System' -%}
            {{
              section.settings.poster_maker_image
              | image_url: width: 320
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: pm_alt, style: poster_maker_style
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true" style="font-size: {{ poster_maker_size }}px; line-height: 1;">🖨️</span>
          {%- endif -%}
          {%- if section.settings.poster_maker_show_title != false -%}
            <h3 class="pst-showcase__card-title">{{ 'Perfect Poster Maker System' | escape }}</h3>
          {%- endif -%}
        </div>
        <div class="pst-showcase__body">
          <ul class="pst-showcase__list">
            <li>24&quot; Full Color Printer</li>
            <li>Full Set of Ink</li>
            <li>Premium Paper Roll</li>
            <li>Free Digital Content Access</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--quote" href="{{ section.settings.quote_link }}">
                {{- section.settings.quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_pm = section.settings.learn_link_poster_maker
              if _learn_pm == blank
                assign _learn_pm = '/collections/poster-makers-for-schools'
              endif
            -%}
            {%- if section.settings.learn_label != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--learn" href="{{ _learn_pm }}">
                {{- section.settings.learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </article>

      <article class="pst-showcase__card pst-showcase__card--2">
        <div class="pst-showcase__card-hero">
          {%- liquid
            assign awards_cut_size = section.settings.awards_cut_image_size | default: 160
            assign awards_cut_style = 'width: auto; max-width: 100%; height: auto; max-height: ' | append: awards_cut_size | append: 'px; object-fit: contain;'
          -%}
          <span class="pst-showcase__badge pst-showcase__badge--gold">{{ 'Best Value' | escape }}</span>
          {%- if section.settings.awards_cut_image != blank -%}
            {%- assign ac_alt = section.settings.awards_cut_image.alt | default: 'Perfect Awards & Cut System' -%}
            {{
              section.settings.awards_cut_image
              | image_url: width: 320
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: ac_alt, style: awards_cut_style
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true" style="font-size: {{ awards_cut_size }}px; line-height: 1;">🏆</span>
          {%- endif -%}
          {%- if section.settings.awards_cut_show_title != false -%}
            <h3 class="pst-showcase__card-title">{{ 'Perfect Awards & Cut System' | escape }}</h3>
          {%- endif -%}
        </div>
        <div class="pst-showcase__body">
          <ul class="pst-showcase__list">
            <li>Awards Printer</li>
            <li>Cutting System</li>
            <li>Award Templates</li>
            <li>Customized Supplies</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--quote" href="{{ section.settings.quote_link }}">
                {{- section.settings.quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_ac = section.settings.learn_link_awards_cut
              if _learn_ac == blank
                assign _learn_ac = '/pages/for-awards-cut-system'
              endif
            -%}
            {%- if section.settings.learn_label != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--learn" href="{{ _learn_ac }}">
                {{- section.settings.learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </article>

      <article class="pst-showcase__card pst-showcase__card--3">
        <div class="pst-showcase__card-hero">
          {%- liquid
            assign awards_maker_size = section.settings.awards_maker_image_size | default: 160
            assign awards_maker_style = 'width: auto; max-width: 100%; height: auto; max-height: ' | append: awards_maker_size | append: 'px; object-fit: contain;'
          -%}
          {%- if section.settings.awards_maker_image != blank -%}
            {%- assign awards_alt = section.settings.awards_maker_image.alt | default: 'Perfect Awards Maker' -%}
            {{
              section.settings.awards_maker_image
              | image_url: width: 320
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: awards_alt, style: awards_maker_style
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true" style="font-size: {{ awards_maker_size }}px; line-height: 1;">🎖️</span>
          {%- endif -%}
          {%- if section.settings.awards_maker_show_title != false -%}
            <h3 class="pst-showcase__card-title">{{ 'Perfect Awards Maker' | escape }}</h3>
          {%- endif -%}
        </div>
        <div class="pst-showcase__body">
          <ul class="pst-showcase__list">
            <li>Awards Printer</li>
            <li>Template Library</li>
            <li>Plaque Supplies</li>
            <li>Full Ink Set</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--quote" href="{{ section.settings.quote_link }}">
                {{- section.settings.quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_am = section.settings.learn_link_awards_maker
              if _learn_am == blank
                assign _learn_am = '/pages/for-awards-maker'
              endif
            -%}
            {%- if section.settings.learn_label != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--learn" href="{{ _learn_am }}">
                {{- section.settings.learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </article>

      <article class="pst-showcase__card pst-showcase__card--4">
        <div class="pst-showcase__card-hero">
          {%- liquid
            assign cold_laminator_size = section.settings.cold_laminator_image_size | default: 160
            assign cold_laminator_style = 'width: auto; max-width: 100%; height: auto; max-height: ' | append: cold_laminator_size | append: 'px; object-fit: contain;'
          -%}
          {%- if section.settings.cold_laminator_image != blank -%}
            {%- assign lam_alt = section.settings.cold_laminator_image.alt | default: 'Cold Laminator System' -%}
            {{
              section.settings.cold_laminator_image
              | image_url: width: 320
              | image_tag: class: 'pst-showcase__hero-img', loading: 'lazy', alt: lam_alt, style: cold_laminator_style
            }}
          {%- else -%}
            <span class="pst-showcase__icon" aria-hidden="true" style="font-size: {{ cold_laminator_size }}px; line-height: 1;">🗂️</span>
          {%- endif -%}
          {%- if section.settings.cold_laminator_show_title != false -%}
            <h3 class="pst-showcase__card-title">{{ 'Cold Laminator System' | escape }}</h3>
          {%- endif -%}
        </div>
        <div class="pst-showcase__body">
          <ul class="pst-showcase__list">
            <li>No Heat Required</li>
            <li>Safe for Schools</li>
            <li>Multiple Sizes</li>
            <li>No Electricity</li>
          </ul>
          <div class="pst-showcase__actions">
            {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--quote" href="{{ section.settings.quote_link }}">
                {{- section.settings.quote_label | escape -}}
              </a>
            {%- endif -%}
            {%- liquid
              assign _learn_lam = section.settings.learn_link_laminator
              if _learn_lam == blank
                assign _learn_lam = '/collections/cold-laminators-for-schools'
              endif
            -%}
            {%- if section.settings.learn_label != blank -%}
              <a class="pst-showcase__btn pst-showcase__btn--learn" href="{{ _learn_lam }}">
                {{- section.settings.learn_label | escape -}}
              </a>
            {%- endif -%}
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST Products showcase",
  "tag": "section",
  "class": "pst-products-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Professional Visual Tools for Every School"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Poster makers, awards systems, and laminators built for classrooms and districts."
    },
    {
      "type": "paragraph",
      "content": "Quote button uses the link below. Each product card has its own Learn more URL."
    },
    {
      "type": "image_picker",
      "id": "poster_maker_image",
      "label": "Poster Maker — Product Image",
      "info": "Optional hero image. If empty, the default icon is shown."
    },
    {
      "type": "range",
      "id": "poster_maker_image_size",
      "label": "Poster Maker — Image Size",
      "min": 60,
      "max": 280,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "poster_maker_show_title",
      "label": "Poster Maker — Show title on card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "awards_cut_image",
      "label": "Awards & Cut System — Product Image",
      "info": "Optional hero image. If empty, the default icon is shown."
    },
    {
      "type": "range",
      "id": "awards_cut_image_size",
      "label": "Awards & Cut — Image Size",
      "min": 60,
      "max": 280,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "awards_cut_show_title",
      "label": "Awards & Cut — Show title on card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "awards_maker_image",
      "label": "Awards Maker — Product Image",
      "info": "Optional hero image. If empty, the default icon is shown."
    },
    {
      "type": "range",
      "id": "awards_maker_image_size",
      "label": "Awards Maker — Image Size",
      "min": 60,
      "max": 280,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "awards_maker_show_title",
      "label": "Awards Maker — Show title on card",
      "default": true
    },
    {
      "type": "image_picker",
      "id": "cold_laminator_image",
      "label": "Cold Laminator — Product Image",
      "info": "Optional hero image. If empty, the default icon is shown."
    },
    {
      "type": "range",
      "id": "cold_laminator_image_size",
      "label": "Cold Laminator — Image Size",
      "min": 60,
      "max": 280,
      "step": 10,
      "default": 160,
      "unit": "px"
    },
    {
      "type": "checkbox",
      "id": "cold_laminator_show_title",
      "label": "Cold Laminator — Show title on card",
      "default": true
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Quote button label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "Quote button link"
    },
    {
      "type": "text",
      "id": "learn_label",
      "label": "Learn more button label",
