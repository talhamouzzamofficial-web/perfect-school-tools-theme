{%- style -%}
  #shopify-section-{{ section.id }} .pst-products {
    background-color: #fff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pst-products__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  #shopify-section-{{ section.id }} .pst-products__title {
    margin: 0 0 3.5rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    color: var(--pst-color-navy, #0f4872);
  }

  #shopify-section-{{ section.id }} .pst-products__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-products__inner {
      padding: 0 1rem;
    }

    #shopify-section-{{ section.id }} .pst-products__grid {
      grid-template-columns: 1fr;
    }

    #shopify-section-{{ section.id }} .pst-products__card {
      width: 100%;
      max-width: none;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .pst-products__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pst-products__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.8rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-products__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.8rem 2.2rem;
    background: #fff;
    border: 1px solid rgba(15, 72, 114, 0.1);
    border-radius: 0.6rem;
    box-shadow: 0 2px 10px rgba(10, 37, 64, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .pst-products__card:hover {
    transform: translateY(-5px);
    box-shadow: 0 12px 28px rgba(10, 37, 64, 0.12);
  }

  #shopify-section-{{ section.id }} .pst-products__badge {
    display: inline-block;
    align-self: flex-start;
    margin-bottom: 1rem;
    padding: 0.35rem 0.85rem;
    font-family: var(--font-body-family);
    font-size: 1.15rem;
    font-weight: 700;
    border-radius: 0.35rem;
    line-height: 1.3;
  }

  #shopify-section-{{ section.id }} .pst-products__badge--popular {
    background-color: var(--pst-color-magenta, #e91e8c);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-products__badge--gold {
    background-color: #f5b731;
    color: var(--pst-color-primary-dark-navy, #0a2540);
  }

  #shopify-section-{{ section.id }} .pst-products__badge-spacer {
    min-height: 2.8rem;
    margin-bottom: 1rem;
  }

  #shopify-section-{{ section.id }} .pst-products__card-title {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading-family);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pst-color-primary-dark-navy, #0a2540);
  }

  #shopify-section-{{ section.id }} .pst-products__price {
    margin: 0 0 1.2rem;
  }

  #shopify-section-{{ section.id }} .pst-price {
    font-family: var(--font-heading-family);
    font-size: 2rem;
    font-weight: 800;
    color: var(--pst-color-navy, #0f4872);
  }

  #shopify-section-{{ section.id }} .pst-products__list {
    margin: 0 0 1.8rem;
    padding-left: 1.2rem;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    line-height: 1.45;
    color: var(--pst-color-slate, #334155);
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .pst-products__list li {
    margin-bottom: 0.45rem;
  }

  #shopify-section-{{ section.id }} .pst-products__actions {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    margin-top: auto;
  }

  #shopify-section-{{ section.id }} .pst-products__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.6rem;
    padding: 0 1.4rem;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.45rem;
    text-align: center;
    transition: filter 0.2s ease, background-color 0.2s ease, color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-products__btn--quote {
    background-color: var(--pst-color-magenta, #e91e8c);
    color: #fff;
    border: 2px solid var(--pst-color-magenta, #e91e8c);
  }

  #shopify-section-{{ section.id }} .pst-products__btn--quote:hover,
  #shopify-section-{{ section.id }} .pst-products__btn--quote:focus {
    filter: brightness(1.06);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-products__btn--learn {
    background-color: transparent;
    color: var(--pst-color-navy, #0f4872);
    border: 2px solid var(--pst-color-navy, #0f4872);
  }

  #shopify-section-{{ section.id }} .pst-products__btn--learn:hover,
  #shopify-section-{{ section.id }} .pst-products__btn--learn:focus {
    background-color: rgba(15, 72, 114, 0.06);
    color: var(--pst-color-navy, #0f4872);
  }
{%- endstyle -%}

<section class="pst-products">
  <div class="pst-products__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="pst-products__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="pst-products__grid">
      <article class="pst-products__card">
        <span class="pst-products__badge pst-products__badge--popular">Most Popular</span>
        <h3 class="pst-products__card-title">Perfect Poster Maker System</h3>
        <p class="pst-products__price"><span class="pst-price">$3,795</span></p>
        <ul class="pst-products__list">
          <li>24&quot; Full Color Printer</li>
          <li>Full Set of Ink (225-275 posters)</li>
          <li>Premium Paper Roll</li>
          <li>Free Digital Content Access</li>
        </ul>
        <div class="pst-products__actions">
          {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
            <a class="pst-products__btn pst-products__btn--quote" href="{{ section.settings.quote_link }}">
              {{- section.settings.quote_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.learn_label != blank and section.settings.learn_link != blank -%}
            <a class="pst-products__btn pst-products__btn--learn" href="{{ section.settings.learn_link }}">
              {{- section.settings.learn_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </article>

      <article class="pst-products__card">
        <span class="pst-products__badge pst-products__badge--gold">Best Value</span>
        <h3 class="pst-products__card-title">Perfect Awards &amp; Cut System</h3>
        <p class="pst-products__price"><span class="pst-price">$3,995</span></p>
        <ul class="pst-products__list">
          <li>Awards Printer</li>
          <li>Cutting System</li>
          <li>Award Templates</li>
          <li>Certificate Paper</li>
        </ul>
        <div class="pst-products__actions">
          {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
            <a class="pst-products__btn pst-products__btn--quote" href="{{ section.settings.quote_link }}">
              {{- section.settings.quote_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.learn_label != blank and section.settings.learn_link != blank -%}
            <a class="pst-products__btn pst-products__btn--learn" href="{{ section.settings.learn_link }}">
              {{- section.settings.learn_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </article>

      <article class="pst-products__card">
        <div class="pst-products__badge-spacer" aria-hidden="true"></div>
        <h3 class="pst-products__card-title">Perfect Awards Maker</h3>
        <p class="pst-products__price"><span class="pst-price">$2,995</span></p>
        <ul class="pst-products__list">
          <li>Awards Printer</li>
          <li>Template Library</li>
          <li>Plaque Supplies</li>
          <li>Full Ink Set</li>
        </ul>
        <div class="pst-products__actions">
          {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
            <a class="pst-products__btn pst-products__btn--quote" href="{{ section.settings.quote_link }}">
              {{- section.settings.quote_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.learn_label != blank and section.settings.learn_link != blank -%}
            <a class="pst-products__btn pst-products__btn--learn" href="{{ section.settings.learn_link }}">
              {{- section.settings.learn_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </article>

      <article class="pst-products__card">
        <div class="pst-products__badge-spacer" aria-hidden="true"></div>
        <h3 class="pst-products__card-title">Cold Laminator System</h3>
        <p class="pst-products__price"><span class="pst-price">From $99</span></p>
        <ul class="pst-products__list">
          <li>No Heat Required</li>
          <li>Safe for Schools</li>
          <li>Multiple Sizes</li>
          <li>Peel &amp; Stick Options</li>
        </ul>
        <div class="pst-products__actions">
          {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
            <a class="pst-products__btn pst-products__btn--quote" href="{{ section.settings.quote_link }}">
              {{- section.settings.quote_label | escape -}}
            </a>
          {%- endif -%}
          {%- if section.settings.learn_label != blank and section.settings.learn_link != blank -%}
            <a class="pst-products__btn pst-products__btn--learn" href="{{ section.settings.learn_link }}">
              {{- section.settings.learn_label | escape -}}
            </a>
          {%- endif -%}
        </div>
      </article>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST Products showcase",
  "tag": "section",
  "class": "pst-products-showcase-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Professional Visual Tools for Every School"
    },
    {
      "type": "header",
      "content": "Buttons"
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Quote button label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "Quote button link"
    },
    {
      "type": "text",
      "id": "learn_label",
      "label": "Learn more button label",
      "default": "Learn More"
    },
    {
      "type": "url",
      "id": "learn_link",
      "label": "Learn more link"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "presets": [
    {
      "name": "PST Products showcase"
    }
  ]
}
{% endschema %}
