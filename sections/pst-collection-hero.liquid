      "default": "Protect your printed posters with cold lamination"
    },
    {
      "type": "url",
      "id": "related2_url",
      "label": "Card 2 link",
      "info": "Defaults to /collections/laminators-lamination"
    },
    {
      "type": "text",
      "id": "related3_title",
      "label": "Card 3 title",
      "default": "School Bundles"
    },
    {
      "type": "textarea",
      "id": "related3_text",
      "label": "Card 3 text",
      "default": "Save with complete poster maker bundle packages"
    },
    {
      "type": "url",
      "id": "related3_url",
      "label": "Card 3 link",
      "info": "Defaults to /collections/perfect-supply-bundles"
    },
    {
      "type": "header",
      "content": "Bottom banner"
    },
    {
      "type": "text",
      "id": "bottom_title",
      "label": "Title",
      "default": "Ready to Get Your School Printing?"
    },
    {
      "type": "textarea",
      "id": "bottom_sub",
      "label": "Subtitle",
      "default": "Join thousands of schools who trust Perfect School Tools."
    },
    {
      "type": "text",
      "id": "bottom_quote_label",
      "label": "Quote button",
      "default": "Request a Free Quote"
    },
    {
      "type": "text",
      "id": "bottom_phone_label",
      "label": "Phone button label",
      "default": "Call (888) 535-4431"
    },
    {
      "type": "text",
      "id": "bottom_phone_tel",
      "label": "Phone tel href",
      "default": "+18885354431",
      "info": "Include country code for tel: link"
