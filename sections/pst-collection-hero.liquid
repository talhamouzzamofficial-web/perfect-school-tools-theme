    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Quote button",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "quote_url",
      "label": "Quote link",
      "info": "Defaults to Contact page"
    },
    {
      "type": "header",
      "content": "Trust bar"
    },
    {
      "type": "text",
      "id": "trust_aria",
      "label": "Trust region label",
      "default": "Why schools choose us"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust 1",
      "default": "Purchase Orders Accepted"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust 2",
      "default": "Free Shipping"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust 3",
      "default": "Unlimited Support"
    },
    {
      "type": "text",
      "id": "trust_4",
      "label": "Trust 4",
      "default": "30+ Years Serving Schools"
    },
    {
      "type": "header",
      "content": "Intro"
    },
    {
      "type": "text",
      "id": "intro_heading",
      "label": "Intro heading",
      "default": "Professional Poster Makers for K-12 Schools"
    },
    {
      "type": "textarea",
      "id": "intro_text",
      "label": "Intro body",
      "default": "Perfect School Tools has been supplying K-12 schools with professional poster maker systems for over 30 years. Our systems allow schools to print full-color 24-inch posters in-house for just $1.50 to $3.00 each — saving thousands compared to outside printing services. Whether you need a system for your media center, main office, or district-wide deployment, we have the right solution for your school."
    },
    {
      "type": "text",
      "id": "feature_1",
      "label": "Feature 1",
      "default": "Print full-color 24\" posters for $1.50–$3.00 each"
    },
    {
      "type": "text",
      "id": "feature_2",
      "label": "Feature 2",
      "default": "Includes ink, paper, and free templates"
    },
    {
      "type": "text",
      "id": "feature_3",
      "label": "Feature 3",
      "default": "Purchase orders accepted — no credit card needed"
    },
    {
      "type": "text",
      "id": "feature_4",
      "label": "Feature 4",
      "default": "Free shipping to all K-12 schools"
    },
    {
      "type": "text",
      "id": "feature_5",
      "label": "Feature 5",
      "default": "30+ years serving schools nationwide"
    },
    {
      "type": "header",
      "content": "Product grid"
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "Section label",
      "default": "Our Products"
    },
    {
      "type": "text",
      "id": "grid_heading_prefix",
      "label": "Heading prefix",
      "default": "Browse"
    },
    {
      "type": "text",
      "id": "products_count_suffix",
      "label": "Product count suffix",
      "default": "products"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "min": 8,
      "max": 24,
      "step": 4,
      "label": "Products per page",
      "default": 12
    },
    {
      "type": "text",
      "id": "view_product_label",
      "label": "View product button",
      "default": "View Product"
    },
    {
      "type": "header",
      "content": "FAQ"
    },
    {
      "type": "text",
      "id": "faq_label",
      "label": "Section label",
      "default": "Common Questions"
    },
    {
      "type": "text",
      "id": "faq_heading",
      "label": "Heading",
      "default": "Frequently Asked Questions"
    },
    {
      "type": "text",
      "id": "faq1_q",
      "label": "FAQ 1 question",
      "default": "What is included with a poster maker system?"
    },
    {
      "type": "textarea",
      "id": "faq1_a",
      "label": "FAQ 1 answer",
      "default": "Each Perfect School Tools poster maker system includes the printer unit, starter ink cartridges, a roll of poster paper, free access to thousands of downloadable templates, and unlimited phone and email support."
    },
    {
      "type": "text",
      "id": "faq2_q",
      "label": "FAQ 2 question",
      "default": "How much does it cost to print a poster?"
    },
    {
      "type": "textarea",
      "id": "faq2_a",
      "label": "FAQ 2 answer",
      "default": "With our systems, you can print full-color 24-inch posters for approximately $1.50 to $3.00 each, depending on the system and supplies used. This is significantly less than outside printing services."
    },
    {
      "type": "text",
      "id": "faq3_q",
      "label": "FAQ 3 question",
      "default": "Do you accept purchase orders?"
    },
    {
      "type": "textarea",
      "id": "faq3_a",
      "label": "FAQ 3 answer",
      "default": "Yes! We accept purchase orders from all K-12 public schools, private schools, charter schools, and school districts. Simply email your PO to orders@perfectposter.com or call us at (888) 535-4431."
    },
    {
      "type": "text",
      "id": "faq4_q",
      "label": "FAQ 4 question",
      "default": "What support is included?"
    },
    {
      "type": "textarea",
      "id": "faq4_a",
      "label": "FAQ 4 answer",
      "default": "All systems include unlimited phone and email support. We also offer on-site installation and training services. Our team is available Monday–Friday to help with any questions."
    },
    {
      "type": "header",
      "content": "Related collections"
    },
    {
      "type": "text",
      "id": "related_label",
      "label": "Section label",
      "default": "You May Also Need"
    },
    {
      "type": "text",
      "id": "related_heading",
      "label": "Heading",
      "default": "Related Products & Supplies"
    },
    {
      "type": "text",
      "id": "related_cta",
      "label": "Card link text",
      "default": "Shop now"
    },
    {
      "type": "text",
      "id": "related1_title",
      "label": "Card 1 title",
      "default": "Poster Printer Supplies"
    },
