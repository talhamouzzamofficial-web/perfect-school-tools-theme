<div class="pst-gallery">
  <div class="pst-gallery__inner">

    {%- if section.settings.badge != blank -%}
      <p class="pst-gallery__badge">
        {{ section.settings.badge }}
      </p>
    {%- endif -%}

    <h2 class="pst-gallery__heading">
      {{ section.settings.heading }}
    </h2>

    {%- if section.settings.subheading != blank -%}
      <p class="pst-gallery__subheading">
        {{ section.settings.subheading }}
      </p>
    {%- endif -%}

    <div class="pst-gallery__grid">
      {%- for i in (1..6) -%}
        {%- assign img_key     = 'image_' | append: i -%}
        {%- assign title_key   = 'title_' | append: i -%}
        {%- assign caption_key = 'caption_' | append: i -%}
        {%- if section.settings[img_key] != blank -%}
          <div class="pst-gallery__item">
            <div class="pst-gallery__img-wrap">
              {{ section.settings[img_key]
                 | image_url: width: 600
                 | image_tag:
                     alt: section.settings[title_key],
                     class: 'pst-gallery__img',
                     loading: 'lazy' }}
            </div>
            {%- if section.settings[title_key] != blank -%}
              <div class="pst-gallery__caption">
                <p class="pst-gallery__caption-title">
                  {{ section.settings[title_key] }}
                </p>
                {%- if section.settings[caption_key] != blank -%}
                  <p class="pst-gallery__caption-text">
                    {{ section.settings[caption_key] }}
                  </p>
                {%- endif -%}
              </div>
            {%- endif -%}
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>

    {%- if section.settings.cta_label != blank -%}
      <div class="pst-gallery__cta-wrap">
        <a href="{{ section.settings.cta_link }}"
           class="pst-gallery__cta">
          {{ section.settings.cta_label }}
        </a>
      </div>
    {%- endif -%}

  </div>
</div>

{%- style -%}

#shopify-section-{{ section.id }} .pst-gallery {
  background: {{ section.settings.bg_color }};
  padding: {{ section.settings.padding_top }}px 20px
           {{ section.settings.padding_bottom }}px;
}

#shopify-section-{{ section.id }} .pst-gallery__inner {
  max-width: 1200px;
  margin: 0 auto;
  text-align: center;
}

#shopify-section-{{ section.id }} .pst-gallery__badge {
  display: inline-block;
  background: rgba(233,30,140,0.1);
  color: #E91E8C;
  font-family: 'Outfit', sans-serif;
  font-size: 12px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 6px 16px;
  border-radius: 20px;
  margin: 0 0 16px;
}

#shopify-section-{{ section.id }} .pst-gallery__heading {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(24px, 3vw, 38px);
  font-weight: 800;
  color: #0A2540;
  margin: 0 0 12px;
  line-height: 1.2;
}

#shopify-section-{{ section.id }} .pst-gallery__subheading {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 16px;
  color: #334155;
  max-width: 600px;
  margin: 0 auto 40px;
  line-height: 1.6;
}

/* Grid — desktop: 3 columns */
#shopify-section-{{ section.id }} .pst-gallery__grid {
  display: grid;
  grid-template-columns: repeat(
    {{ section.settings.columns_desktop }}, 1fr);
  gap: {{ section.settings.gap }}px;
  margin-bottom: {{ section.settings.gap }}px;
}

/* Tablet: 2 columns */
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .pst-gallery__grid {
    grid-template-columns: repeat(2, 1fr);
  }
}

/* Mobile: 1 or 2 columns based on setting */
@media (max-width: 540px) {
  #shopify-section-{{ section.id }} .pst-gallery__grid {
    grid-template-columns: repeat(
      {{ section.settings.columns_mobile }}, 1fr);
    gap: {{ section.settings.gap | divided_by: 2 }}px;
  }
}

/* Gallery item */
#shopify-section-{{ section.id }} .pst-gallery__item {
  border-radius: {{ section.settings.card_radius }}px;
  overflow: hidden;
  background: #ffffff;
  box-shadow: 0 2px 16px rgba(10,37,64,0.07);
  transition: transform 0.2s ease, box-shadow 0.2s ease;
}

#shopify-section-{{ section.id }} .pst-gallery__item:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(10,37,64,0.13);
}

/* Image wrapper — fixed aspect ratio */
#shopify-section-{{ section.id }} .pst-gallery__img-wrap {
  width: 100%;
  aspect-ratio: {{ section.settings.img_ratio }};
  overflow: hidden;
}

#shopify-section-{{ section.id }} .pst-gallery__img {
  width: 100%;
  height: 100%;
  object-fit: cover;
  object-position: center;
  display: block;
  transition: transform 0.3s ease;
}

#shopify-section-{{ section.id }}
  .pst-gallery__item:hover .pst-gallery__img {
  transform: scale(1.04);
}

/* Caption */
#shopify-section-{{ section.id }} .pst-gallery__caption {
  padding: 14px 16px 16px;
  text-align: left;
}

#shopify-section-{{ section.id }} .pst-gallery__caption-title {
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #0A2540;
  margin: 0 0 4px;
}

#shopify-section-{{ section.id }} .pst-gallery__caption-text {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 13px;
  color: #334155;
  margin: 0;
  line-height: 1.5;
}

/* CTA button */
#shopify-section-{{ section.id }} .pst-gallery__cta-wrap {
  margin-top: 36px;
}

#shopify-section-{{ section.id }} .pst-gallery__cta {
  display: inline-block;
  padding: 14px 32px;
  background: #0A2540;
  color: #ffffff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s ease;
}

#shopify-section-{{ section.id }} .pst-gallery__cta:hover {
  background: #E91E8C;
}

{%- endstyle -%}

{% schema %}
{
  "name": "PST Image Gallery",
  "tag": "section",
  "class": "pst-section",
  "settings": [

    {
      "type": "header",
      "content": "Section Text"
    },
    {
      "type": "text",
      "id": "badge",
      "label": "Badge Text",
      "default": "See What You Can Create"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Real Results in Real Schools"
