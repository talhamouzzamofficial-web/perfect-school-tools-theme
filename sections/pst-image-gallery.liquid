      "default": "From hallway displays to student awards, see how schools across the country use our systems every day."
    },

    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "padding_top",
      "label": "Padding Top",
      "min": 20, "max": 100, "step": 4, "default": 80,
      "unit": "px"
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "label": "Padding Bottom",
      "min": 20, "max": 100, "step": 4, "default": 80,
