{%- style -%}
  #shopify-section-{{ section.id }} .pst-cta {
    background-color: var(--pst-color-magenta, #e91e8c);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-cta__inner {
    max-width: 72rem;
    margin: 0 auto;
    padding: 0 2rem;
  }

  #shopify-section-{{ section.id }} .pst-cta__title {
    margin: 0 0 1.2rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.2;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-cta__text {
    margin: 0 0 2.2rem;
    font-family: var(--font-body-family);
    font-size: 1.75rem;
    line-height: 1.5;
    font-weight: 400;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-cta__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 5.2rem;
    margin-bottom: 1.8rem;
    padding: 0 2.8rem;
    font-family: var(--font-body-family);
    font-size: 1.55rem;
    font-weight: 700;
    text-decoration: none;
    color: var(--pst-color-magenta, #e91e8c) !important;
    background-color: #fff;
    border: 2px solid #fff;
    border-radius: 0.5rem;
    transition: filter 0.2s ease, transform 0.15s ease;
  }

  #shopify-section-{{ section.id }} .pst-cta__btn:hover,
  #shopify-section-{{ section.id }} .pst-cta__btn:focus {
    filter: brightness(0.98);
    color: var(--pst-color-magenta, #e91e8c) !important;
  }

  #shopify-section-{{ section.id }} .pst-cta__phone {
    display: block;
    font-family: var(--font-body-family);
    font-size: 1.65rem;
    font-weight: 700;
    color: #fff;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pst-cta__phone:hover,
  #shopify-section-{{ section.id }} .pst-cta__phone:focus {
    text-decoration: underline;
  }
{%- endstyle -%}

<section class="pst-cta">
  <div class="pst-cta__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="pst-cta__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}
    {%- if section.settings.subtext != blank -%}
      <p class="pst-cta__text">{{ section.settings.subtext | escape }}</p>
    {%- endif -%}
    {%- if section.settings.button_label != blank and section.settings.button_link != blank -%}
      <a class="pst-cta__btn" href="{{ section.settings.button_link }}">{{ section.settings.button_label | escape }}</a>
    {%- endif -%}
    {%- if section.settings.phone != blank -%}
      <a
        class="pst-cta__phone"
        href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}"
      >
        {{- section.settings.phone | escape -}}
      </a>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PST CTA banner",
  "tag": "section",
  "class": "pst-cta-banner-section",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Ready to Transform Your School's Visual Communication?"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Subtext",
      "default": "Get a personalized quote for your school or district. We accept purchase orders."
    },
    {
      "type": "text",
      "id": "button_label",
      "label": "Button label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "button_link",
      "label": "Button link"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(888) 535-4431"
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 64
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 32,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "PST CTA banner"
    }
  ]
}
{% endschema %}
