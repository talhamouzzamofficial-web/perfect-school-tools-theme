<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

<style>
  #shopify-section-{{ section.id }} .pst-header-wrapper {
    --pst-header-bg: {{ section.settings.header_background }};
    --pst-header-nav: {{ section.settings.nav_text_color }};
    --pst-header-cta-bg: {{ section.settings.cta_button_color }};
    --pst-header-cta-fg: {{ section.settings.cta_text_color }};
    background: var(--pst-header-bg);
    border-bottom: 1px solid rgba(10, 37, 64, 0.12);
  }

  #shopify-section-{{ section.id }} .pst-header-wrapper.color-{{ section.settings.color_scheme }}.gradient {
    background: var(--pst-header-bg);
  }

  .pst-header {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .pst-header__grid {
    display: grid;
    grid-template-areas: 'drawer logo actions';
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem 0.6rem;
    min-height: 6.8rem;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  @media screen and (max-width: 768px) {
    .pst-header {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .pst-header__grid {
      gap: 0.5rem 0.4rem;
    }
  }

  @media screen and (min-width: 990px) {
    .pst-header__grid {
      grid-template-areas: 'logo nav actions';
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.8rem 1.2rem;
    }
  }

  .pst-header__drawer {
    grid-area: drawer;
    justify-self: start;
    margin-left: -1rem;
  }

  @media screen and (min-width: 990px) {
    .pst-header__drawer {
      display: none;
    }
  }

  .pst-header__logo {
    grid-area: logo;
    justify-self: center;
    text-align: center;
    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    .pst-header__logo {
      justify-self: start;
      text-align: left;
    }
  }

  .pst-header__logo .header__heading {
    line-height: 1.15;
  }

  .pst-header__logo .header__heading-link {
    text-decoration: none;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
  }

  @media screen and (min-width: 990px) {
    .pst-header__logo .header__heading-link {
      align-items: flex-start;
    }
  }

  .pst-header__logo .header__heading-logo-wrapper {
    max-width: 18rem;
  }

  /* Text shop name only when no logo image */
  .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
    font-family: var(--font-heading-family);
    font-weight: 700;
    color: var(--pst-color-primary-dark-navy, #0a2540);
    line-height: 1.2;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .pst-header__logo .header__heading-link {
      align-items: center;
      justify-content: center;
    }

    .pst-header__logo .header__heading-logo-wrapper {
      margin-left: auto;
      margin-right: auto;
      display: flex;
      justify-content: center;
      max-width: 100%;
    }

    .pst-header__logo .header__heading-logo {
      max-height: 60px;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    .pst-header__brand-text--text-only {
      display: block;
      font-size: 16px;
      max-width: 14rem;
    }

    .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
      font-size: 16px;
      line-height: 1.2;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 989px) {
    .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
      font-size: 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
      font-size: inherit;
      text-align: left;
    }
  }

  .pst-header__nav {
    display: none;
    grid-area: nav;
    justify-content: center;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .pst-header__nav {
      display: flex;
    }
  }

  .pst-header__nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pst-header__nav-item {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pst-header__nav-item--dropdown {
    position: relative;
  }

  .pst-header__nav-details {
    position: relative;
  }

  .pst-header__nav-summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    padding: 0.4rem 0;
    white-space: nowrap;
  }

  .pst-header__nav-summary::-webkit-details-marker {
    display: none;
  }

  .pst-header__nav-summary:hover,
  .pst-header__nav-summary:focus {
    color: var(--pst-color-navy-light, #1a6ba0);
    outline: none;
  }

  .pst-header__nav-details[open] .pst-header__nav-summary {
    color: var(--pst-color-navy-light, #1a6ba0);
  }

  .pst-header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 28rem;
    margin: 0.4rem 0 0;
    padding: 0.6rem 0;
    list-style: none;
    background: #fff;
    border: 1px solid rgba(15, 72, 114, 0.12);
    border-radius: 0.5rem;
    box-shadow: 0 12px 32px rgba(10, 37, 64, 0.12);
    z-index: 20;
  }

  .pst-header__dropdown-link {
    display: block;
    padding: 0.55rem 1.4rem;
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    text-decoration: none;
    white-space: nowrap;
  }

  .pst-header__dropdown-link:hover,
  .pst-header__dropdown-link:focus {
    color: var(--pst-color-navy-light, #1a6ba0);
    background: rgba(15, 72, 114, 0.06);
  }

  .pst-header__nav-link {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    text-decoration: none;
    padding: 0.4rem 0;
    white-space: nowrap;
  }

  .pst-header__nav-link:hover,
  .pst-header__nav-link:focus {
    color: var(--pst-color-navy-light, #1a6ba0);
  }

  .pst-header__actions {
    grid-area: actions;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.8rem 1.2rem;
  }

  .pst-header__quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    background-color: var(--pst-header-cta-bg, var(--pst-color-magenta, #e91e8c));
    color: var(--pst-header-cta-fg, #fff) !important;
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.4rem;
    border: none;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.15s ease, background-color 0.2s ease;
    white-space: nowrap;
  }

  .pst-header__phone {
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    text-decoration: none;
    white-space: nowrap;
  }

  .pst-header__phone:hover,
  .pst-header__phone:focus {
    color: var(--pst-color-navy-light, #1a6ba0);
    text-decoration: underline;
  }

  .pst-header__quote-icon {
    display: none;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
  }

  .pst-header__quote-icon svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: currentColor;
  }

  @media screen and (max-width: 768px) {
    .pst-header__quote {
      padding: 0.75rem;
      min-width: 4.4rem;
      min-height: 4.4rem;
    }

    .pst-header__quote-icon {
      display: flex;
    }

    .pst-header__quote-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  }

  @media screen and (min-width: 769px) {
    .pst-header__quote-icon {
      display: none;
    }

    .pst-header__quote-label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: nowrap;
    }
  }

  @media screen and (min-width: 990px) {
    .pst-header__quote {
      padding: 1rem 2rem;
      font-size: 1.4rem;
    }
  }

  .pst-header__quote:hover,
  .pst-header__quote:focus {
    filter: brightness(1.05);
    color: #fff !important;
  }

  .pst-header__icons {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  .pst-header__icons .header__icon {
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
  }

  header-drawer {
    justify-self: start;
  }
</style>

{%- style -%}
  .section-header {
    position: sticky;
    margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
    z-index: 4;
  }

  @media screen and (min-width: 750px) {
    .section-header {
      margin-bottom: {{ section.settings.margin_bottom }}px;
    }
  }

  .pst-header {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .pst-header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper pst-header-wrapper color-{{ section.settings.color_scheme }} gradient"
>
  <header
    class="pst-header{% if shop.customer_accounts_enabled %} pst-header--has-account{% endif %}{% if has_app_block %} pst-header--has-app{% endif %}"
    role="banner"
  >
    <div class="pst-header__grid">
      <div class="pst-header__drawer">
        {% render 'pst-header-drawer' %}
      </div>

      <div class="pst-header__logo">
        {%- if request.page_type == 'index' -%}
          <h1 class="header__heading" style="margin:0;">
        {%- endif -%}
        <a href="{{ routes.root_url }}" class="header__heading-link link link--text focus-inset">
          {%- if settings.logo != blank -%}
            <div class="header__heading-logo-wrapper">
              {%- assign logo_alt = settings.logo.alt | default: shop.name | escape -%}
              {%- assign logo_height = settings.logo_width | divided_by: settings.logo.aspect_ratio -%}
              {% capture sizes %}(min-width: 990px) {{ settings.logo_width }}px, 45vw{% endcapture %}
              {% capture widths %}{{ settings.logo_width }}, {{ settings.logo_width | times: 1.5 | round }}, {{ settings.logo_width | times: 2 }}{% endcapture %}
              {{
                settings.logo
                | image_url: width: 600
                | image_tag:
                  class: 'header__heading-logo motion-reduce',
                  widths: widths,
                  height: logo_height,
                  width: settings.logo_width,
                  alt: logo_alt,
                  sizes: sizes,
                  preload: true
              }}
            </div>
          {%- else -%}
            <span class="h2 pst-header__brand-text pst-header__brand-text--text-only" style="color: var(--pst-color-primary-dark-navy);">{{ shop.name }}</span>
          {%- endif -%}
        </a>
        {%- if request.page_type == 'index' -%}
          </h1>
        {%- endif -%}
      </div>

      <nav class="pst-header__nav" aria-label="{{ 'sections.header.menu' | t }}">
        <ul class="pst-header__nav-list" role="list">
          <li class="pst-header__nav-item">
            <a href="https://perfectposter.com/pages/postermaker" class="pst-header__nav-link">Poster Makers</a>
          </li>
          <li class="pst-header__nav-item">
            <a href="https://perfectposter.com/pages/perfect-awards-systems" class="pst-header__nav-link">Awards Systems</a>
          </li>
          <li class="pst-header__nav-item">
            <a href="https://perfectposter.com/collections/lamination" class="pst-header__nav-link">Laminators</a>
          </li>
          <li class="pst-header__nav-item pst-header__nav-item--dropdown">
            <details class="pst-header__nav-details">
              <summary class="pst-header__nav-summary">Shop</summary>
              <ul class="pst-header__dropdown" role="list">
                <li class="pst-header__nav-item">
                  <a href="https://perfectposter.com/collections/paper-media" class="pst-header__dropdown-link">Poster Paper &amp; Materials</a>
                </li>
                <li class="pst-header__nav-item">
                  <a href="https://perfectposter.com/collections/ink" class="pst-header__dropdown-link">Poster Maker Ink</a>
                </li>
                <li class="pst-header__nav-item">
                  <a href="https://perfectposter.com/collections/lamination" class="pst-header__dropdown-link">Lamination Supplies</a>
                </li>
                <li class="pst-header__nav-item">
                  <a href="https://perfectposter.com/collections/maintenance" class="pst-header__dropdown-link">Maintenance Supplies</a>
                </li>
                <li class="pst-header__nav-item">
                  <a href="https://perfectposter.com/collections/awards-maker-labels" class="pst-header__dropdown-link">Award System Supplies</a>
                </li>
                <li class="pst-header__nav-item">
                  <a href="https://perfectposter.com/collections/perfect-bundles" class="pst-header__dropdown-link">Bundled Supply Packages</a>
                </li>
                <li class="pst-header__nav-item">
                  <a href="https://perfectposter.com/collections/current-specials" class="pst-header__dropdown-link">Current Specials</a>
                </li>
              </ul>
            </details>
          </li>
          <li class="pst-header__nav-item">
            <a href="https://perfectposter.com/collections/free-poster-template-downloads" class="pst-header__nav-link">Free Resources</a>
          </li>
          <li class="pst-header__nav-item">
            <a href="{{ routes.root_url }}pages/about" class="pst-header__nav-link">About Us</a>
          </li>
          <li class="pst-header__nav-item">
            <a href="{{ routes.root_url }}pages/contact" class="pst-header__nav-link">Contact</a>
          </li>
        </ul>
      </nav>

      <div class="pst-header__actions header__icons{% if section.settings.enable_country_selector or section.settings.enable_language_selector %} header__icons--localization header-localization{% endif %}">
        {%- liquid
          assign pst_cta_url = section.settings.cta_button_link
          if pst_cta_url == blank
            assign pst_cta_url = section.settings.quote_url
          endif
        -%}
        {%- if section.settings.show_phone_header and section.settings.header_phone != blank -%}
          <a
            class="pst-header__phone"
            href="tel:{{ section.settings.header_phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}"
          >
            {{- section.settings.header_phone | escape -}}
          </a>
        {%- endif -%}
        {%- if pst_cta_url != blank and section.settings.cta_button_text != blank -%}
          <a class="pst-header__quote" href="{{ pst_cta_url }}">
            <span class="pst-header__quote-icon" aria-hidden="true">
              <span class="svg-wrapper">{{ 'icon-clipboard.svg' | inline_asset_content }}</span>
            </span>
            <span class="pst-header__quote-label">{{ section.settings.cta_button_text | escape }}</span>
          </a>
        {%- endif -%}

        <div class="desktop-localization-wrapper pst-header__localization small-hide medium-hide">
          {%- if section.settings.enable_country_selector and localization.available_countries.size > 1 -%}
            <localization-form data-prevent-hide>
              {%- form 'localization', id: 'HeaderCountryForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderCountryLabel">{{ 'localization.country_label' | t }}</h2>
                  {%- render 'country-localization', localPosition: 'HeaderCountry' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {% endif %}

          {%- if section.settings.enable_language_selector and localization.available_languages.size > 1 -%}
            <localization-form data-prevent-hide>
              {%- form 'localization', id: 'HeaderLanguageForm', class: 'localization-form' -%}
                <div>
                  <h2 class="visually-hidden" id="HeaderLanguageLabel">{{ 'localization.language_label' | t }}</h2>
                  {%- render 'language-localization', localPosition: 'HeaderLanguage' -%}
                </div>
              {%- endform -%}
            </localization-form>
          {%- endif -%}
        </div>

        <div class="pst-header__icons">
          {%- if shop.customer_accounts_enabled -%}
            <a
              href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
              class="header__icon header__icon--account link focus-inset"
              rel="nofollow"
            >
              {%- if section.settings.enable_customer_avatar -%}
                <account-icon>
                  {%- if customer and customer.has_avatar? -%}
                    {{ customer | avatar }}
                  {%- else -%}
                    <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
                  {%- endif -%}
                </account-icon>
              {%- else -%}
                <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
              {%- endif -%}
              <span class="visually-hidden">
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </span>
            </a>
          {%- endif -%}

          {%- for block in section.blocks -%}
            {%- case block.type -%}
              {%- when '@app' -%}
                {% render block %}
            {%- endcase -%}
          {%- endfor -%}

          <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
            {% if cart == empty %}
              <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
            {% else %}
              <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
            {% endif %}
            <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
            {%- if cart != empty -%}
              <div class="cart-count-bubble">
                {%- if cart.item_count < 100 -%}
                  <span aria-hidden="true">{{ cart.item_count }}</span>
                {%- endif -%}
                <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
              </div>
            {%- endif -%}
          </a>
        </div>
      </div>
    </div>
  </header>
</{{ header_tag }}>

{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification', color_scheme: section.settings.color_scheme, desktop_menu_type: 'dropdown' -%}
{%- endif -%}

{% javascript %}
  class StickyHeader extends HTMLElement {
    constructor() {
      super();
    }

    connectedCallback() {
      this.header = document.querySelector('.section-header');
      this.headerIsAlwaysSticky =
        this.getAttribute('data-sticky-type') === 'always' ||
        this.getAttribute('data-sticky-type') === 'reduce-logo-size';
      this.headerBounds = {};

      this.setHeaderHeight();

      window.matchMedia('(max-width: 990px)').addEventListener('change', this.setHeaderHeight.bind(this));

      if (this.headerIsAlwaysSticky) {
        this.header.classList.add('shopify-section-header-sticky');
      }

      this.currentScrollTop = 0;
      this.preventReveal = false;
      this.predictiveSearch = this.querySelector('predictive-search');

      this.onScrollHandler = this.onScroll.bind(this);
      this.hideHeaderOnScrollUp = () => (this.preventReveal = true);

      this.addEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.addEventListener('scroll', this.onScrollHandler, false);

      this.createObserver();
    }

    setHeaderHeight() {
      document.documentElement.style.setProperty('--header-height', `${this.header.offsetHeight}px`);
    }

    disconnectedCallback() {
      this.removeEventListener('preventHeaderReveal', this.hideHeaderOnScrollUp);
      window.removeEventListener('scroll', this.onScrollHandler);
    }

    createObserver() {
      let observer = new IntersectionObserver((entries, observer) => {
        this.headerBounds = entries[0].intersectionRect;
        observer.disconnect();
      });

      observer.observe(this.header);
    }

    onScroll() {
      const scrollTop = window.pageYOffset || document.documentElement.scrollTop;

      if (this.predictiveSearch && this.predictiveSearch.isOpen) return;

      if (scrollTop > this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (this.preventHide) return;
        requestAnimationFrame(this.hide.bind(this));
      } else if (scrollTop < this.currentScrollTop && scrollTop > this.headerBounds.bottom) {
        this.header.classList.add('scrolled-past-header');
        if (!this.preventReveal) {
          requestAnimationFrame(this.reveal.bind(this));
        } else {
          window.clearTimeout(this.isScrolling);

          this.isScrolling = setTimeout(() => {
            this.preventReveal = false;
          }, 66);

          requestAnimationFrame(this.hide.bind(this));
        }
      } else if (scrollTop <= this.headerBounds.top) {
        this.header.classList.remove('scrolled-past-header');
        requestAnimationFrame(this.reset.bind(this));
      }

      this.currentScrollTop = scrollTop;
    }

    hide() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-hidden', 'shopify-section-header-sticky');
      this.closeMenuDisclosure();
      this.closeSearchModal();
    }

    reveal() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.add('shopify-section-header-sticky', 'animate');
      this.header.classList.remove('shopify-section-header-hidden');
    }

    reset() {
      if (this.headerIsAlwaysSticky) return;
      this.header.classList.remove('shopify-section-header-hidden', 'shopify-section-header-sticky', 'animate');
    }

    closeMenuDisclosure() {
      this.disclosures = this.disclosures || this.header.querySelectorAll('header-menu');
      this.disclosures.forEach((disclosure) => disclosure.close());
    }

    closeSearchModal() {
      this.searchModal = this.searchModal || this.header.querySelector('details-modal');
      if (this.searchModal) this.searchModal.close(false);
    }
  }

  customElements.define('sticky-header', StickyHeader);
{% endjavascript %}

<script type="application/ld+json">
  {
    "@context": "http://schema.org",
    "@type": "Organization",
    "name": {{ shop.name | json }},
    {% if settings.logo %}
      "logo": {{ settings.logo | image_url: width: 500 | prepend: "https:" | json }},
    {% endif %}
    "sameAs": [
      {{ settings.social_twitter_link | json }},
      {{ settings.social_facebook_link | json }},
      {{ settings.social_pinterest_link | json }},
      {{ settings.social_instagram_link | json }},
      {{ settings.social_tiktok_link | json }},
      {{ settings.social_tumblr_link | json }},
      {{ settings.social_snapchat_link | json }},
      {{ settings.social_youtube_link | json }},
      {{ settings.social_vimeo_link | json }}
    ],
    "url": {{ request.origin | append: page.url | json }}
  }
</script>

{%- if request.page_type == 'index' -%}
  {% assign potential_action_target = request.origin | append: routes.search_url | append: '?q={search_term_string}' %}
  <script type="application/ld+json">
    {
      "@context": "http://schema.org",
      "@type": "WebSite",
      "name": {{ shop.name | json }},
      "potentialAction": {
        "@type": "SearchAction",
        "target": {{ potential_action_target | json }},
        "query-input": "required name=search_term_string"
      },
      "url": {{ request.origin | append: page.url | json }}
    }
  </script>
{%- endif -%}

