<link rel="stylesheet" href="{{ 'component-list-menu.css' | asset_url }}" media="print" onload="this.media='all'">
<link rel="stylesheet" href="{{ 'component-menu-drawer.css' | asset_url }}" media="print" onload="this.media='all'">
<link
  rel="stylesheet"
  href="{{ 'component-cart-notification.css' | asset_url }}"
  media="print"
  onload="this.media='all'"
>

{%- liquid
  assign pst_style_logo_w = section.settings.logo_width | default: settings.logo_width | default: 150
  assign pst_style_logo_h = 48
  if settings.logo != blank
    assign pst_style_logo_h = pst_style_logo_w | times: 1.0 | divided_by: settings.logo.aspect_ratio | round
  endif
-%}
<style>
  #shopify-section-{{ section.id }} .pst-header-wrapper {
    --pst-header-bg: {{ section.settings.header_background }};
    --pst-header-nav: {{ section.settings.nav_text_color }};
    --pst-header-nav-hover: {{ section.settings.nav_hover_color }};
    --pst-header-cta-bg: {{ section.settings.cta_button_color }};
    --pst-header-cta-fg: {{ section.settings.cta_text_color }};
    --pst-header-hamburger: {{ section.settings.hamburger_color }};
    background: var(--pst-header-bg);
    {%- if section.settings.header_border -%}
      border-bottom: 1px solid {{ section.settings.header_border_color }};
    {%- else -%}
      border-bottom: none;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .pst-header-wrapper.color-{{ section.settings.color_scheme }}.gradient {
    background: var(--pst-header-bg);
  }

  #shopify-section-{{ section.id }} header.pst-header--sticky {
    position: sticky;
    top: 0;
    z-index: 100;
  }

  #shopify-section-{{ section.id }} .pst-header .header__icon--menu {
    color: var(--pst-header-hamburger, #0a2540);
  }

  #shopify-section-{{ section.id }} .pst-header .header__icon--menu svg path {
    fill: currentColor;
  }

  @media screen and (min-width: 990px) {
    .pst-header--nav-left .pst-header__nav {
      justify-content: flex-start;
    }

    .pst-header--nav-left .pst-header__nav-list {
      justify-content: flex-start;
    }

    .pst-header--nav-right .pst-header__nav {
      justify-content: flex-end;
    }

    .pst-header--nav-right .pst-header__nav-list {
      justify-content: flex-end;
    }

    .pst-header--nav-center .pst-header__nav {
      justify-content: center;
    }

    .pst-header--nav-center .pst-header__nav-list {
      justify-content: center;
    }
  }

  @media screen and (max-width: 989px) {
    .pst-header--hamburger-right .pst-header__grid {
      grid-template-areas: 'logo actions drawer';
      grid-template-columns: minmax(0, 1fr) auto auto;
    }

    .pst-header--hamburger-right .pst-header__drawer {
      grid-area: drawer;
      justify-self: end;
      margin-left: 0;
      margin-right: -1rem;
    }

    .pst-header--hamburger-right .pst-header__logo {
      grid-area: logo;
      justify-self: start;
      text-align: left;
    }

    .pst-header--hamburger-right .pst-header__actions {
      grid-area: actions;
    }
  }

  #shopify-section-{{ section.id }} .pst-header__cta.pst-cta--small {
    padding: 6px 14px;
    font-size: 13px;
    min-height: auto;
  }

  #shopify-section-{{ section.id }} .pst-header__cta.pst-cta--medium {
    padding: 10px 20px;
    font-size: 14px;
    min-height: auto;
  }

  #shopify-section-{{ section.id }} .pst-header__cta.pst-cta--large {
    padding: 14px 28px;
    font-size: 16px;
    min-height: auto;
  }

  .pst-header {
    padding-left: 2rem;
    padding-right: 2rem;
  }

  .pst-header__grid {
    display: grid;
    grid-template-areas: 'drawer logo actions';
    grid-template-columns: auto minmax(0, 1fr) auto;
    align-items: center;
    gap: 0.8rem 0.6rem;
    min-height: 6.8rem;
    max-width: var(--page-width);
    margin: 0 auto;
  }

  @media screen and (max-width: 768px) {
    .pst-header {
      padding-left: 1rem;
      padding-right: 1rem;
    }

    .pst-header__grid {
      gap: 0.5rem 0.4rem;
    }
  }

  @media screen and (min-width: 990px) {
    .pst-header__grid {
      grid-template-areas: 'logo nav actions';
      grid-template-columns: auto minmax(0, 1fr) auto;
      gap: 0.8rem 1.2rem;
    }
  }

  .pst-header__drawer {
    grid-area: drawer;
    justify-self: start;
    margin-left: -1rem;
  }

  @media screen and (min-width: 990px) {
    .pst-header__drawer {
      display: none;
    }
  }

  .pst-header__logo {
    grid-area: logo;
    justify-self: center;
    text-align: center;
    min-width: 0;
  }

  @media screen and (min-width: 990px) {
    .pst-header__logo {
      justify-self: start;
      text-align: left;
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} header.pst-header--logo-center .pst-header__logo {
      justify-self: center;
      position: relative;
      text-align: center;
      min-height: {{ pst_style_logo_h }}px;
    }

    #shopify-section-{{ section.id }} header.pst-header--logo-center .pst-header__logo .header__heading {
      position: absolute;
      left: 50%;
      top: 50%;
      transform: translate(-50%, -50%);
      white-space: nowrap;
      z-index: 1;
    }

    #shopify-section-{{ section.id }} header.pst-header--logo-center .pst-header__logo .header__heading-link {
      align-items: center;
    }
  }

  .pst-header__logo .header__heading {
    line-height: 1.15;
  }

  .pst-header__logo .header__heading-link {
    text-decoration: none;
    display: inline-flex;
    flex-direction: column;
    align-items: center;
    max-width: 100%;
  }

  @media screen and (min-width: 990px) {
    .pst-header__logo .header__heading-link {
      align-items: flex-start;
    }
  }

  .pst-header__logo .header__heading-logo-wrapper {
    max-width: 18rem;
  }

  /* Text shop name only when no logo image */
  .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
    font-family: var(--font-heading-family);
    font-weight: 700;
    color: var(--pst-color-primary-dark-navy, #0a2540);
    line-height: 1.2;
    text-align: center;
  }

  @media screen and (max-width: 768px) {
    .pst-header__logo .header__heading-link {
      align-items: center;
      justify-content: center;
    }

    .pst-header__logo .header__heading-logo-wrapper {
      margin-left: auto;
      margin-right: auto;
      display: flex;
      justify-content: center;
      max-width: 100%;
    }

    .pst-header__logo .header__heading-logo {
      max-height: 60px;
      width: auto;
      height: auto;
      object-fit: contain;
    }

    .pst-header__brand-text--text-only {
      display: block;
      font-size: 16px;
      max-width: 14rem;
    }

    .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
      font-size: 16px;
      line-height: 1.2;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 989px) {
    .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
      font-size: 1.5rem;
    }
  }

  @media screen and (min-width: 990px) {
    .pst-header__logo .header__heading-link .pst-header__brand-text--text-only.h2 {
      font-size: inherit;
      text-align: left;
    }
  }

  .pst-header__nav {
    display: none;
    grid-area: nav;
    justify-content: center;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    .pst-header__nav {
      display: flex;
    }
  }

  .pst-header__nav-list {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 0.4rem 1.6rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pst-header__nav-item {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pst-header__nav-item--dropdown {
    position: relative;
  }

  .pst-header__nav-details {
    position: relative;
  }

  .pst-header__nav-summary {
    list-style: none;
    cursor: pointer;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    padding: 0.4rem 0;
    white-space: nowrap;
  }

  .pst-header__nav-summary::-webkit-details-marker {
    display: none;
  }

  .pst-header__nav-summary:hover,
  .pst-header__nav-summary:focus {
    color: var(--pst-header-nav-hover, var(--pst-color-navy-light, #1a6ba0));
    outline: none;
  }

  .pst-header__nav-details[open] .pst-header__nav-summary {
    color: var(--pst-header-nav-hover, var(--pst-color-navy-light, #1a6ba0));
  }

  .pst-header__dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    min-width: 28rem;
    margin: 0.4rem 0 0;
    padding: 0.6rem 0;
    list-style: none;
    background: #fff;
    border: 1px solid rgba(15, 72, 114, 0.12);
    border-radius: 0.5rem;
    box-shadow: 0 12px 32px rgba(10, 37, 64, 0.12);
    z-index: 20;
  }

  .pst-header__dropdown-link {
    display: block;
    padding: 0.55rem 1.4rem;
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-weight: 500;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    text-decoration: none;
    white-space: nowrap;
  }

  .pst-header__dropdown-link:hover,
  .pst-header__dropdown-link:focus {
    color: var(--pst-header-nav-hover, var(--pst-color-navy-light, #1a6ba0));
    background: rgba(15, 72, 114, 0.06);
  }

  .pst-header__nav-link {
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    text-decoration: none;
    padding: 0.4rem 0;
    white-space: nowrap;
  }

  .pst-header__nav-link:hover,
  .pst-header__nav-link:focus {
    color: var(--pst-header-nav-hover, var(--pst-color-navy-light, #1a6ba0));
  }

  .pst-header__actions {
    grid-area: actions;
    justify-self: end;
    display: flex;
    align-items: center;
    gap: 0.8rem 1.2rem;
  }

  .pst-header__quote {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    padding: 0.85rem 1.4rem;
    background-color: var(--pst-header-cta-bg, var(--pst-color-magenta, #e91e8c));
    color: var(--pst-header-cta-fg, #fff);
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.4rem;
    border: none;
    cursor: pointer;
    transition: filter 0.2s ease, transform 0.15s ease, background-color 0.2s ease;
    white-space: nowrap;
  }

  .pst-header__phone {
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
    text-decoration: none;
    white-space: nowrap;
  }

  .pst-header__phone:hover,
  .pst-header__phone:focus {
    color: var(--pst-header-nav-hover, var(--pst-color-navy-light, #1a6ba0));
    text-decoration: underline;
  }

  .pst-header__quote-icon {
    display: none;
    flex-shrink: 0;
    width: 2rem;
    height: 2rem;
    align-items: center;
    justify-content: center;
  }

  .pst-header__quote-icon svg {
    width: 1.8rem;
    height: 1.8rem;
    fill: currentColor;
  }

  @media screen and (max-width: 768px) {
    .pst-header__quote.pst-header__cta {
      padding: 0.75rem;
      min-width: 4.4rem;
      min-height: 4.4rem;
    }

    .pst-header__quote-icon {
      display: flex;
    }

    .pst-header__quote-label {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border-width: 0;
    }
  }

  @media screen and (min-width: 769px) {
    .pst-header__quote-icon {
      display: none;
    }

    .pst-header__quote-label {
      position: static;
      width: auto;
      height: auto;
      margin: 0;
      overflow: visible;
      clip: auto;
      white-space: nowrap;
    }
  }

  .pst-header__quote.pst-header__cta:hover,
  .pst-header__quote.pst-header__cta:focus {
    filter: brightness(1.05);
  }

  .pst-header__icons {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }

  #shopify-section-{{ section.id }} .pst-header__icons .header__search {
    display: inline-flex;
  }

  .pst-header__icons .header__icon {
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
  }

  header-drawer {
    justify-self: start;
  }

  .pst-header__drawer-triggers {
    display: flex;
    align-items: center;
    gap: 0.35rem;
  }

  #shopify-section-{{ section.id }} .pst-mobile-search {
    display: none;
  }

  #shopify-section-{{ section.id }} .pst-mobile-search .header__search {
    display: inline-flex;
  }

  #shopify-section-{{ section.id }} .pst-mobile-search .header__icon {
    color: var(--pst-header-nav, var(--pst-color-slate, #334155));
  }

  /* Mobile (≤768px): flex header, logo align (theme setting), hamburger right, hide CTA + header cart/account */
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-header__grid {
      display: flex;
      flex-direction: row;
      align-items: center;
      justify-content: space-between;
      position: relative;
      grid-template-areas: none;
      grid-template-columns: unset;
      gap: 0.5rem;
    }

    #shopify-section-{{ section.id }} .pst-header__logo .header__heading img,
    #shopify-section-{{ section.id }} .pst-header__logo .header__heading-link img,
    #shopify-section-{{ section.id }} .pst-header__logo img.header__heading-logo {
      width: {{ section.settings.mobile_logo_width }}px !important;
      max-width: {{ section.settings.mobile_logo_width }}px !important;
      height: auto !important;
    }

    #shopify-section-{{ section.id }} .pst-header__logo .header__heading-logo-wrapper {
      max-width: {{ section.settings.mobile_logo_width }}px !important;
    }

    {% if section.settings.mobile_logo_alignment == 'center' %}
      #shopify-section-{{ section.id }} .pst-header__drawer {
        order: 3;
        margin-left: 0;
        margin-right: -1rem;
        z-index: 2;
        justify-self: unset;
      }

      #shopify-section-{{ section.id }} .pst-header__actions {
        order: 1;
        z-index: 2;
        justify-self: unset;
      }

      #shopify-section-{{ section.id }} .pst-header__logo {
        position: absolute;
        left: 0;
        right: 0;
        top: 0;
        bottom: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        pointer-events: none;
        z-index: 1;
        margin: 0;
        justify-self: unset;
        text-align: center;
        min-width: 0;
        grid-area: unset;
      }

      #shopify-section-{{ section.id }} .pst-header__logo .header__heading {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: auto;
        margin: 0;
        max-width: min(72vw, 280px);
      }

      #shopify-section-{{ section.id }} .pst-header__logo > a.header__heading-link {
        position: absolute;
        left: 50%;
        transform: translateX(-50%);
        pointer-events: auto;
        max-width: min(72vw, 280px);
      }

      #shopify-section-{{ section.id }} .pst-header__logo .header__heading-link {
        pointer-events: auto;
      }
    {% else %}
      #shopify-section-{{ section.id }} header.pst-header--mobile-logo-left .pst-header__drawer {
        order: 3;
        margin-left: auto;
        margin-right: -1rem;
        z-index: 2;
        justify-self: unset;
      }

      #shopify-section-{{ section.id }} header.pst-header--mobile-logo-left .pst-header__actions {
        order: 2;
        z-index: 2;
        justify-self: unset;
      }

      #shopify-section-{{ section.id }} header.pst-header--mobile-logo-left .pst-header__logo {
        order: 1;
        position: static;
        width: auto;
        flex: 0 0 auto;
        pointer-events: auto;
        z-index: 2;
        margin: 0;
        justify-self: unset;
        text-align: left;
        grid-area: unset;
        display: block;
      }

      #shopify-section-{{ section.id }} header.pst-header--mobile-logo-left .pst-header__logo .header__heading {
        position: static;
        transform: none;
        max-width: none;
      }

      #shopify-section-{{ section.id }} header.pst-header--mobile-logo-left .pst-header__logo > a.header__heading-link {
        position: static;
        transform: none;
        max-width: none;
      }
    {% endif %}

    #shopify-section-{{ section.id }} .pst-header__icons .header__search,
    #shopify-section-{{ section.id }} .pst-header__icons .header__icon--search,
    #shopify-section-{{ section.id }} .pst-header__icons details-modal.header__search {
      display: none !important;
    }

    #shopify-section-{{ section.id }} .pst-mobile-search {
      display: inline-flex !important;
      align-items: center;
    }

    #shopify-section-{{ section.id }} .pst-header__icons .header__icon--cart,
    #shopify-section-{{ section.id }} .pst-header__icons .header__icon--account,
    #shopify-section-{{ section.id }} .pst-header__cta {
      display: none !important;
    }
  }
</style>

{%- style -%}
  {%- if section.settings.header_sticky -%}
    #shopify-section-{{ section.id }}.section-header {
      position: sticky;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
      z-index: 4;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }}.section-header {
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {%- else -%}
    #shopify-section-{{ section.id }}.section-header {
      position: relative;
      margin-bottom: {{ section.settings.margin_bottom | times: 0.75 | round: 0 }}px;
      z-index: auto;
    }

    @media screen and (min-width: 750px) {
      #shopify-section-{{ section.id }}.section-header {
        margin-bottom: {{ section.settings.margin_bottom }}px;
      }
    }
  {%- endif -%}

  .pst-header {
    padding-top: {{ section.settings.padding_top | times: 0.5 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.5 | round: 0 }}px;
  }

  @media screen and (min-width: 990px) {
    .pst-header {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{%- liquid
  for block in section.blocks
    if block.type == '@app'
      assign has_app_block = true
    endif
  endfor
-%}

{% liquid
  assign header_tag = 'div'

  if section.settings.header_sticky and section.settings.sticky_header_type != 'none'
    assign header_tag = 'sticky-header'
  endif

  assign pst_logo_width = section.settings.logo_width | default: settings.logo_width | default: 150

  assign pst_drawer_cta_url = section.settings.cta_button_link
  if pst_drawer_cta_url == blank
    assign pst_drawer_cta_url = section.settings.quote_url
  endif
  if pst_drawer_cta_url == blank
    if pages.contact != blank
      assign pst_drawer_cta_url = pages.contact.url
    else
      assign pst_drawer_cta_url = '/pages/contact'
    endif
  endif
%}

<{{ header_tag }}
  {% if header_tag == 'sticky-header' %}
    data-sticky-type="{{ section.settings.sticky_header_type }}"
  {% endif %}
  class="header-wrapper pst-header-wrapper color-{{ section.settings.color_scheme }} gradient"
>
  <header
    class="pst-header{% if shop.customer_accounts_enabled %} pst-header--has-account{% endif %}{% if has_app_block %} pst-header--has-app{% endif %}{% if section.settings.logo_position == 'center' %} pst-header--logo-center{% endif %}{% if section.settings.nav_position == 'left' %} pst-header--nav-left{% elsif section.settings.nav_position == 'right' %} pst-header--nav-right{% else %} pst-header--nav-center{% endif %}{% if section.settings.header_sticky %} pst-header--sticky{% endif %}{% if section.settings.mobile_logo_alignment == 'left' %} pst-header--mobile-logo-left{% endif %}"
    role="banner"
    style="color: {{ section.settings.nav_text_color }};"
  >
    <div class="pst-header__grid{% if section.settings.hamburger_position == 'right' %} pst-header--hamburger-right{% endif %}">
      <div class="pst-header__drawer">
        <div class="pst-header__drawer-triggers">
          {%- assign pst_search_id = 'HeaderSearchMobile-' | append: section.id -%}
          <span class="pst-mobile-search">
            {% render 'header-search', input_id: pst_search_id %}
          </span>
          {% render 'pst-header-drawer',
            pst_drawer_cta_url: pst_drawer_cta_url,
            pst_drawer_cta_label: section.settings.cta_button_text,
            pst_drawer_show_cta: section.settings.show_cta_button,
            pst_drawer_cta_bg: section.settings.cta_button_color,
            pst_drawer_cta_fg: section.settings.cta_text_color
          %}
        </div>
      </div>

