{%- style -%}
  #shopify-section-{{ section.id }} .pst-testimonials {
    background-color: var(--pst-color-warm-white, #fdf8f0);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pst-testimonials__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  #shopify-section-{{ section.id }} .pst-testimonials__title {
    margin: 0 0 3.5rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    text-align: center;
    color: var(--pst-color-navy, #0f4872);
  }

  #shopify-section-{{ section.id }} .pst-testimonials__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pst-testimonials__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
      align-items: stretch;
    }
  }

  #shopify-section-{{ section.id }} .pst-testimonials__card {
    display: flex;
    flex-direction: column;
    padding: 2.4rem 2rem 2.2rem;
    background: #fff;
    border-radius: 0.6rem;
    border: 1px solid rgba(15, 72, 114, 0.08);
    box-shadow: 0 2px 12px rgba(10, 37, 64, 0.06);
  }

  #shopify-section-{{ section.id }} .pst-testimonials__mark {
    display: block;
    margin: 0 0 0.8rem;
    font-family: Georgia, 'Times New Roman', serif;
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 0.85;
    color: var(--pst-color-magenta, #e91e8c);
  }

  #shopify-section-{{ section.id }} .pst-testimonials__quote {
    margin: 0 0 1.6rem;
    flex-grow: 1;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.55;
    font-weight: 400;
    color: var(--pst-color-slate, #334155);
  }

  #shopify-section-{{ section.id }} .pst-testimonials__author {
    margin: 0 0 0.35rem;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    font-weight: 700;
    color: var(--pst-color-primary-dark-navy, #0a2540);
  }

  #shopify-section-{{ section.id }} .pst-testimonials__meta {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    font-style: italic;
    font-weight: 400;
    color: var(--pst-color-slate, #334155);
  }
{%- endstyle -%}

<section class="pst-testimonials">
  <div class="pst-testimonials__inner">
    {%- if section.settings.heading != blank -%}
      <h2 class="pst-testimonials__title">{{ section.settings.heading | escape }}</h2>
    {%- endif -%}

    <div class="pst-testimonials__grid">
      {%- for block in section.blocks -%}
        <blockquote class="pst-testimonials__card" {{ block.shopify_attributes }}>
          <span class="pst-testimonials__mark" aria-hidden="true">&#8220;</span>
          {%- if block.settings.quote != blank -%}
            <p class="pst-testimonials__quote">{{ block.settings.quote | escape }}</p>
          {%- endif -%}
          {%- if block.settings.name != blank -%}
            <cite class="pst-testimonials__author">{{ block.settings.name | escape }}</cite>
          {%- endif -%}
          {%- if block.settings.role != blank or block.settings.region != blank -%}
            <p class="pst-testimonials__meta">
              {%- if block.settings.role != blank -%}
                <span>{{ block.settings.role | escape }}</span>
              {%- endif -%}
              {%- if block.settings.role != blank and block.settings.region != blank -%}
                <span>, </span>
              {%- endif -%}
              {%- if block.settings.region != blank -%}
                <span>{{ block.settings.region | escape }}</span>
              {%- endif -%}
            </p>
          {%- endif -%}
        </blockquote>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST Testimonials",
  "tag": "section",
  "class": "pst-testimonials-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "What Schools Are Saying"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "quote",
      "name": "Testimonial",
      "settings": [
        {
          "type": "textarea",
          "id": "quote",
          "label": "Quote",
          "default": "Testimonial text."
        },
        {
          "type": "text",
          "id": "name",
          "label": "Name",
          "default": "Name"
        },
        {
          "type": "text",
          "id": "role",
          "label": "Role",
          "default": "Role title"
        },
        {
          "type": "text",
          "id": "region",
          "label": "State or location",
          "default": "State"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PST Testimonials",
      "blocks": [
        {
          "type": "quote",
          "settings": {
            "quote": "The Perfect Poster Maker has transformed how we communicate...",
            "name": "Laura M.",
            "role": "Media Specialist",
            "region": "North Carolina"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "As a principal, I needed a solution that was easy for staff...",
            "name": "William T.",
            "role": "Principal",
            "region": "Florida"
          }
        },
        {
          "type": "quote",
          "settings": {
            "quote": "The purchase order process was seamless...",
            "name": "Christine F.",
            "role": "Bookkeeper",
            "region": "South Carolina"
          }
        }
      ]
    }
  ]
}
{% endschema %}
