{%- style -%}
  #shopify-section-{{ section.id }} .pst-roles {
    background-color: #fff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pst-roles__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-roles__inner {
      padding: 0 1rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-roles__header {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto 3rem;
  }

  #shopify-section-{{ section.id }} .pst-roles__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.2rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--pst-color-navy, #0f4872);
  }

  #shopify-section-{{ section.id }} .pst-roles__subtitle {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.5rem;
    line-height: 1.5;
    color: var(--pst-color-slate, #334155);
  }

  #shopify-section-{{ section.id }} .pst-roles__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 1.75rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-roles__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1100px) {
    #shopify-section-{{ section.id }} .pst-roles__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-roles__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.75rem;
    background: var(--pst-color-warm-white, #fdf8f0);
    border: 1px solid rgba(15, 72, 114, 0.1);
    border-radius: 0.6rem;
    box-shadow: 0 4px 16px rgba(10, 37, 64, 0.06);
  }

  #shopify-section-{{ section.id }} .pst-roles__icon {
    width: 3.25rem;
    height: 3.25rem;
    margin-bottom: 1.25rem;
    color: var(--pst-color-navy, #0f4872);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pst-roles__icon svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  #shopify-section-{{ section.id }} .pst-roles__card-title {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading-family);
    font-size: 1.45rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pst-color-primary-dark-navy, #0a2540);
  }

  #shopify-section-{{ section.id }} .pst-roles__card-body {
    margin: 0 0 1.5rem;
    flex-grow: 1;
    font-family: var(--font-body-family);
    font-size: 1.35rem;
    line-height: 1.5;
    color: var(--pst-color-slate, #334155);
  }

  #shopify-section-{{ section.id }} .pst-roles__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.5rem;
    padding: 0 1.25rem;
    margin-top: auto;
    font-family: var(--font-body-family);
    font-size: 1.25rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    color: #fff;
    background: var(--pst-color-magenta, #e91e8c);
    border: 2px solid var(--pst-color-magenta, #e91e8c);
    border-radius: 0.45rem;
    transition: filter 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-roles__btn:hover,
  #shopify-section-{{ section.id }} .pst-roles__btn:focus {
    filter: brightness(1.05);
    color: #fff;
  }
{%- endstyle -%}

<section class="pst-roles">
  <div class="pst-roles__inner">
    {%- if section.settings.heading != blank or section.settings.subtitle != blank -%}
      <header class="pst-roles__header">
        {%- if section.settings.heading != blank -%}
          <h2 class="pst-roles__title">{{ section.settings.heading | escape }}</h2>
        {%- endif -%}
        {%- if section.settings.subtitle != blank -%}
          <p class="pst-roles__subtitle">{{ section.settings.subtitle | escape }}</p>
        {%- endif -%}
      </header>
    {%- endif -%}

    <div class="pst-roles__grid">
      {%- for block in section.blocks -%}
        <article class="pst-roles__card" {{ block.shopify_attributes }}>
          <div class="pst-roles__icon" aria-hidden="true">
            {%- case block.settings.icon -%}
              {%- when 'administrator' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 20L24 9l16 11v21H8V20z"/>
                  <path d="M18 42V26h12v16"/>
                  <path d="M24 9v5"/>
                  <circle cx="24" cy="16" r="2.5"/>
                  <path d="M22 32h4"/>
                </svg>
              {%- when 'media' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M8 10h32v28H8z"/>
                  <path d="M8 16h32M16 10v28"/>
                  <path d="M22 22h12M22 28h8"/>
                </svg>
              {%- when 'bookkeeper' -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 8h28v32H12z"/>
                  <path d="M12 16h28M18 8v32"/>
                  <path d="M20 24h16M20 30h12"/>
                  <path d="M8 38h6l-1-8H9l-1 8z"/>
                </svg>
              {%- else -%}
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 48 48" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                  <path d="M12 20c0-6 4-10 12-10s12 4 12 10v4H12z"/>
                  <path d="M8 42c2-8 8-12 16-12s14 4 16 12"/>
                  <circle cx="24" cy="14" r="3"/>
                </svg>
            {%- endcase -%}
          </div>
          {%- if block.settings.title != blank -%}
            <h3 class="pst-roles__card-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.body != blank -%}
            <p class="pst-roles__card-body">{{ block.settings.body | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a class="pst-roles__btn" href="{{ block.settings.button_link }}">{{ block.settings.button_label | escape }}</a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST For your role",
  "tag": "section",
  "class": "pst-roles-section",
  "max_blocks": 6,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For Your Role"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Resources tailored to how your school works."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Role card",
      "settings": [
        {
          "type": "select",
          "id": "icon",
          "label": "Icon",
          "options": [
            { "value": "administrator", "label": "Administrator / school" },
            { "value": "media", "label": "Media / library" },
            { "value": "bookkeeper", "label": "Bookkeeper" },
            { "value": "teacher", "label": "Teacher" }
          ],
          "default": "teacher"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Role title"
        },
        {
          "type": "textarea",
          "id": "body",
          "label": "Body",
          "default": "Short description for this audience."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PST For your role",
      "blocks": [
        {
          "type": "role",
          "settings": {
            "icon": "administrator",
            "title": "For School Administrators",
            "body": "Administrators managing school-wide visual learning programs trust Perfect School Tools for reliable equipment, district pricing, and dedicated support.",
            "button_label": "Learn More",
            "button_link": "/pages/for-administrators"
          }
        },
        {
          "type": "role",
          "settings": {
            "icon": "media",
            "title": "For Media Specialists",
            "body": "Stock your media center with poster makers, awards systems, and supplies designed for daily school use and simple reordering.",
            "button_label": "Learn More",
            "button_link": "/pages/contact"
          }
        },
        {
          "type": "role",
          "settings": {
            "icon": "bookkeeper",
            "title": "For Bookkeepers",
            "body": "We speak POs, quotes, and district billing — clear paperwork and responsive support for your business office.",
            "button_label": "Learn More",
            "button_link": "/pages/contact"
          }
        },
        {
          "type": "role",
          "settings": {
            "icon": "teacher",
            "title": "For Teachers",
            "body": "Create classroom visuals and recognition materials in-house without waiting on outside vendors.",
            "button_label": "Learn More",
            "button_link": "/pages/contact"
          }
        }
      ]
    }
  ]
}
{% endschema %}
