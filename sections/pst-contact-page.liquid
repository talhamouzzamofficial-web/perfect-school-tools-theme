{%- style -%}
  #shopify-section-{{ section.id }} {
    overflow-x: hidden;
    max-width: 100%;
    --pst-navy: #0a2540;
    --pst-magenta: #e91e8c;
    --pst-gold: #f5b731;
    --pst-page-bg: #fdf8f0;
  }

  #shopify-section-{{ section.id }} .pst-contact-page {
    background-color: var(--pst-page-bg);
    font-family: var(--font-body-family);
    color: #334155;
  }

  #shopify-section-{{ section.id }} .pst-contact-hero {
    background-color: var(--pst-navy);
    padding: 3.2rem 2rem 3.6rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-contact-hero__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4vw, 3.8rem);
    font-weight: 800;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-contact-hero__sub {
    margin: 0 auto;
    max-width: 58rem;
    font-size: 1.65rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.95);
  }

  #shopify-section-{{ section.id }} .pst-contact-main {
    max-width: 130rem;
    margin: 0 auto;
    padding: 4rem 2rem 4.5rem;
  }

  #shopify-section-{{ section.id }} .pst-contact-grid {
    display: grid;
    gap: 2.5rem;
    align-items: start;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pst-contact-grid {
      grid-template-columns: 3fr 2fr;
      gap: 3.5rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-contact-card {
    background: #fff;
    border-radius: 0.75rem;
    box-shadow: 0 4px 24px rgba(10, 37, 64, 0.08);
    border: 1px solid rgba(15, 72, 114, 0.08);
    padding: 2.5rem 2.2rem 2.8rem;
  }

  #shopify-section-{{ section.id }} .pst-contact-form__title {
    margin: 0 0 1.8rem;
    font-family: var(--font-heading-family);
    font-size: 2.2rem;
    font-weight: 700;
    color: var(--pst-navy);
  }

  #shopify-section-{{ section.id }} .pst-contact-form__status {
    margin-bottom: 1.5rem;
    padding: 1rem 1.2rem;
    border-radius: 0.5rem;
    font-size: 1.45rem;
  }

  #shopify-section-{{ section.id }} .pst-contact-form__status--success {
    background: rgba(34, 197, 94, 0.12);
    color: #166534;
    border: 1px solid rgba(34, 197, 94, 0.35);
  }

  #shopify-section-{{ section.id }} .pst-contact-form__status--error {
    background: rgba(239, 68, 68, 0.1);
    color: #991b1b;
    border: 1px solid rgba(239, 68, 68, 0.35);
  }

  #shopify-section-{{ section.id }} .pst-field-row {
    display: grid;
    gap: 1.2rem;
    margin-bottom: 1.2rem;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .pst-field-row--2 {
      grid-template-columns: 1fr 1fr;
    }
  }

  #shopify-section-{{ section.id }} .pst-field {
    display: flex;
    flex-direction: column;
    gap: 0.45rem;
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pst-field label,
  #shopify-section-{{ section.id }} .pst-field-label {
    font-size: 1.35rem;
    font-weight: 600;
    color: var(--pst-navy);
  }

  #shopify-section-{{ section.id }} .pst-field .pst-optional {
    font-weight: 400;
    color: #64748b;
    font-size: 1.25rem;
  }

  #shopify-section-{{ section.id }} .pst-input,
  #shopify-section-{{ section.id }} .pst-select,
  #shopify-section-{{ section.id }} .pst-textarea {
    width: 100%;
    padding: 1rem 1.1rem;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    border: 1px solid rgba(15, 72, 114, 0.22);
    border-radius: 0.45rem;
    background: #fff;
    color: #334155;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }

  #shopify-section-{{ section.id }} .pst-input:focus,
  #shopify-section-{{ section.id }} .pst-select:focus,
  #shopify-section-{{ section.id }} .pst-textarea:focus {
    outline: none;
    border-color: var(--pst-navy);
    box-shadow: 0 0 0 3px rgba(10, 37, 64, 0.12);
  }

  #shopify-section-{{ section.id }} .pst-textarea {
    min-height: 12rem;
    resize: vertical;
  }

  #shopify-section-{{ section.id }} .pst-check-group {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-top: 0.35rem;
  }

  #shopify-section-{{ section.id }} .pst-check {
    display: flex;
    align-items: flex-start;
    gap: 0.75rem;
    font-size: 1.4rem;
    line-height: 1.35;
    cursor: pointer;
  }

  #shopify-section-{{ section.id }} .pst-check input {
    width: 1.8rem;
    height: 1.8rem;
    margin-top: 0.2rem;
    accent-color: var(--pst-navy);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pst-submit {
    width: 100%;
    margin-top: 1.2rem;
    padding: 1.25rem 2rem;
    font-family: var(--font-body-family);
    font-size: 1.55rem;
    font-weight: 700;
    color: #fff;
    background: var(--pst-magenta);
    border: none;
    border-radius: 0.5rem;
    cursor: pointer;
    transition: filter 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-submit:hover,
  #shopify-section-{{ section.id }} .pst-submit:focus {
    filter: brightness(1.06);
  }

  #shopify-section-{{ section.id }} .pst-form-footnote {
    margin-top: 1.2rem;
    font-size: 1.35rem;
    text-align: center;
    color: #64748b;
  }

  #shopify-section-{{ section.id }} .pst-form-footnote a {
    color: var(--pst-navy);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .pst-sidebar {
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
  }

  #shopify-section-{{ section.id }} .pst-info-card {
    background: #fff;
    border-radius: 0.75rem;
    padding: 1.8rem 1.6rem;
    box-shadow: 0 4px 20px rgba(10, 37, 64, 0.07);
    border: 1px solid rgba(15, 72, 114, 0.08);
  }

  #shopify-section-{{ section.id }} .pst-info-card__icon {
    font-size: 2.2rem;
    line-height: 1;
    margin-bottom: 0.6rem;
  }

  #shopify-section-{{ section.id }} .pst-info-card__title {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading-family);
    font-size: 1.5rem;
    font-weight: 700;
    color: var(--pst-navy);
  }

  #shopify-section-{{ section.id }} .pst-info-card__line {
    margin: 0.15rem 0;
    font-size: 1.4rem;
    line-height: 1.45;
  }

  #shopify-section-{{ section.id }} .pst-info-card__line a {
    color: var(--pst-navy);
    font-weight: 600;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pst-info-card__line a:hover {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .pst-info-card--trust .pst-info-card__line {
    display: flex;
    align-items: flex-start;
    gap: 0.5rem;
    margin-bottom: 0.5rem;
    font-size: 1.35rem;
  }

  #shopify-section-{{ section.id }} .pst-info-card--trust .pst-info-card__line:last-child {
    margin-bottom: 0;
  }

  #shopify-section-{{ section.id }} .pst-cta-strip {
    background: var(--pst-navy);
    padding: 2.2rem 2rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-cta-strip__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 1.4rem;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-cta-strip__inner {
      flex-direction: row;
      justify-content: center;
      flex-wrap: wrap;
      gap: 2rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-cta-strip__text {
    margin: 0;
    font-size: 1.65rem;
    font-weight: 600;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-cta-strip__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 1rem 2rem;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    font-weight: 700;
    color: #fff;
    background: var(--pst-magenta);
    border-radius: 0.5rem;
    text-decoration: none;
    border: 2px solid var(--pst-magenta);
    transition: filter 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-cta-strip__btn:hover,
  #shopify-section-{{ section.id }} .pst-cta-strip__btn:focus {
    filter: brightness(1.08);
    color: #fff;
  }
{%- endstyle -%}

<div class="pst-contact-page">
  <div class="pst-contact-hero">
    {%- if section.settings.hero_heading != blank -%}
      <h1 class="pst-contact-hero__title">{{ section.settings.hero_heading | escape }}</h1>
    {%- endif -%}
    {%- if section.settings.hero_subtext != blank -%}
      <p class="pst-contact-hero__sub">{{ section.settings.hero_subtext | escape }}</p>
    {%- endif -%}
  </div>

  <div class="pst-contact-main">
    <div class="pst-contact-grid">
      <div class="pst-contact-card">
        {%- if section.settings.form_heading != blank -%}
          <h2 class="pst-contact-form__title">{{ section.settings.form_heading | escape }}</h2>
        {%- endif -%}

        {%- form 'contact', id: 'PstQuoteForm', class: 'pst-quote-form' -%}
          <input type="hidden" name="contact[name]" id="pst-contact-name" value="">
          <input type="hidden" name="contact[body]" id="pst-contact-body" value="">

          {%- if form.posted_successfully? -%}
            <p class="pst-contact-form__status pst-contact-form__status--success" tabindex="-1">
              {{ section.settings.success_message | default: 'Thank you! We received your quote request and will respond within one business day.' | escape }}
            </p>
          {%- elsif form.errors -%}
            <div class="pst-contact-form__status pst-contact-form__status--error" role="alert">
              {{ form.errors | default_errors }}
            </div>
          {%- endif -%}

          <div class="pst-field-row pst-field-row--2">
            <div class="pst-field">
              <label for="pst-quote-fn">First Name <span aria-hidden="true">*</span></label>
              <input class="pst-input" id="pst-quote-fn" type="text" autocomplete="given-name" required>
            </div>
            <div class="pst-field">
              <label for="pst-quote-ln">Last Name <span aria-hidden="true">*</span></label>
              <input class="pst-input" id="pst-quote-ln" type="text" autocomplete="family-name" required>
            </div>
          </div>

          <div class="pst-field-row">
            <div class="pst-field">
              <label for="pst-quote-school">School Name <span aria-hidden="true">*</span></label>
              <input class="pst-input" id="pst-quote-school" type="text" autocomplete="organization" required>
            </div>
          </div>

          <div class="pst-field-row">
            <div class="pst-field">
              <label for="pst-quote-role">Your Role <span aria-hidden="true">*</span></label>
              <select class="pst-select" id="pst-quote-role" required>
                <option value="">Select one…</option>
                <option value="Media Specialist">Media Specialist</option>
                <option value="Principal">Principal</option>
                <option value="Bookkeeper">Bookkeeper</option>
                <option value="Teacher">Teacher</option>
                <option value="District Administrator">District Administrator</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="pst-field-row">
            <div class="pst-field">
              <label for="pst-quote-district">School District <span aria-hidden="true">*</span></label>
              <input class="pst-input" id="pst-quote-district" type="text" required>
            </div>
          </div>

          <div class="pst-field-row">
            <div class="pst-field">
              <label for="pst-quote-state">State <span aria-hidden="true">*</span></label>
              <select class="pst-select" id="pst-quote-state" required>
                <option value="">Select state…</option>
                <option value="AL">Alabama</option>
                <option value="AK">Alaska</option>
                <option value="AZ">Arizona</option>
                <option value="AR">Arkansas</option>
                <option value="CA">California</option>
                <option value="CO">Colorado</option>
                <option value="CT">Connecticut</option>
                <option value="DE">Delaware</option>
                <option value="DC">District of Columbia</option>
                <option value="FL">Florida</option>
                <option value="GA">Georgia</option>
                <option value="HI">Hawaii</option>
                <option value="ID">Idaho</option>
                <option value="IL">Illinois</option>
                <option value="IN">Indiana</option>
                <option value="IA">Iowa</option>
                <option value="KS">Kansas</option>
                <option value="KY">Kentucky</option>
                <option value="LA">Louisiana</option>
                <option value="ME">Maine</option>
                <option value="MD">Maryland</option>
                <option value="MA">Massachusetts</option>
                <option value="MI">Michigan</option>
                <option value="MN">Minnesota</option>
                <option value="MS">Mississippi</option>
                <option value="MO">Missouri</option>
                <option value="MT">Montana</option>
                <option value="NE">Nebraska</option>
                <option value="NV">Nevada</option>
                <option value="NH">New Hampshire</option>
                <option value="NJ">New Jersey</option>
                <option value="NM">New Mexico</option>
                <option value="NY">New York</option>
                <option value="NC">North Carolina</option>
                <option value="ND">North Dakota</option>
                <option value="OH">Ohio</option>
                <option value="OK">Oklahoma</option>
                <option value="OR">Oregon</option>
                <option value="PA">Pennsylvania</option>
                <option value="RI">Rhode Island</option>
                <option value="SC">South Carolina</option>
                <option value="SD">South Dakota</option>
                <option value="TN">Tennessee</option>
                <option value="TX">Texas</option>
                <option value="UT">Utah</option>
                <option value="VT">Vermont</option>
                <option value="VA">Virginia</option>
                <option value="WA">Washington</option>
                <option value="WV">West Virginia</option>
                <option value="WI">Wisconsin</option>
                <option value="WY">Wyoming</option>
              </select>
            </div>
          </div>

          <div class="pst-field-row pst-field-row--2">
            <div class="pst-field">
              <label for="pst-quote-phone">Phone Number <span aria-hidden="true">*</span></label>
              <input
                class="pst-input"
                id="pst-quote-phone"
                type="tel"
                name="contact[phone]"
                autocomplete="tel"
                required
              >
            </div>
            <div class="pst-field">
              <label for="pst-quote-email">Email Address <span aria-hidden="true">*</span></label>
              <input
                class="pst-input"
                id="pst-quote-email"
                type="email"
                name="contact[email]"
                autocomplete="email"
                required
                {% if form.errors contains 'email' %}
                  aria-invalid="true"
                {% endif %}
                value="{% if form.email %}{{ form.email }}{% elsif customer %}{{ customer.email }}{% endif %}"
              >
            </div>
          </div>

          <div class="pst-field-row">
            <div class="pst-field">
              <label class="pst-field-label" for="pst-products-fieldset">Products Interested In</label>
              <span class="pst-optional" id="pst-products-fieldset-hint">(select all that apply)</span>
              <div class="pst-check-group" id="pst-products-fieldset" role="group" aria-describedby="pst-products-fieldset-hint">
                <label class="pst-check"><input type="checkbox" class="pst-product-cb" data-label="Poster Maker System ($3,795)"><span>Poster Maker System ($3,795)</span></label>
                <label class="pst-check"><input type="checkbox" class="pst-product-cb" data-label="Awards &amp; Cut System ($3,995)"><span>Awards &amp; Cut System ($3,995)</span></label>
                <label class="pst-check"><input type="checkbox" class="pst-product-cb" data-label="Awards Maker ($2,995)"><span>Awards Maker ($2,995)</span></label>
                <label class="pst-check"><input type="checkbox" class="pst-product-cb" data-label="Cold Laminator System"><span>Cold Laminator System</span></label>
                <label class="pst-check"><input type="checkbox" class="pst-product-cb" data-label="Supplies &amp; Consumables"><span>Supplies &amp; Consumables</span></label>
                <label class="pst-check"><input type="checkbox" class="pst-product-cb" data-label="Bundle Package"><span>Bundle Package</span></label>
              </div>
            </div>
          </div>

          <div class="pst-field-row">
            <div class="pst-field">
              <label for="pst-quote-hear">How did you hear about us?</label>
              <select class="pst-select" id="pst-quote-hear">
                <option value="">Select one…</option>
                <option value="Google / web search">Google / web search</option>
                <option value="Referral from colleague">Referral from colleague</option>
                <option value="Education conference or trade show">Education conference or trade show</option>
                <option value="Email or newsletter">Email or newsletter</option>
                <option value="Social media">Social media</option>
                <option value="Other">Other</option>
              </select>
            </div>
          </div>

          <div class="pst-field-row">
            <div class="pst-field">
              <label for="pst-quote-notes">Additional Notes / Questions</label>
              <textarea class="pst-textarea" id="pst-quote-notes" placeholder="Tell us about your timeline, quantities, or questions."></textarea>
            </div>
          </div>

          <button type="submit" class="pst-submit">{{ section.settings.submit_label | escape }}</button>

          <p class="pst-form-footnote">
            Or email your PO directly to
            <a href="mailto:{{ section.settings.po_email | escape }}">{{ section.settings.po_email | escape }}</a>
          </p>
        {%- endform -%}
      </div>

      <aside class="pst-sidebar" aria-label="Contact information">
        <div class="pst-info-card">
          <div class="pst-info-card__icon" aria-hidden="true">📞</div>
          <h3 class="pst-info-card__title">Call Us Direct</h3>
          <p class="pst-info-card__line">
            <a href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}">{{ section.settings.phone | escape }}</a>
          </p>
          <p class="pst-info-card__line">Mon-Fri 8am-5pm EST</p>
        </div>

        <div class="pst-info-card">
          <div class="pst-info-card__icon" aria-hidden="true">✉️</div>
          <h3 class="pst-info-card__title">Email Us</h3>
          <p class="pst-info-card__line">
            <a href="mailto:{{ section.settings.po_email | escape }}">{{ section.settings.po_email | escape }}</a>
          </p>
          <p class="pst-info-card__line">We respond within 1 business day</p>
        </div>

        <div class="pst-info-card">
          <div class="pst-info-card__icon" aria-hidden="true">📄</div>
          <h3 class="pst-info-card__title">Submit a Purchase Order</h3>
          <p class="pst-info-card__line">Email your PO to <a href="mailto:{{ section.settings.po_email | escape }}">{{ section.settings.po_email | escape }}</a></p>
          <p class="pst-info-card__line">Net 30 terms available for districts</p>
        </div>

        <div class="pst-info-card pst-info-card--trust">
          <h3 class="pst-info-card__title">Why schools choose us</h3>
          <p class="pst-info-card__line"><span aria-hidden="true">✓</span> 30+ Years Experience Serving Schools</p>
          <p class="pst-info-card__line"><span aria-hidden="true">✓</span> Fast Shipping on All Orders</p>
          <p class="pst-info-card__line"><span aria-hidden="true">✓</span> Purchase Orders Accepted</p>
          <p class="pst-info-card__line"><span aria-hidden="true">✓</span> Unlimited Support Included</p>
        </div>
      </aside>
    </div>
  </div>

  <div class="pst-cta-strip">
    <div class="pst-cta-strip__inner">
      <p class="pst-cta-strip__text">{{ section.settings.bottom_cta_text | escape }}</p>
      {%- if section.settings.bottom_cta_btn_label != blank and section.settings.bottom_cta_btn_url != blank -%}
        <a class="pst-cta-strip__btn" href="{{ section.settings.bottom_cta_btn_url }}">{{ section.settings.bottom_cta_btn_label | escape }}</a>
      {%- endif -%}
    </div>
  </div>
</div>

{% javascript %}
  (function () {
    var form = document.getElementById('PstQuoteForm');
    if (!form) return;

    form.addEventListener('submit', function () {
      var fn = document.getElementById('pst-quote-fn');
      var ln = document.getElementById('pst-quote-ln');
      var nameField = document.getElementById('pst-contact-name');
      var bodyField = document.getElementById('pst-contact-body');
      if (nameField && fn && ln) {
        nameField.value = (fn.value || '').trim() + ' ' + (ln.value || '').trim();
      }

      var lines = [];
      lines.push('--- Quote request (Perfect School Tools) ---');
      lines.push('School: ' + (document.getElementById('pst-quote-school') || {}).value);
      lines.push('Role: ' + (document.getElementById('pst-quote-role') || {}).value);
      lines.push('District: ' + (document.getElementById('pst-quote-district') || {}).value);
      var st = document.getElementById('pst-quote-state');
      if (st && st.options[st.selectedIndex]) lines.push('State: ' + st.options[st.selectedIndex].text);
      lines.push('');
      lines.push('Products interested in:');
      document.querySelectorAll('.pst-product-cb:checked').forEach(function (cb) {
        lines.push('• ' + (cb.dataset.label || cb.getAttribute('data-label') || ''));
      });
      var none = true;
      document.querySelectorAll('.pst-product-cb').forEach(function (cb) {
        if (cb.checked) none = false;
      });
      if (none) lines.push('(none selected)');
      lines.push('');
      lines.push('How they heard about us: ' + ((document.getElementById('pst-quote-hear') || {}).value || '—'));
      lines.push('');
      lines.push('Additional notes:');
      lines.push((document.getElementById('pst-quote-notes') || {}).value || '—');

      if (bodyField) bodyField.value = lines.join('\n');
    });
  })();
{% endjavascript %}

{% schema %}
{
  "name": "PST Contact page",
  "tag": "section",
  "class": "pst-contact-page-section",
  "settings": [
    {
      "type": "text",
      "id": "hero_heading",
      "label": "Hero heading",
      "default": "Request a Quote"
    },
    {
      "type": "textarea",
      "id": "hero_subtext",
      "label": "Hero subtext",
      "default": "Fill out the form below and we'll respond within 1 business day. We accept purchase orders."
