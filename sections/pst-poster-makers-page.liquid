{%- style -%}
  #shopify-section-{{ section.id }} {
    --pst-navy: #0a2540;
    --pst-magenta: #e91e8c;
    --pst-gold: #f5b731;
    --pst-warm: #fdf8f0;
    --pst-body: #334155;
  }

  #shopify-section-{{ section.id }} .pst-pm {
    font-family: var(--font-body-family);
    color: var(--pst-body);
  }

  #shopify-section-{{ section.id }} .pst-pm__hero {
    background: linear-gradient(165deg, #0a2540 0%, #0f4872 52%, #0a2540 100%);
    padding: 3rem 2rem 3.8rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-pm__badge {
    display: inline-block;
    margin: 0 0 1.2rem;
    padding: 0.45rem 1rem;
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    color: var(--pst-gold);
    background: rgba(255, 255, 255, 0.1);
    border: 1px solid rgba(245, 183, 49, 0.45);
    border-radius: 999px;
  }

  #shopify-section-{{ section.id }} .pst-pm__hero-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.4rem, 4vw, 3.5rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.15;
  }

  #shopify-section-{{ section.id }} .pst-pm__hero-sub {
    margin: 0 auto 2rem;
    max-width: 58rem;
    font-size: 1.65rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.96);
  }

  #shopify-section-{{ section.id }} .pst-pm__hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    max-width: 52rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4.8rem;
    padding: 0 1.8rem;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    font-weight: 700;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: filter 0.2s ease, background 0.2s ease;
    flex: 1 1 auto;
    min-width: min(100%, 17rem);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--magenta {
    background: var(--pst-magenta);
    color: #fff;
    border: 2px solid var(--pst-magenta);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--magenta:hover,
  #shopify-section-{{ section.id }} .pst-pm__btn--magenta:focus {
    filter: brightness(1.06);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--outline-light {
    background: transparent;
    color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.95);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--outline-light:hover,
  #shopify-section-{{ section.id }} .pst-pm__btn--outline-light:focus {
    background: rgba(255, 255, 255, 0.1);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-pm__trust {
    background: var(--pst-gold);
    padding: 1.4rem 1.5rem;
  }

  #shopify-section-{{ section.id }} .pst-pm__trust-inner {
    max-width: 130rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__trust-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-pm__trust-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .pst-pm__trust-item {
    padding: 1.15rem 0.85rem;
    text-align: center;
    font-family: var(--font-body-family);
    font-size: 1.2rem;
    font-weight: 700;
    line-height: 1.35;
    color: var(--pst-navy);
    border: 1px solid rgba(10, 37, 64, 0.12);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-pm__trust-item {
      padding: 1.5rem 1rem;
      font-size: 1.32rem;
      border-left: none;
    }

    #shopify-section-{{ section.id }} .pst-pm__trust-item:first-child {
      border-left: 1px solid rgba(10, 37, 64, 0.12);
    }
  }

  #shopify-section-{{ section.id }} .pst-pm__features {
    background: var(--pst-warm);
    padding: 4rem 2rem 4.5rem;
  }

  #shopify-section-{{ section.id }} .pst-pm__features-inner {
    max-width: 130rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__eyebrow {
    margin: 0 0 0.6rem;
    font-family: var(--font-heading-family);
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--pst-magenta);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-pm__h2 {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 3.5vw, 3.2rem);
    font-weight: 800;
    color: var(--pst-navy);
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-pm__intro {
    margin: 0 auto 2.5rem;
    max-width: 56rem;
    font-size: 1.45rem;
    line-height: 1.55;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-pm__feature-grid {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .pst-pm__feature-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .pst-pm__feature-card {
    padding: 2rem 1.6rem;
    background: #fff;
    border: 1px solid rgba(15, 72, 114, 0.1);
    border-radius: 0.75rem;
    box-shadow: 0 4px 20px rgba(10, 37, 64, 0.07);
  }

  #shopify-section-{{ section.id }} .pst-pm__feature-icon {
    font-size: 2.8rem;
    line-height: 1;
    margin-bottom: 1rem;
  }

  #shopify-section-{{ section.id }} .pst-pm__feature-card h3 {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading-family);
    font-size: 1.55rem;
    font-weight: 700;
    color: var(--pst-navy);
  }

  #shopify-section-{{ section.id }} .pst-pm__feature-card p {
    margin: 0;
    font-size: 1.4rem;
    line-height: 1.55;
  }

  #shopify-section-{{ section.id }} .pst-pm__mid-cta {
    background: var(--pst-navy);
    padding: 3.5rem 2rem 4rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-pm__mid-cta-inner {
    max-width: 72rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__mid-cta .pst-pm__h2 {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-pm__mid-sub {
    margin: 0 0 1.8rem;
    font-size: 1.5rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.94);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--outline-gold {
    background: transparent;
    color: var(--pst-gold);
    border: 2px solid var(--pst-gold);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--outline-gold:hover,
  #shopify-section-{{ section.id }} .pst-pm__btn--outline-gold:focus {
    background: rgba(245, 183, 49, 0.12);
    color: var(--pst-gold);
  }

  #shopify-section-{{ section.id }} .pst-pm__supplies {
    background: #fff;
    padding: 4rem 2rem 4.5rem;
  }

  #shopify-section-{{ section.id }} .pst-pm__supplies-inner {
    max-width: 130rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__supply-grid {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .pst-pm__supply-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pst-pm__supply-grid {
      grid-template-columns: repeat(4, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .pst-pm__supply-card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.5rem;
    background: var(--pst-warm);
    border: 1px solid rgba(15, 72, 114, 0.1);
    border-radius: 0.75rem;
    box-shadow: 0 4px 20px rgba(10, 37, 64, 0.06);
    text-decoration: none;
    color: inherit;
    transition: box-shadow 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-pm__supply-card:hover {
    box-shadow: 0 8px 28px rgba(10, 37, 64, 0.1);
  }

  #shopify-section-{{ section.id }} .pst-pm__supply-icon {
    font-size: 2.6rem;
    line-height: 1;
    margin-bottom: 0.75rem;
  }

  #shopify-section-{{ section.id }} .pst-pm__supply-card h3 {
    margin: 0 0 0.5rem;
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 700;
    color: var(--pst-navy);
  }

  #shopify-section-{{ section.id }} .pst-pm__supply-link {
    margin-top: auto;
    padding-top: 1rem;
    font-weight: 700;
    font-size: 1.35rem;
    color: var(--pst-magenta);
  }

  #shopify-section-{{ section.id }} .pst-pm__mission {
    background: var(--pst-navy);
    padding: 4rem 2rem 4.5rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-pm__mission-inner {
    max-width: 52rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__mission-quote-wrap {
    margin: 0 0 1.5rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: baseline;
    gap: 0.15rem 0.35rem;
  }

  #shopify-section-{{ section.id }} .pst-pm__q-mark {
    font-family: var(--font-heading-family);
    font-size: clamp(3.5rem, 8vw, 5rem);
    font-weight: 800;
    line-height: 0.85;
    color: var(--pst-gold);
    vertical-align: super;
  }

  #shopify-section-{{ section.id }} .pst-pm__mission-quote {
    margin: 0;
    font-family: var(--font-heading-family);
    font-size: clamp(1.85rem, 3.5vw, 2.6rem);
    font-weight: 700;
    font-style: italic;
    line-height: 1.35;
    color: #fff;
    display: inline;
  }

  #shopify-section-{{ section.id }} .pst-pm__mission-sub {
    margin: 0 0 1.8rem;
    font-size: 1.45rem;
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.88);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--gold {
    background: var(--pst-gold);
    color: var(--pst-navy);
    border: 2px solid var(--pst-gold);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--gold:hover,
  #shopify-section-{{ section.id }} .pst-pm__btn--gold:focus {
    filter: brightness(1.05);
    color: var(--pst-navy);
  }

  #shopify-section-{{ section.id }} .pst-pm__testimonials {
    background: var(--pst-warm);
    padding: 4rem 2rem 4.5rem;
  }

  #shopify-section-{{ section.id }} .pst-pm__testimonials-inner {
    max-width: 130rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__test-grid {
    display: grid;
    gap: 1.8rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .pst-pm__test-grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pst-pm__test-grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-pm__test-card {
    padding: 1.8rem 1.5rem;
    background: #fff;
    border: 1px solid rgba(15, 72, 114, 0.1);
    border-radius: 0.75rem;
    box-shadow: 0 4px 20px rgba(10, 37, 64, 0.07);
    display: flex;
    flex-direction: column;
    height: 100%;
  }

  #shopify-section-{{ section.id }} .pst-pm__stars {
    margin-bottom: 0.85rem;
    font-size: 1.35rem;
    letter-spacing: 0.12em;
    color: var(--pst-gold);
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .pst-pm__test-quote {
    margin: 0 0 1.2rem;
    font-size: 1.35rem;
    line-height: 1.55;
    flex-grow: 1;
  }

  #shopify-section-{{ section.id }} .pst-pm__test-name {
    font-weight: 700;
    color: var(--pst-navy);
  }

  #shopify-section-{{ section.id }} .pst-pm__test-meta {
    font-size: 1.3rem;
    color: var(--pst-magenta);
    font-weight: 600;
  }

  #shopify-section-{{ section.id }} .pst-pm__bottom {
    background: linear-gradient(135deg, #e91e8c 0%, #c91578 55%, #e91e8c 100%);
    padding: 3.2rem 2rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-pm__bottom-title {
    margin: 0 0 0.85rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.2rem, 3.5vw, 3rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pst-pm__bottom-sub {
    margin: 0 auto 1.8rem;
    max-width: 48rem;
    font-size: 1.5rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.96);
  }

  #shopify-section-{{ section.id }} .pst-pm__bottom-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem;
    justify-content: center;
    align-items: center;
    max-width: 52rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--white {
    background: #fff;
    color: var(--pst-magenta);
    border: 2px solid #fff;
    min-width: min(100%, 20rem);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--white:hover,
  #shopify-section-{{ section.id }} .pst-pm__btn--white:focus {
    filter: brightness(0.98);
    color: var(--pst-magenta);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--bottom-outline {
    background: transparent;
    color: #fff;
    border: 2px solid #fff;
    min-width: min(100%, 20rem);
  }

  #shopify-section-{{ section.id }} .pst-pm__btn--bottom-outline:hover,
  #shopify-section-{{ section.id }} .pst-pm__btn--bottom-outline:focus {
    background: rgba(255, 255, 255, 0.12);
    color: #fff;
  }
{%- endstyle -%}

{%- liquid
  assign pst_pm_contact = section.settings.contact_url
  if pst_pm_contact == blank
    if pages.contact != empty
      assign pst_pm_contact = pages.contact.url
    else
      assign pst_pm_contact = '/pages/contact'
    endif
  endif

  assign pst_pm_discover = section.settings.discover_url
  if pst_pm_discover == blank
    assign pst_pm_discover = '/collections/perfect-systems'
  endif

  assign pst_pm_about = section.settings.about_url
  if pst_pm_about == blank
    if pages.about != empty
      assign pst_pm_about = pages.about.url
    else
      assign pst_pm_about = '/pages/about'
    endif
  endif

  assign pst_pm_s1 = section.settings.supply1_url
  if pst_pm_s1 == blank
    assign pst_pm_s1 = '/collections/poster-printer-paper'
  endif
  assign pst_pm_s2 = section.settings.supply2_url
  if pst_pm_s2 == blank
    assign pst_pm_s2 = '/collections/poster-printer-ink-cartridges-all'
  endif
  assign pst_pm_s3 = section.settings.supply3_url
  if pst_pm_s3 == blank
    assign pst_pm_s3 = '/collections/maintenance-products-all'
  endif
  assign pst_pm_s4 = section.settings.supply4_url
  if pst_pm_s4 == blank
    assign pst_pm_s4 = '/collections/laminators-lamination'
  endif

  assign pst_pm_phone_tel = section.settings.bottom_phone_tel
  if pst_pm_phone_tel == blank
    assign pst_pm_phone_tel = '+18885354431'
  endif
-%}

<div class="pst-pm">
  <header class="pst-pm__hero">
    <span class="pst-pm__badge">{{ section.settings.hero_badge | escape }}</span>
    <h1 class="pst-pm__hero-title">{{ section.settings.hero_title | escape }}</h1>
    <p class="pst-pm__hero-sub">{{ section.settings.hero_subtitle | escape }}</p>
    <div class="pst-pm__hero-actions">
      <a class="pst-pm__btn pst-pm__btn--magenta" href="{{ pst_pm_contact }}">{{ section.settings.hero_btn_quote | escape }}</a>
      <a class="pst-pm__btn pst-pm__btn--outline-light" href="{{ pst_pm_discover }}">{{ section.settings.hero_btn_discover | escape }}</a>
    </div>
  </header>

  <div class="pst-pm__trust" role="region" aria-label="{{ section.settings.trust_aria | escape }}">
    <div class="pst-pm__trust-inner">
      <div class="pst-pm__trust-grid">
        <div class="pst-pm__trust-item">{{ section.settings.trust_1 | escape }}</div>
        <div class="pst-pm__trust-item">{{ section.settings.trust_2 | escape }}</div>
        <div class="pst-pm__trust-item">{{ section.settings.trust_3 | escape }}</div>
        <div class="pst-pm__trust-item">{{ section.settings.trust_4 | escape }}</div>
      </div>
    </div>
  </div>

  <section class="pst-pm__features" aria-labelledby="pst-pm-features-heading">
    <div class="pst-pm__features-inner">
      <p class="pst-pm__eyebrow">{{ section.settings.features_label | escape }}</p>
      <h2 id="pst-pm-features-heading" class="pst-pm__h2">{{ section.settings.features_heading | escape }}</h2>
      <p class="pst-pm__intro">{{ section.settings.features_intro | escape }}</p>
      <div class="pst-pm__feature-grid">
        <article class="pst-pm__feature-card">
          <div class="pst-pm__feature-icon" aria-hidden="true">{{ section.settings.f1_icon | escape }}</div>
          <h3>{{ section.settings.f1_title | escape }}</h3>
          <p>{{ section.settings.f1_text | escape }}</p>
        </article>
        <article class="pst-pm__feature-card">
          <div class="pst-pm__feature-icon" aria-hidden="true">{{ section.settings.f2_icon | escape }}</div>
          <h3>{{ section.settings.f2_title | escape }}</h3>
          <p>{{ section.settings.f2_text | escape }}</p>
        </article>
        <article class="pst-pm__feature-card">
          <div class="pst-pm__feature-icon" aria-hidden="true">{{ section.settings.f3_icon | escape }}</div>
          <h3>{{ section.settings.f3_title | escape }}</h3>
          <p>{{ section.settings.f3_text | escape }}</p>
        </article>
        <article class="pst-pm__feature-card">
          <div class="pst-pm__feature-icon" aria-hidden="true">{{ section.settings.f4_icon | escape }}</div>
          <h3>{{ section.settings.f4_title | escape }}</h3>
          <p>{{ section.settings.f4_text | escape }}</p>
        </article>
      </div>
    </div>
  </section>

  <section class="pst-pm__mid-cta" aria-labelledby="pst-pm-mid-heading">
    <div class="pst-pm__mid-cta-inner">
      <h2 id="pst-pm-mid-heading" class="pst-pm__h2">{{ section.settings.mid_heading | escape }}</h2>
      <p class="pst-pm__mid-sub">{{ section.settings.mid_subtitle | escape }}</p>
      <div class="pst-pm__hero-actions">
        <a class="pst-pm__btn pst-pm__btn--magenta" href="{{ pst_pm_contact }}">{{ section.settings.mid_btn_quote | escape }}</a>
        <a class="pst-pm__btn pst-pm__btn--outline-gold" href="{{ pst_pm_discover }}">{{ section.settings.mid_btn_discover | escape }}</a>
      </div>
    </div>
  </section>

  <section class="pst-pm__supplies" aria-labelledby="pst-pm-supply-heading">
    <div class="pst-pm__supplies-inner">
      <p class="pst-pm__eyebrow">{{ section.settings.supply_label | escape }}</p>
      <h2 id="pst-pm-supply-heading" class="pst-pm__h2">{{ section.settings.supply_heading | escape }}</h2>
      <div class="pst-pm__supply-grid">
        <a class="pst-pm__supply-card" href="{{ pst_pm_s1 }}">
          <div class="pst-pm__supply-icon" aria-hidden="true">{{ section.settings.supply1_icon | escape }}</div>
          <h3>{{ section.settings.supply1_title | escape }}</h3>
          <span class="pst-pm__supply-link">{{ section.settings.supply_link_text | escape }}</span>
        </a>
        <a class="pst-pm__supply-card" href="{{ pst_pm_s2 }}">
          <div class="pst-pm__supply-icon" aria-hidden="true">{{ section.settings.supply2_icon | escape }}</div>
          <h3>{{ section.settings.supply2_title | escape }}</h3>
          <span class="pst-pm__supply-link">{{ section.settings.supply_link_text | escape }}</span>
        </a>
        <a class="pst-pm__supply-card" href="{{ pst_pm_s3 }}">
          <div class="pst-pm__supply-icon" aria-hidden="true">{{ section.settings.supply3_icon | escape }}</div>
          <h3>{{ section.settings.supply3_title | escape }}</h3>
          <span class="pst-pm__supply-link">{{ section.settings.supply_link_text | escape }}</span>
        </a>
        <a class="pst-pm__supply-card" href="{{ pst_pm_s4 }}">
          <div class="pst-pm__supply-icon" aria-hidden="true">{{ section.settings.supply4_icon | escape }}</div>
          <h3>{{ section.settings.supply4_title | escape }}</h3>
