{%- liquid
  assign pst_faq_ns = 'faq-' | append: section.id
-%}

<div id="pst-faq-root-{{ section.id }}" class="pst-faq-page">
  {%- comment -%} Section 1 — Hero {%- endcomment -%}
  <div class="pst-faq-page__hero" style="padding-top: {{ section.settings.hero_padding_top }}px; padding-bottom: {{ section.settings.hero_padding_bottom }}px;">
    <div class="pst-faq-page__hero-inner page-width">
      <h1 class="pst-faq-page__title">{{ section.settings.hero_heading | escape }}</h1>
      {% if section.settings.hero_subtext != blank %}
        <p class="pst-faq-page__intro">{{ section.settings.hero_subtext | escape }}</p>
      {% endif %}
    </div>
  </div>

  {%- comment -%} Section 2 — Category filters {%- endcomment -%}
  <div class="pst-faq-page__filters-wrap" data-faq-filters>
    <div class="page-width">
      <div
        class="pst-faq-page__filters"
        role="tablist"
        aria-label="FAQ categories"
      >
        <button
          type="button"
          class="pst-faq-page__filter is-active"
          role="tab"
          aria-selected="true"
          data-faq-filter="all"
        >
          {{ section.settings.tab_label_1 | escape }}
        </button>
        <button
          type="button"
          class="pst-faq-page__filter"
          role="tab"
          aria-selected="false"
          data-faq-filter="ordering"
        >
          {{ section.settings.tab_label_2 | escape }}
        </button>
        <button
          type="button"
          class="pst-faq-page__filter"
          role="tab"
          aria-selected="false"
          data-faq-filter="products"
        >
          {{ section.settings.tab_label_3 | escape }}
        </button>
        <button
          type="button"
          class="pst-faq-page__filter"
          role="tab"
          aria-selected="false"
          data-faq-filter="support"
        >
          {{ section.settings.tab_label_4 | escape }}
        </button>
        <button
          type="button"
          class="pst-faq-page__filter"
          role="tab"
          aria-selected="false"
          data-faq-filter="funding"
        >
          {{ section.settings.tab_label_5 | escape }}
        </button>
      </div>
    </div>
  </div>

  {%- comment -%} Section 3 — Accordion {%- endcomment -%}
  <div class="pst-faq-page__accordion-wrap">
    <div class="page-width">
      <div class="pst-faq-page__accordion" data-faq-accordion>
        <article class="pst-faq-page__item" data-category="ordering">
          <h2 class="visually-hidden">{{ section.settings.tab_label_2 | escape }}</h2>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a1" id="{{ pst_faq_ns }}-q1">
              <span class="pst-faq-page__question-text">Do you accept school purchase orders?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a1" role="region" aria-labelledby="{{ pst_faq_ns }}-q1">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Yes — we gladly accept official school and district purchase orders. Simply email your PO to
                  <a href="mailto:orders@perfectschooltools.com">orders@perfectschooltools.com</a>
                  and we will process your order promptly. We work with schools and districts nationwide and fully understand the procurement process.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a2" id="{{ pst_faq_ns }}-q2">
              <span class="pst-faq-page__question-text">What payment methods do you accept?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a2" role="region" aria-labelledby="{{ pst_faq_ns }}-q2">
              <div class="pst-faq-page__answer-inner">
                <p>
                  We accept Visa, Mastercard, Discover, PayPal, and school or district purchase orders. For large district orders, we also offer net-30 payment terms upon approval.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a3" id="{{ pst_faq_ns }}-q3">
              <span class="pst-faq-page__question-text">Do you offer district-wide pricing?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a3" role="region" aria-labelledby="{{ pst_faq_ns }}-q3">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Yes. We offer special pricing for districts purchasing multiple systems or placing large supply orders. Contact us at
                  <a href="mailto:orders@perfectschooltools.com">orders@perfectschooltools.com</a> or call <a href="tel:+18885354431">(888) 535-4431</a> to request a district pricing quote.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a4" id="{{ pst_faq_ns }}-q4">
              <span class="pst-faq-page__question-text">Can I get a formal quote for my school's procurement process?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a4" role="region" aria-labelledby="{{ pst_faq_ns }}-q4">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Absolutely. We provide formal written quotes suitable for your school's purchasing or bid process. Request a quote online, by email, or by phone and we will respond within one business day.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a5" id="{{ pst_faq_ns }}-q5">
              <span class="pst-faq-page__question-text">What are your shipping costs and delivery times?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a5" role="region" aria-labelledby="{{ pst_faq_ns }}-q5">
              <div class="pst-faq-page__answer-inner">
                <p>
                  We offer fast shipping on all orders. Most orders ship within 1–2 business days and arrive within 5–7 business days. Contact us for expedited shipping options if needed.
                </p>
              </div>
            </div>
          </div>
        </article>

        <article class="pst-faq-page__item" data-category="products">
          <h2 class="visually-hidden">{{ section.settings.tab_label_3 | escape }}</h2>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a6" id="{{ pst_faq_ns }}-q6">
              <span class="pst-faq-page__question-text">What is the difference between the Poster Maker and Awards Maker?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a6" role="region" aria-labelledby="{{ pst_faq_ns }}-q6">
              <div class="pst-faq-page__answer-inner">
                <p>
                  The Perfect Poster Maker System prints large-format 24&quot; wide full-color posters — ideal for hallway displays, classroom visuals, and school signage. The Perfect Awards Maker is optimized for printing certificates and recognition materials in standard document sizes. The Perfect Awards &amp; Cut System combines both capabilities with an added cutting feature for custom shapes.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a7" id="{{ pst_faq_ns }}-q7">
              <span class="pst-faq-page__question-text">How much does it cost per poster to print?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a7" role="region" aria-labelledby="{{ pst_faq_ns }}-q7">
              <div class="pst-faq-page__answer-inner">
                <p>
                  With our system, you can print full-color 24&quot; posters for approximately $1.50–$3.00 per poster — a fraction of the cost of outsourcing to a print shop.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a8" id="{{ pst_faq_ns }}-q8">
              <span class="pst-faq-page__question-text">How many posters can I print with one set of ink?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a8" role="region" aria-labelledby="{{ pst_faq_ns }}-q8">
              <div class="pst-faq-page__answer-inner">
                <p>
                  One full set of ink cartridges yields approximately 225–275 posters depending on image coverage and poster size. Replacement ink is available directly from us.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a9" id="{{ pst_faq_ns }}-q9">
              <span class="pst-faq-page__question-text">Is the system easy to use? Do I need technical experience?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a9" role="region" aria-labelledby="{{ pst_faq_ns }}-q9">
              <div class="pst-faq-page__answer-inner">
                <p>
                  No technical experience is needed. The system is designed specifically for school staff. Setup takes less than an hour, and we provide full onboarding support, instructional guides, and unlimited phone and email support.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a10" id="{{ pst_faq_ns }}-q10">
              <span class="pst-faq-page__question-text">What size posters can I print?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a10" role="region" aria-labelledby="{{ pst_faq_ns }}-q10">
              <div class="pst-faq-page__answer-inner">
                <p>
                  The Poster Maker System prints up to 24&quot; wide at any length. Common sizes include 24&quot;×36&quot;, 24&quot;×48&quot;, and custom banner lengths.
                </p>
              </div>
            </div>
          </div>
        </article>

        <article class="pst-faq-page__item" data-category="support">
          <h2 class="visually-hidden">{{ section.settings.tab_label_4 | escape }}</h2>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a11" id="{{ pst_faq_ns }}-q11">
              <span class="pst-faq-page__question-text">What warranty comes with the systems?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a11" role="region" aria-labelledby="{{ pst_faq_ns }}-q11">
              <div class="pst-faq-page__answer-inner">
                <p>
                  All systems include a one-year manufacturer's warranty covering parts and labor. Extended warranty options are available — ask us when requesting a quote.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a12" id="{{ pst_faq_ns }}-q12">
              <span class="pst-faq-page__question-text">What kind of support do you offer?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a12" role="region" aria-labelledby="{{ pst_faq_ns }}-q12">
              <div class="pst-faq-page__answer-inner">
                <p>
                  We offer unlimited phone and email support for all customers at no additional cost. Call <a href="tel:+18885354431">(888) 535-4431</a> or email
                  <a href="mailto:orders@perfectschooltools.com">orders@perfectschooltools.com</a> during business hours.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a13" id="{{ pst_faq_ns }}-q13">
              <span class="pst-faq-page__question-text">Do you offer training for our staff?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a13" role="region" aria-labelledby="{{ pst_faq_ns }}-q13">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Yes. Every purchase includes remote onboarding support. We walk your staff through setup, first print, and template use step by step to ensure a smooth start.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a14" id="{{ pst_faq_ns }}-q14">
              <span class="pst-faq-page__question-text">What if my system needs repair?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a14" role="region" aria-labelledby="{{ pst_faq_ns }}-q14">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Contact our support team first — most issues are resolved remotely. If a hardware repair is needed, we coordinate a service solution with minimal downtime for your school.
                </p>
              </div>
            </div>
          </div>
        </article>

        <article class="pst-faq-page__item" data-category="funding">
          <h2 class="visually-hidden">{{ section.settings.tab_label_5 | escape }}</h2>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a15" id="{{ pst_faq_ns }}-q15">
              <span class="pst-faq-page__question-text">What funding sources can be used to purchase your systems?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a15" role="region" aria-labelledby="{{ pst_faq_ns }}-q15">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Our systems are eligible for Title I funds, ESSER funds, media center budgets, instructional supply budgets, and school improvement grants. We can provide documentation to support your funding request.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a16" id="{{ pst_faq_ns }}-q16">
              <span class="pst-faq-page__question-text">Can you help with grant documentation?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a16" role="region" aria-labelledby="{{ pst_faq_ns }}-q16">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Yes. We provide product specifications, pricing letters, and supporting documentation to help with grant applications or your school's internal budget justification process.
                </p>
              </div>
            </div>
          </div>
          <div class="pst-faq-page__card">
            <button type="button" class="pst-faq-page__question" aria-expanded="false" aria-controls="{{ pst_faq_ns }}-a17" id="{{ pst_faq_ns }}-q17">
              <span class="pst-faq-page__question-text">What is the ROI of a poster maker system?</span>
              <span class="pst-faq-page__question-icon" aria-hidden="true"><span class="svg-wrapper">{{ 'icon-caret.svg' | inline_asset_content }}</span></span>
            </button>
            <div class="pst-faq-page__answer" id="{{ pst_faq_ns }}-a17" role="region" aria-labelledby="{{ pst_faq_ns }}-q17">
              <div class="pst-faq-page__answer-inner">
                <p>
                  Most schools recover the full system cost within the first year by eliminating outsourced printing costs. At $1.50–$3.00 per poster in-house versus $15–$30 at a print shop, a school printing just 10 posters per month saves $1,500–$3,000 annually.
                </p>
              </div>
            </div>
          </div>
        </article>
      </div>
    </div>
  </div>

  {%- comment -%} Section 4 — CTA {%- endcomment -%}
  <div class="pst-faq-page__cta">
    <div class="page-width pst-faq-page__cta-inner">
      <h2 class="pst-faq-page__cta-title">{{ section.settings.cta_heading | escape }}</h2>
      {% if section.settings.cta_text != blank %}
        <p class="pst-faq-page__cta-text">{{ section.settings.cta_text | escape }}</p>
      {% endif %}
      {%- liquid
        assign pst_faq_quote_url = section.settings.cta_quote_url
        if pst_faq_quote_url == blank
          assign pst_faq_quote_url = '/pages/contact'
        endif
        assign pst_faq_phone_url = section.settings.cta_phone_url
        if pst_faq_phone_url == blank
          assign pst_faq_phone_url = 'tel:8885354431'
        endif
      -%}
      <div class="pst-faq-page__cta-buttons">
        <a class="pst-faq-page__btn pst-faq-page__btn--primary" href="{{ pst_faq_quote_url }}">
          {{- section.settings.cta_quote_label | escape -}}
        </a>
        <a class="pst-faq-page__btn pst-faq-page__btn--outline" href="{{ pst_faq_phone_url }}">
          {{- section.settings.cta_phone_label | escape -}}
        </a>
      </div>
    </div>
  </div>
</div>

{%- style -%}
  #shopify-section-{{ section.id }} .pst-faq-page {
    --pst-faq-navy: #0a2540;
    --pst-faq-magenta: #e91e8c;
    --pst-faq-gold: #f5b731;
    --pst-faq-warm: #fdf8f0;
    --pst-faq-slate: #334155;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__hero {
    background: var(--pst-faq-navy);
    padding-left: 1.5rem;
    padding-right: 1.5rem;
    text-align: center;
    border-bottom: 3px solid var(--pst-faq-gold);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__hero-inner {
    max-width: 56rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__title {
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(2.2rem, 5vw, 3.25rem);
    line-height: 1.15;
    color: #fff;
    margin: 0 0 1rem;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__intro {
    font-family: var(--font-body-family);
    font-size: clamp(1.05rem, 2vw, 1.25rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, 0.92);
    margin: 0 auto;
    max-width: 40rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__filters-wrap {
    background: #fff;
    padding: 2rem 1.5rem 1.5rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__filters {
    display: flex;
    flex-wrap: nowrap;
    overflow-x: auto;
    -webkit-overflow-scrolling: touch;
    gap: 8px;
    white-space: nowrap;
    max-width: 56rem;
    margin: 0 auto;
    padding-bottom: 4px;
    scrollbar-width: none;
  }
  #shopify-section-{{ section.id }} .pst-faq-page__filters::-webkit-scrollbar {
    display: none;
  }
  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-faq-page__filters {
      overflow-x: auto;
      -webkit-overflow-scrolling: touch;
      justify-content: flex-start;
    }
  }

  #shopify-section-{{ section.id }} .pst-faq-page__filter {
    font-family: var(--font-body-family);
    font-weight: 600;
    font-size: 0.95rem;
    padding: 0.65rem 1.15rem;
    border-radius: 999px;
    border: 2px solid var(--pst-faq-navy);
    background: #fff;
    color: var(--pst-faq-navy);
    cursor: pointer;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__filter:hover {
    background: var(--pst-faq-navy);
    color: #fff;
    border-color: var(--pst-faq-navy);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__filter.is-active {
    background: var(--pst-faq-magenta);
    color: #fff;
    border-color: var(--pst-faq-magenta);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__filter.is-active:hover {
    background: #c91778;
    border-color: #c91778;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__accordion-wrap {
    background: var(--pst-faq-warm);
    padding: 2rem 1.5rem 3.5rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__accordion {
    max-width: 48rem;
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__item {
    display: contents;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__item.is-hidden {
    display: none !important;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__card {
    background: #fff;
    border: 1px solid rgba(10, 37, 64, 0.12);
    border-radius: 0.5rem;
    box-shadow: 0 2px 12px rgba(10, 37, 64, 0.06);
    overflow: hidden;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__question {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    width: 100%;
    text-align: left;
    padding: 1.25rem;
    margin: 0;
    font-family: var(--font-body-family);
    font-weight: 700;
    color: var(--pst-faq-navy);
    background: transparent;
    border: none;
    cursor: pointer;
    transition: color 0.2s ease;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-faq-page__question {
      padding: 1.25rem 1.25rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-faq-page__question:hover,
  #shopify-section-{{ section.id }} .pst-faq-page__question:focus-visible {
    color: var(--pst-faq-magenta);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__question.is-open {
    color: var(--pst-faq-magenta);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__question-text {
    flex: 1;
    line-height: 1.35;
    font-size: {{ section.settings.question_font_size }}px;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__question-icon {
    flex-shrink: 0;
    display: flex;
    align-items: center;
    justify-content: center;
    width: 2rem;
    height: 2rem;
    transition: transform 0.3s ease;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__question-icon svg {
    width: 1rem;
    height: 1rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__question.is-open .pst-faq-page__question-icon {
    transform: rotate(180deg);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__answer {
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__answer.is-open {
    max-height: 60rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__answer-inner {
    padding: 0 1.25rem 1.25rem;
    font-family: var(--font-body-family);
    font-size: {{ section.settings.answer_font_size }}px;
    line-height: 1.6;
    color: var(--pst-faq-slate);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__answer-inner p {
    margin: 0;
    font-size: inherit;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__answer-inner a {
    color: var(--pst-faq-magenta);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__answer-inner a:hover {
    color: var(--pst-faq-navy);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__cta {
    background: var(--pst-faq-navy);
    padding: clamp(3rem, 7vw, 4.5rem) 1.5rem;
    text-align: center;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__cta-inner {
    max-width: 40rem;
    margin: 0 auto;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__cta-title {
    font-family: Outfit, system-ui, sans-serif;
    font-weight: 700;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    color: #fff;
    margin: 0 0 0.75rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__cta-text {
    font-family: var(--font-body-family);
    font-size: 1.1rem;
    color: rgba(255, 255, 255, 0.9);
    margin: 0 0 1.75rem;
    line-height: 1.5;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__cta-buttons {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.75rem;
    font-family: var(--font-body-family);
    font-weight: 700;
    font-size: 1rem;
    text-decoration: none;
    border-radius: 0.4rem;
    transition:
      background 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease,
      transform 0.15s ease;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__btn--primary {
    background: var(--pst-faq-magenta);
    color: #fff;
    border: 2px solid var(--pst-faq-magenta);
  }

  #shopify-section-{{ section.id }} .pst-faq-page__btn--primary:hover {
    filter: brightness(1.06);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__btn--outline {
    background: transparent;
    color: #fff;
    border: 2px solid #fff;
  }

  #shopify-section-{{ section.id }} .pst-faq-page__btn--outline:hover {
    background: #fff;
    color: var(--pst-faq-navy);
  }
{%- endstyle -%}

<script>
  (function () {
    var root = document.getElementById('pst-faq-root-{{ section.id }}');
    if (!root) return;

    var accordion = root.querySelector('[data-faq-accordion]');
    var filtersWrap = root.querySelector('[data-faq-filters]');
    if (!accordion || !filtersWrap) return;

    var filterButtons = filtersWrap.querySelectorAll('[data-faq-filter]');
    var categoryArticles = accordion.querySelectorAll('.pst-faq-page__item[data-category]');

    function setActiveFilter(activeBtn) {
      filterButtons.forEach(function (btn) {
        var on = btn === activeBtn;
        btn.classList.toggle('is-active', on);
        btn.setAttribute('aria-selected', on ? 'true' : 'false');
      });
    }

    function applyCategory(filter) {
      categoryArticles.forEach(function (article) {
        var cat = article.getAttribute('data-category');
        var show = filter === 'all' || cat === filter;
        article.classList.toggle('is-hidden', !show);
        if (!show) {
          article.querySelectorAll('.pst-faq-page__question.is-open').forEach(function (q) {
            q.classList.remove('is-open');
            q.setAttribute('aria-expanded', 'false');
            var ans = q.nextElementSibling;
            if (ans && ans.classList.contains('pst-faq-page__answer')) {
              ans.classList.remove('is-open');
            }
          });
        }
      });
    }

    filterButtons.forEach(function (btn) {
      btn.addEventListener('click', function () {
        var filter = btn.getAttribute('data-faq-filter') || 'all';
        setActiveFilter(btn);
        applyCategory(filter);
      });
    });

    function closeAllQuestions() {
      accordion.querySelectorAll('.pst-faq-page__question.is-open').forEach(function (openQ) {
        openQ.classList.remove('is-open');
        openQ.setAttribute('aria-expanded', 'false');
        var ans = openQ.nextElementSibling;
        if (ans && ans.classList.contains('pst-faq-page__answer')) {
          ans.classList.remove('is-open');
        }
      });
    }

    accordion.querySelectorAll('.pst-faq-page__question').forEach(function (btn) {
      btn.addEventListener('click', function () {
        var opening = !btn.classList.contains('is-open');
        var answer = btn.nextElementSibling;

        closeAllQuestions();

        if (opening && answer && answer.classList.contains('pst-faq-page__answer')) {
          btn.classList.add('is-open');
          btn.setAttribute('aria-expanded', 'true');
          answer.classList.add('is-open');
        }
      });
    });
  })();
</script>

