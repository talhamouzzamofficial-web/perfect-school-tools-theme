<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link
  href="https://fonts.googleapis.com/css2?family=Nunito+Sans:ital,opsz,wght@0,6..12,400;0,6..12,600;0,6..12,700;1,6..12,400&family=Outfit:wght@600;700;800&display=swap"
  rel="stylesheet"
>

{%- liquid
  assign overlay_opacity = section.settings.hero_bg_overlay | default: 60 | times: 1.0 | divided_by: 100.0
  case section.settings.hero_overlay_color
    when 'black'
      assign overlay_hex = '#000000'
    when 'none'
      assign overlay_hex = 'transparent'
    else
      assign overlay_hex = '#0A2540'
  endcase
-%}

{%- style -%}
  #shopify-section-{{ section.id }} .pst-hero {
    background: #0a2540;
    position: relative;
    overflow: hidden;
    padding: 80px 20px;
    min-height: 520px;
    color: #fff;
  }

  {%- if section.settings.hero_bg_image != blank -%}
    #shopify-section-{{ section.id }} .pst-hero {
      background-image: url('{{ section.settings.hero_bg_image | image_url: width: 1920 }}');
      background-size: cover;
      background-position: center;
      background-repeat: no-repeat;
    }
  {%- endif -%}

  #shopify-section-{{ section.id }} .pst-hero__overlay {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
    {%- if section.settings.hero_bg_image != blank and section.settings.hero_overlay_color != 'none' -%}
      display: block;
      background-color: {{ overlay_hex }};
      opacity: {{ overlay_opacity }};
    {%- else -%}
      display: none;
    {%- endif -%}
  }

  #shopify-section-{{ section.id }} .pst-hero__inner {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: 55fr 45fr;
    gap: 60px;
    align-items: center;
    position: relative;
    z-index: 2;
  }

  #shopify-section-{{ section.id }} .pst-hero__inner--single {
    grid-template-columns: 1fr;
  }

  #shopify-section-{{ section.id }} .pst-hero__content {
    text-align: left;
  }

  #shopify-section-{{ section.id }} .pst-hero__badge {
    display: inline-block;
    margin-bottom: 1.5rem;
    padding: 0.65rem 1.5rem;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 600;
    color: var(--pst-color-primary-dark-navy, #0a2540);
    background-color: #fff;
    border: 2px solid rgba(255, 255, 255, 0.95);
    border-radius: 999px;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.15);
  }

  #shopify-section-{{ section.id }} .pst-hero__heading {
    margin: 0 0 1.25rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.25rem, 4.2vw, 3.5rem);
    font-weight: 800;
    line-height: 1.12;
    letter-spacing: -0.02em;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-hero__text {
    max-width: 36rem;
    margin: 0 0 1.75rem;
    font-family: var(--font-body-family);
    font-size: 1.125rem;
    line-height: 1.6;
    font-weight: 400;
    color: rgba(255, 255, 255, 0.88);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-hero__text {
      font-size: 1.2rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem 1.25rem;
    margin-bottom: 2rem;
  }

  #shopify-section-{{ section.id }} .pst-hero__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 3.25rem;
    padding: 0 1.75rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 600;
    text-decoration: none;
    border-radius: 0.5rem;
    transition: filter 0.2s ease, background-color 0.2s ease, color 0.2s ease;
    border: 2px solid transparent;
  }

  #shopify-section-{{ section.id }} .pst-hero__btn--primary {
    background-color: var(--pst-color-magenta, #e91e8c);
    color: #fff;
    border: 2px solid var(--pst-color-magenta, #e91e8c);
    box-shadow: 0 4px 14px rgba(233, 30, 140, 0.35);
  }

  #shopify-section-{{ section.id }} .pst-hero__btn--primary:hover,
  #shopify-section-{{ section.id }} .pst-hero__btn--primary:focus {
    filter: brightness(1.06);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-hero__btn--outline {
    background-color: transparent;
    color: #fff;
    border: 2px solid #fff;
  }

  #shopify-section-{{ section.id }} .pst-hero__btn--outline:hover,
  #shopify-section-{{ section.id }} .pst-hero__btn--outline:focus {
    background-color: rgba(255, 255, 255, 0.12);
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-hero__footnote {
    display: flex;
    flex-direction: row;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem 1.25rem;
    font-family: var(--font-body-family);
    font-size: 1rem;
    font-weight: 600;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-hero__footnote-sep {
    display: block;
    width: 1px;
    height: 1.1rem;
    background: rgba(255, 255, 255, 0.35);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pst-hero__phone {
    color: var(--pst-color-gold, #f5b731);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pst-hero__phone:hover,
  #shopify-section-{{ section.id }} .pst-hero__phone:focus {
    text-decoration: underline;
  }

  #shopify-section-{{ section.id }} .pst-hero__media {
    position: relative;
  }

  #shopify-section-{{ section.id }} .pst-hero__product-img {
    width: 100%;
    height: auto;
    border-radius: 16px;
    display: block;
    object-fit: cover;
    max-height: 420px;
    box-shadow: 0 20px 60px rgba(0, 0, 0, 0.3);
  }

  #shopify-section-{{ section.id }} .pst-hero__float-badge {
    position: absolute;
    bottom: -16px;
    left: 20px;
    background: #ffffff;
    border-radius: 12px;
    padding: 12px 16px;
    display: flex;
    align-items: center;
    gap: 12px;
    box-shadow: 0 8px 24px rgba(0, 0, 0, 0.15);
    min-width: 200px;
  }

  #shopify-section-{{ section.id }} .pst-hero__float-icon {
    width: 36px;
    height: 36px;
    background: #fdf8f0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 18px;
    flex-shrink: 0;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .pst-hero__float-label {
    font-family: 'Outfit', sans-serif;
    font-size: 14px;
    font-weight: 700;
    color: #0a2540;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pst-hero__float-sublabel {
    font-family: 'Nunito Sans', sans-serif;
    font-size: 12px;
    color: #334155;
    margin-top: 2px;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-hero {
      padding: 48px 16px 56px;
      min-height: 0;
    }

    #shopify-section-{{ section.id }} .pst-hero__inner {
      grid-template-columns: 1fr;
      gap: 40px;
      text-align: center;
    }

    #shopify-section-{{ section.id }} .pst-hero__content {
      text-align: center;
    }

    #shopify-section-{{ section.id }} .pst-hero__text {
      margin-left: auto;
      margin-right: auto;
    }

    #shopify-section-{{ section.id }} .pst-hero__actions {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .pst-hero__footnote {
      justify-content: center;
    }

    #shopify-section-{{ section.id }} .pst-hero__media {
      display: none;
    }
  }
{%- endstyle -%}

<section class="pst-hero">
  <div class="pst-hero__overlay" aria-hidden="true"></div>
  <div
    class="pst-hero__inner{% if section.settings.hero_product_image == blank %} pst-hero__inner--single{% endif %}"
  >
    <div class="pst-hero__content">
      {%- if section.settings.badge_text != blank -%}
        <p class="pst-hero__badge">{{ section.settings.badge_text | escape }}</p>
      {%- endif -%}

      {%- if section.settings.heading != blank -%}
        <h1 class="pst-hero__heading">{{ section.settings.heading | escape }}</h1>
      {%- endif -%}

      {%- if section.settings.subtext != blank -%}
        <p class="pst-hero__text">{{ section.settings.subtext | escape }}</p>
      {%- endif -%}

      <div class="pst-hero__actions">
        {%- if section.settings.quote_label != blank and section.settings.quote_link != blank -%}
          <a class="pst-hero__btn pst-hero__btn--primary" href="{{ section.settings.quote_link }}">
            {{- section.settings.quote_label | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.products_label != blank and section.settings.products_link != blank -%}
          <a class="pst-hero__btn pst-hero__btn--outline" href="{{ section.settings.products_link }}">
            {{- section.settings.products_label | escape -}}
          </a>
        {%- endif -%}
      </div>

      <div class="pst-hero__footnote">
        {%- if section.settings.phone != blank -%}
          <a
            class="pst-hero__phone"
            href="tel:{{ section.settings.phone | replace: ' ', '' | replace: '(', '' | replace: ')', '' | replace: '-', '' }}"
          >
            {{- section.settings.phone | escape -}}
          </a>
        {%- endif -%}
        {%- if section.settings.phone != blank and section.settings.shipping_note != blank -%}
          <span class="pst-hero__footnote-sep" aria-hidden="true"></span>
        {%- endif -%}
        {%- if section.settings.shipping_note != blank -%}
          <span>{{ section.settings.shipping_note | escape }}</span>
        {%- endif -%}
      </div>
    </div>

    {%- if section.settings.hero_product_image != blank -%}
      {%- assign hero_img_alt = section.settings.hero_product_image.alt | default: section.settings.heading -%}
      <div class="pst-hero__media">
        {{
          section.settings.hero_product_image
          | image_url: width: 900
          | image_tag: class: 'pst-hero__product-img', loading: 'lazy', alt: hero_img_alt
        }}
        <div class="pst-hero__float-badge">
          <div class="pst-hero__float-icon" aria-hidden="true">
            {%- case section.settings.hero_float_icon -%}
              {%- when 'dollar' -%}
                $
              {%- when 'star' -%}
                &#11088;
              {%- when 'check' -%}
                &#10003;
              {%- when 'shield' -%}
                &#128737;
              {%- when 'truck' -%}
                &#128666;
            {%- endcase -%}
          </div>
          <div>
            <div class="pst-hero__float-label">
              {{ section.settings.hero_float_label | escape }}
            </div>
            <div class="pst-hero__float-sublabel">
              {{ section.settings.hero_float_sublabel | escape }}
            </div>
          </div>
        </div>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "PST Hero",
  "tag": "section",
  "class": "pst-hero-section",
  "settings": [
    {
      "type": "image_picker",
      "id": "hero_bg_image",
      "label": "Hero Background Image",
      "info": "Displays behind the hero content. Recommended: wide landscape image, min 1440x600px."
    },
    {
      "type": "range",
      "id": "hero_bg_overlay",
      "label": "Background Image Overlay Opacity",
      "min": 0,
      "max": 100,
      "step": 5,
      "default": 60,
      "unit": "%",
      "info": "Higher = darker overlay over the image. 0 = no overlay."
    },
    {
      "type": "select",
      "id": "hero_overlay_color",
      "label": "Overlay Color",
      "options": [
        { "value": "navy", "label": "Navy (default)" },
        { "value": "black", "label": "Black" },
        { "value": "none", "label": "No overlay" }
      ],
      "default": "navy"
    },
    {
      "type": "image_picker",
      "id": "hero_product_image",
      "label": "Hero — Right Side Product Image",
      "info": "Large product or lifestyle image shown on the right side of the hero."
    },
    {
      "type": "text",
      "id": "hero_float_label",
      "label": "Floating Badge — Label",
      "default": "District Pricing"
    },
    {
      "type": "text",
      "id": "hero_float_sublabel",
      "label": "Floating Badge — Sub-label",
      "default": "Volume discounts available"
    },
    {
      "type": "select",
      "id": "hero_float_icon",
      "label": "Floating Badge — Icon",
      "options": [
        { "value": "dollar", "label": "Dollar $" },
        { "value": "star", "label": "Star" },
        { "value": "check", "label": "Checkmark" },
        { "value": "shield", "label": "Shield" },
        { "value": "truck", "label": "Truck" }
      ],
      "default": "dollar"
    },
    {
      "type": "text",
      "id": "badge_text",
      "label": "Badge text",
      "default": "We Accept School Purchase Orders"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Poster Makers & Visual Supplies for Schools"
    },
    {
      "type": "textarea",
      "id": "subtext",
      "label": "Paragraph",
      "default": "Empower your school with professional poster printing, awards systems, and visual learning tools. Trusted by over 5,000 schools and 1,500 districts nationwide."
    },
    {
      "type": "text",
      "id": "quote_label",
      "label": "Primary button label",
      "default": "Request a Quote"
    },
    {
      "type": "url",
      "id": "quote_link",
      "label": "Primary button link"
    },
    {
      "type": "text",
      "id": "products_label",
      "label": "Secondary button label",
      "default": "View Products"
    },
    {
      "type": "url",
      "id": "products_link",
      "label": "Secondary button link"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone",
      "default": "(888) 535-4431"
    },
    {
      "type": "text",
      "id": "shipping_note",
      "label": "Footer line",
      "default": "Fast Shipping Available"
    }
  ],
  "presets": [
    {
      "name": "PST Hero"
    }
  ]
}
{% endschema %}
