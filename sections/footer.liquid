{% comment %}theme-check-disable UndefinedObject{% endcomment %}
{{ 'component-newsletter.css' | asset_url | stylesheet_tag }}
{{ 'component-list-payment.css' | asset_url | stylesheet_tag }}

{%- style -%}
  #shopify-section-{{ section.id }} {
    --pst-navy: #0a2540;
    --pst-navy-mid: #0f4872;
    --pst-navy-dark: #061a2e;
    --pst-gold: #f5b731;
    --pst-magenta: #e91e8c;
  }

  #shopify-section-{{ section.id }} .pst-footer {
    margin-top: {{ section.settings.margin_top | times: 0.75 | round: 0 }}px;
    font-family: var(--font-body-family);
    color: rgba(255, 255, 255, 0.75);
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-footer {
      margin-top: {{ section.settings.margin_top }}px;
    }
  }

  #shopify-section-{{ section.id }} .pst-footer__top {
    background: var(--pst-navy);
    padding: 2rem 2rem 2.2rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__top-inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 2rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__logo-link {
    display: inline-block;
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pst-footer__logo-link img {
    max-width: 18rem;
    height: auto;
    display: block;
  }

  #shopify-section-{{ section.id }} .pst-footer__logo-text {
    font-family: var(--font-heading-family);
    font-size: 1.8rem;
    font-weight: 800;
    color: #fff;
    letter-spacing: -0.02em;
  }

  #shopify-section-{{ section.id }} .pst-footer__contact {
    display: flex;
    flex-direction: column;
    gap: 0.65rem;
    text-align: left;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-footer__contact {
      text-align: right;
      align-items: flex-end;
    }
  }

  #shopify-section-{{ section.id }} .pst-footer__contact a {
    font-size: 1.4rem;
    font-weight: 600;
    color: rgba(255, 255, 255, 0.9);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pst-footer__contact a:hover {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-footer__main {
    background: var(--pst-navy);
    padding: 0 2rem 3rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__links {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    display: grid;
    gap: 2.4rem 1.5rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 480px) {
    #shopify-section-{{ section.id }} .pst-footer__links {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-footer__links {
      grid-template-columns: repeat(3, 1fr);
    }
  }

  @media screen and (min-width: 1200px) {
    #shopify-section-{{ section.id }} .pst-footer__links {
      grid-template-columns: repeat(6, 1fr);
    }
  }

  #shopify-section-{{ section.id }} .pst-footer__col-heading {
    margin: 0 0 1.2rem;
    font-family: var(--font-heading-family);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.5px;
    text-transform: uppercase;
    color: var(--pst-gold);
  }

  #shopify-section-{{ section.id }} .pst-footer__list {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .pst-footer__list li {
    margin-bottom: 0.65rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__list a {
    font-size: 14px;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pst-footer__list a:hover {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-footer__trust {
    background: var(--pst-navy-mid);
    padding: 1.4rem 2rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__trust-inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    display: grid;
    gap: 1rem;
    grid-template-columns: 1fr;
  }

  @media screen and (min-width: 600px) {
    #shopify-section-{{ section.id }} .pst-footer__trust-inner {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pst-footer__trust-inner {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.5rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-footer__trust-item {
    display: flex;
    align-items: center;
    gap: 0.65rem;
    font-size: 1.35rem;
    font-weight: 600;
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-footer__trust-icon {
    color: var(--pst-gold);
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter {
    background: var(--pst-navy-dark);
    padding: 3rem 2rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter-inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    display: grid;
    gap: 2rem;
    align-items: center;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pst-footer__newsletter-inner {
      grid-template-columns: 1fr 1fr;
      gap: 3rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter-text h3 {
    margin: 0 0 0.75rem;
    font-family: var(--font-heading-family);
    font-size: clamp(1.8rem, 2.5vw, 2.2rem);
    font-weight: 800;
    color: #fff;
    line-height: 1.2;
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter-text p {
    margin: 0;
    font-size: 1.45rem;
    line-height: 1.5;
    color: rgba(255, 255, 255, 0.82);
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter .newsletter-form__field-wrapper {
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter .pst-footer__newsletter-field.field {
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem;
    align-items: stretch;
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter .pst-footer__newsletter-field .field__input {
    flex: 1 1 16rem;
    min-height: 4.8rem;
    padding: 0 1.2rem;
    border-radius: 0.5rem;
    border: 1px solid rgba(255, 255, 255, 0.2);
    background: rgba(255, 255, 255, 0.08);
    color: #fff;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter .field__input::placeholder {
    color: rgba(255, 255, 255, 0.5);
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter .field__label {
    color: rgba(255, 255, 255, 0.75);
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter .pst-footer__subscribe {
    min-height: 4.8rem;
    padding: 0 2rem;
    font-family: var(--font-body-family);
    font-size: 1.4rem;
    font-weight: 700;
    color: #fff;
    background: var(--pst-magenta);
    border: 2px solid var(--pst-magenta);
    border-radius: 0.5rem;
    cursor: pointer;
    transition: filter 0.2s ease;
    flex-shrink: 0;
  }

  #shopify-section-{{ section.id }} .pst-footer__newsletter .pst-footer__subscribe:hover {
    filter: brightness(1.06);
  }

  #shopify-section-{{ section.id }} .pst-footer__bottom {
    background: var(--pst-navy-dark);
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding: 1.8rem 2rem;
  }

  #shopify-section-{{ section.id }} .pst-footer__bottom-inner {
    max-width: var(--page-width, 140rem);
    margin: 0 auto;
    display: flex;
    flex-direction: column;
    gap: 1.4rem;
    align-items: center;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    #shopify-section-{{ section.id }} .pst-footer__bottom-inner {
      flex-direction: row;
      flex-wrap: wrap;
      justify-content: space-between;
      text-align: left;
      align-items: center;
    }
  }

  #shopify-section-{{ section.id }} .pst-footer__copyright {
    font-size: 1.35rem;
    color: rgba(255, 255, 255, 0.65);
    margin: 0;
  }

  #shopify-section-{{ section.id }} .pst-footer__policies {
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
    justify-content: center;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  #shopify-section-{{ section.id }} .pst-footer__policies a {
    font-size: 1.35rem;
    color: rgba(255, 255, 255, 0.75);
    text-decoration: none;
  }

  #shopify-section-{{ section.id }} .pst-footer__policies a:hover {
    color: #fff;
  }

  #shopify-section-{{ section.id }} .pst-footer__payment .list-payment {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    justify-content: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
    padding-top: {{ section.settings.padding_top | times: 0.75 | round: 0 }}px;
    padding-bottom: {{ section.settings.padding_bottom | times: 0.75 | round: 0 }}px;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .section-{{ section.id }}-padding {
      padding-top: {{ section.settings.padding_top }}px;
      padding-bottom: {{ section.settings.padding_bottom }}px;
    }
  }
{%- endstyle -%}

<footer class="footer color-{{ section.settings.color_scheme }} gradient section-{{ section.id }}-padding">
  <div class="pst-footer">
    <div class="pst-footer__top">
      <div class="pst-footer__top-inner">
        <div class="pst-footer__brand">
          <a href="{{ routes.root_url }}" class="pst-footer__logo-link">
            {%- if section.settings.logo != blank -%}
              {%- liquid
                assign pst_footer_logo_h = 180 | divided_by: section.settings.logo.aspect_ratio | round
              -%}
              {{
                section.settings.logo
                | image_url: width: 180
                | image_tag:
                  loading: 'lazy',
                  widths: '180, 360',
                  width: 180,
                  height: pst_footer_logo_h,
                  alt: 'Perfect School Tools',
                  class: 'pst-footer__logo-img'
              }}
            {%- else -%}
              <span class="pst-footer__logo-text">Perfect School Tools</span>
            {%- endif -%}
          </a>
        </div>
        <div class="pst-footer__contact">
          <a href="tel:+18885354431">(888) 535-4431</a>
          <a href="mailto:orders@perfectposter.com">orders@perfectposter.com</a>
        </div>
      </div>
    </div>

    <div class="pst-footer__main">
      <nav class="pst-footer__links" aria-label="Footer">
        <div class="pst-footer__col">
          <h2 class="pst-footer__col-heading">Products</h2>
          <ul class="pst-footer__list">
            <li><a href="/pages/poster-makers">Poster Makers</a></li>
            <li><a href="/pages/award-systems">Award Systems</a></li>
            <li><a href="/collections/laminators-lamination">Cold Laminators</a></li>
            <li><a href="/collections/poster-printer-supplies">Poster Printer Supplies</a></li>
            <li><a href="/collections/poster-printer-paper">Poster Printer Paper</a></li>
            <li><a href="/collections/poster-printer-ink-cartridges-all">Poster Printer Ink</a></li>
            <li><a href="/collections/perfect-supply-bundles">School Bundles</a></li>
            <li><a href="/collections/free-poster-template-downloads">Free Resources</a></li>
          </ul>
        </div>
        <div class="pst-footer__col">
          <h2 class="pst-footer__col-heading">Buying</h2>
          <ul class="pst-footer__list">
            <li><a href="/pages/how-to-buy">How to Buy</a></li>
            <li><a href="/pages/purchase-orders">Purchase Orders</a></li>
            <li><a href="/pages/district-pricing">District Pricing</a></li>
            <li><a href="/pages/reorder-supplies">Reorder Supplies</a></li>
          </ul>
        </div>
        <div class="pst-footer__col">
          <h2 class="pst-footer__col-heading">For Your Role</h2>
          <ul class="pst-footer__list">
            <li><a href="/pages/for-media-specialists">For Media Specialists</a></li>
            <li><a href="/pages/for-bookkeepers">For Bookkeepers</a></li>
            <li><a href="/pages/for-teachers">For Teachers</a></li>
          </ul>
        </div>
        <div class="pst-footer__col">
          <h2 class="pst-footer__col-heading">Resources</h2>
          <ul class="pst-footer__list">
            <li><a href="/blogs/news">Blog</a></li>
            <li><a href="/blogs/news/best-poster-makers-for-schools">Best Poster Makers</a></li>
            <li><a href="/blogs/news/best-cold-laminators-for-schools">Best Cold Laminators</a></li>
            <li><a href="/blogs/news/poster-printer-paper-guide">Paper Guide</a></li>
            <li><a href="/blogs/news/cold-vs-hot-laminator-schools">Cold vs Hot Laminator</a></li>
            <li><a href="/blogs/news/school-hallway-display-ideas">Hallway Display Ideas</a></li>
          </ul>
        </div>
        <div class="pst-footer__col">
          <h2 class="pst-footer__col-heading">Company</h2>
          <ul class="pst-footer__list">
            <li><a href="/pages/faq">FAQ</a></li>
            <li><a href="/pages/about">About Us</a></li>
            <li><a href="/pages/contact">Contact Us</a></li>
          </ul>
        </div>
        <div class="pst-footer__col">
          <h2 class="pst-footer__col-heading">Service Areas</h2>
          <ul class="pst-footer__list">
            <li><a href="/pages/poster-makers-virginia">Virginia</a></li>
            <li><a href="/pages/poster-makers-north-carolina">North Carolina</a></li>
            <li><a href="/pages/poster-makers-south-carolina">South Carolina</a></li>
            <li><a href="/pages/poster-makers-georgia">Georgia</a></li>
            <li><a href="/pages/poster-makers-florida">Florida</a></li>
          </ul>
        </div>
      </nav>
    </div>

    <div class="pst-footer__trust">
      <div class="pst-footer__trust-inner">
        <div class="pst-footer__trust-item">
          <span class="pst-footer__trust-icon" aria-hidden="true">✓</span>
          <span>Purchase Orders Accepted</span>
        </div>
        <div class="pst-footer__trust-item">
          <span class="pst-footer__trust-icon" aria-hidden="true">🚚</span>
          <span>Free Shipping</span>
        </div>
        <div class="pst-footer__trust-item">
          <span class="pst-footer__trust-icon" aria-hidden="true">📞</span>
          <span>Unlimited Support</span>
        </div>
        <div class="pst-footer__trust-item">
          <span class="pst-footer__trust-icon" aria-hidden="true">🏆</span>
          <span>30+ Years Serving Schools</span>
        </div>
      </div>
    </div>

    {%- if section.settings.newsletter_enable -%}
      <div class="pst-footer__newsletter">
        <div class="pst-footer__newsletter-inner">
          <div class="pst-footer__newsletter-text">
            <h3>Stay Connected with Perfect School Tools</h3>
            <p>Get tips, resources, and updates for school educators.</p>
          </div>
          <div class="pst-footer__newsletter-form-wrap">
            {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="newsletter-form__field-wrapper">
                <div class="field pst-footer__newsletter-field">
                  <input
                    id="NewsletterForm--{{ section.id }}"
                    type="email"
                    name="contact[email]"
                    class="field__input"
                    value="{{ form.email }}"
                    aria-required="true"
                    autocorrect="off"
                    autocapitalize="off"
                    autocomplete="email"
                    {% if form.errors %}
                      autofocus
                      aria-invalid="true"
                      aria-describedby="ContactFooter-error"
                    {% elsif form.posted_successfully? %}
                      aria-describedby="ContactFooter-success"
                    {% endif %}
                    placeholder="{{ 'newsletter.label' | t }}"
                    required
                  >
                  <label class="field__label visually-hidden" for="NewsletterForm--{{ section.id }}">
                    {{ 'newsletter.label' | t }}
                  </label>
                  <button type="submit" class="pst-footer__subscribe" name="commit" id="Subscribe-{{ section.id }}">
                    Subscribe
                  </button>
                </div>
                {%- if form.errors -%}
                  <small class="newsletter-form__message form__message" id="ContactFooter-error">
                    <span class="svg-wrapper">
                      {{- 'icon-error.svg' | inline_asset_content -}}
                    </span>
                    {{- form.errors.translated_fields.email | capitalize }}
                    {{ form.errors.messages.email -}}
                  </small>
                {%- endif -%}
              </div>
              {%- if form.posted_successfully? -%}
                <h3
                  class="newsletter-form__message newsletter-form__message--success form__message"
                  id="ContactFooter-success"
                  tabindex="-1"
                  autofocus
                >
                  <span class="svg-wrapper">
                    {{- 'icon-success.svg' | inline_asset_content -}}
                  </span>
                  {{- 'newsletter.success' | t }}
                </h3>
              {%- endif -%}
            {%- endform -%}
          </div>
        </div>
      </div>
    {%- endif -%}

    <div class="pst-footer__bottom">
      <div class="pst-footer__bottom-inner">
        <p class="pst-footer__copyright">© {{ 'now' | date: '%Y' }}, Perfect School Tools</p>

        {%- if section.settings.show_policy -%}
          <ul class="pst-footer__policies">
            {%- if shop.privacy_policy -%}
              <li><a href="{{ shop.privacy_policy.url }}">{{ shop.privacy_policy.title }}</a></li>
            {%- endif -%}
            {%- if shop.refund_policy -%}
              <li><a href="{{ shop.refund_policy.url }}">{{ shop.refund_policy.title }}</a></li>
            {%- endif -%}
            {%- if shop.terms_of_service -%}
              <li><a href="{{ shop.terms_of_service.url }}">{{ shop.terms_of_service.title }}</a></li>
            {%- endif -%}
          </ul>
        {%- endif -%}

        {%- if section.settings.payment_enable -%}
          <div class="pst-footer__payment">
            <span class="visually-hidden">{{ 'sections.footer.payment' | t }}</span>
            <ul class="list list-payment" role="list">
              {%- for type in shop.enabled_payment_types -%}
                <li class="list-payment__item">
                  {{ type | payment_type_svg_tag: class: 'icon icon--full-color' }}
                </li>
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      </div>
    </div>
  </div>
</footer>

{% schema %}
{
  "name": "t:sections.footer.name",
  "blocks": [
    {
      "type": "@app"
    },
    {
      "type": "link_list",
      "name": "t:sections.footer.blocks.link_list.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.link_list.settings.heading.default",
          "label": "t:sections.footer.blocks.link_list.settings.heading.label"
        },
        {
          "type": "link_list",
          "id": "menu",
          "default": "footer",
          "label": "t:sections.footer.blocks.link_list.settings.menu.label"
        }
      ]
    },
    {
      "type": "brand_information",
      "name": "t:sections.footer.blocks.brand_information.name",
      "settings": [
        {
          "type": "paragraph",
          "content": "t:sections.footer.blocks.brand_information.settings.paragraph.content"
        },
        {
          "type": "checkbox",
          "id": "show_social",
          "default": true,
          "label": "t:sections.footer.blocks.brand_information.settings.show_social.label",
          "info": "t:sections.footer.blocks.brand_information.settings.show_social.info"
        }
      ]
    },
    {
      "type": "text",
      "name": "t:sections.footer.blocks.text.name",
      "settings": [
        {
          "type": "inline_richtext",
          "id": "heading",
          "default": "t:sections.footer.blocks.text.settings.heading.default",
          "label": "t:sections.footer.blocks.text.settings.heading.label"
        },
        {
          "type": "richtext",
          "id": "subtext",
          "default": "t:sections.footer.blocks.text.settings.subtext.default",
          "label": "t:sections.footer.blocks.text.settings.subtext.label"
        }
      ]
    },
    {
      "type": "image",
      "name": "Image",
      "settings": [
        {
          "type": "image_picker",
          "id": "image",
          "label": "Image"
        },
        {
          "type": "range",
          "id": "image_width",
          "min": 50,
          "max": 550,
          "step": 5,
          "unit": "px",
          "label": "Width",
          "default": 100
        },
        {
          "type": "select",
          "id": "alignment",
          "label": "Alignment",
          "options": [
            {
              "value": "",
              "label": "Left"
            },
            {
              "value": "center",
              "label": "Center"
            },
            {
              "value": "right",
              "label": "Right"
            }
          ],
          "default": "center"
        }
      ]
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Footer Logo"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:sections.all.colors.label",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__1.content",
      "info": "t:sections.footer.settings.header__1.info"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "default": true,
      "label": "t:sections.footer.settings.newsletter_enable.label"
    },
    {
      "type": "inline_richtext",
      "id": "newsletter_heading",
      "default": "t:sections.footer.settings.newsletter_heading.default",
      "label": "t:sections.footer.settings.newsletter_heading.label"
    },
    {
      "type": "header",
      "content": "t:sections.footer.settings.header__9.content"
    },
    {
      "type": "checkbox",
      "id": "enable_follow_on_shop",
      "default": true,
