{% comment %}theme-check-disable UndefinedObject{% endcomment %}
<footer class="pst-foot">
  {%- comment -%} A. TOP BAR {%- endcomment -%}
  <div class="pst-foot__top">
    <div class="pst-foot__top-inner">
      <div class="pst-foot__brand">
        {%- if section.settings.footer_logo != blank -%}
          {{ section.settings.footer_logo | image_url: width: 180
             | image_tag: alt: shop.name, class: 'pst-foot__logo-img' }}
        {%- else -%}
          <span class="pst-foot__logo-text">
            {{ shop.name }}
          </span>
        {%- endif -%}
        {%- if section.settings.tagline != blank -%}
          <p class="pst-foot__tagline">
            {{ section.settings.tagline }}
          </p>
        {%- endif -%}
      </div>
      <div class="pst-foot__contact">
        {%- if section.settings.phone != blank -%}
          <a
            href="tel:{{ section.settings.phone | remove: ' ' | remove: '(' | remove: ')' | remove: '-' }}"
            class="pst-foot__contact-item"
          >
            <span class="pst-foot__contact-icon" aria-hidden="true">&#128222;</span>
            {{ section.settings.phone }}
          </a>
        {%- endif -%}
        {%- if section.settings.email != blank -%}
          <a href="mailto:{{ section.settings.email }}" class="pst-foot__contact-item">
            <span class="pst-foot__contact-icon" aria-hidden="true">&#9993;</span>
            {{ section.settings.email }}
          </a>
        {%- endif -%}
      </div>
    </div>
  </div>

  {%- comment -%} B. MAIN LINKS — 5 columns via blocks {%- endcomment -%}
  <div class="pst-foot__main">
    <div class="pst-foot__main-inner">
      {%- for block in section.blocks -%}
        {%- if block.type == 'link_column' -%}
          <div class="pst-foot__col" {{ block.shopify_attributes }}>
            <p class="pst-foot__col-title">
              {{ block.settings.col_title }}
            </p>
            <ul class="pst-foot__links">
              {%- for i in (1..8) -%}
                {%- assign lbl = 'link_' | append: i | append: '_label' -%}
                {%- assign url = 'link_' | append: i | append: '_url' -%}
                {%- if block.settings[lbl] != blank -%}
                  <li>
                    <a href="{{ block.settings[url] | default: '#' }}" class="pst-foot__link">
                      {{ block.settings[lbl] }}
                    </a>
                  </li>
                {%- endif -%}
              {%- endfor -%}
            </ul>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} C. TRUST BAR {%- endcomment -%}
  <div class="pst-foot__trust">
    <div class="pst-foot__trust-inner">
      {%- for i in (1..4) -%}
        {%- assign icon_key = 'trust_' | append: i | append: '_icon' -%}
        {%- assign text_key = 'trust_' | append: i | append: '_text' -%}
        {%- if section.settings[text_key] != blank -%}
          <div class="pst-foot__trust-item">
            <span class="pst-foot__trust-icon">
              {{ section.settings[icon_key] }}
            </span>
            <span class="pst-foot__trust-text">
              {{ section.settings[text_key] }}
            </span>
          </div>
        {%- endif -%}
      {%- endfor -%}
    </div>
  </div>

  {%- comment -%} D. NEWSLETTER {%- endcomment -%}
  {%- if section.settings.newsletter_enable -%}
    <div class="pst-foot__newsletter">
      <div class="pst-foot__newsletter-inner">
        <div class="pst-foot__newsletter-copy">
          <h3 class="pst-foot__newsletter-title">
            {{ section.settings.newsletter_heading }}
          </h3>
          <p class="pst-foot__newsletter-sub">
            {{ section.settings.newsletter_subheading }}
          </p>
        </div>
        <div class="pst-foot__newsletter-form">
          {%- form 'customer', id: 'ContactFooter', class: 'footer__newsletter newsletter-form' -%}
            <input type="hidden" name="contact[tags]" value="newsletter">
            <div class="pst-foot__form-row">
              <input
                id="NewsletterForm--{{ section.id }}"
                type="email"
                name="contact[email]"
                class="pst-foot__email-input"
                value="{{ form.email }}"
                placeholder="{{ section.settings.newsletter_placeholder }}"
                required
                autocomplete="email"
                autocorrect="off"
                autocapitalize="off"
                {% if form.errors %}
                  aria-invalid="true"
                  aria-describedby="ContactFooter-error-{{ section.id }}"
                {% endif %}
              >
              <button type="submit" class="pst-foot__subscribe-btn" name="commit">
                {{ section.settings.newsletter_btn }}
              </button>
            </div>
            {%- if form.errors -%}
              <p class="pst-foot__form-message pst-foot__form-message--error" id="ContactFooter-error-{{ section.id }}">
                {{ form.errors.translated_fields.email | capitalize }}
                {{ form.errors.messages.email }}
              </p>
            {%- endif -%}
            {%- if form.posted_successfully? -%}
              <p class="pst-foot__form-message pst-foot__form-message--success" id="ContactFooter-success-{{ section.id }}">
                {{ 'newsletter.success' | t }}
              </p>
            {%- endif -%}
          {%- endform -%}
        </div>
      </div>
    </div>
  {%- endif -%}

  {%- comment -%} E. BOTTOM BAR {%- endcomment -%}
  <div class="pst-foot__bottom">
    <div class="pst-foot__bottom-inner">
      <p class="pst-foot__copy">
        &copy; {{ 'now' | date: '%Y' }},
        {{ shop.name }}
      </p>
      <div class="pst-foot__policies">
        {%- if shop.privacy_policy != blank -%}
          <a href="{{ shop.privacy_policy.url }}" class="pst-foot__policy-link">
            Privacy Policy
          </a>
        {%- endif -%}
        {%- if shop.refund_policy != blank -%}
          <a href="{{ shop.refund_policy.url }}" class="pst-foot__policy-link">
            Refund Policy
          </a>
        {%- endif -%}
        {%- if shop.terms_of_service != blank -%}
          <a href="{{ shop.terms_of_service.url }}" class="pst-foot__policy-link">
            Terms of Service
          </a>
        {%- endif -%}
      </div>
      {%- if section.settings.payment_enable -%}
        <div class="pst-foot__payments">
          {%- for type in shop.enabled_payment_types -%}
            {{ type | payment_type_svg_tag: class: 'pst-foot__payment-icon' }}
          {%- endfor -%}
        </div>
      {%- endif -%}
    </div>
  </div>
</footer>

{%- style -%}

/* ── TOP BAR ── */
#shopify-section-{{ section.id }} .pst-foot__top {
  background: #0A2540;
  padding: 28px 20px;
}
#shopify-section-{{ section.id }} .pst-foot__top-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 20px;
}
#shopify-section-{{ section.id }} .pst-foot__logo-img {
  max-height: 60px;
  width: auto;
  display: block;
}
#shopify-section-{{ section.id }} .pst-foot__logo-text {
  font-family: 'Outfit', sans-serif;
  font-size: 20px;
  font-weight: 800;
  color: #ffffff;
}
#shopify-section-{{ section.id }} .pst-foot__tagline {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.6);
  margin: 6px 0 0;
}
#shopify-section-{{ section.id }} .pst-foot__contact {
  display: flex;
  flex-direction: column;
  gap: 8px;
  align-items: flex-end;
}
#shopify-section-{{ section.id }} .pst-foot__contact-item {
  display: flex;
  align-items: center;
  gap: 8px;
  color: rgba(255,255,255,0.85);
  font-family: 'Nunito Sans', sans-serif;
  font-size: 14px;
  text-decoration: none;
  transition: color 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-foot__contact-item:hover { color: #F5B731; }
#shopify-section-{{ section.id }} .pst-foot__contact-icon {
  font-size: 14px;
}

/* ── MAIN LINKS ── */
#shopify-section-{{ section.id }} .pst-foot__main {
  background: #0A2540;
  padding: 48px 20px 40px;
  border-top: 1px solid rgba(255,255,255,0.08);
}
#shopify-section-{{ section.id }} .pst-foot__main-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: repeat(5, 1fr);
  gap: 32px;
}
@media (max-width: 900px) {
  #shopify-section-{{ section.id }} .pst-foot__main-inner {
    grid-template-columns: repeat(3, 1fr);
  }
}
@media (max-width: 600px) {
  #shopify-section-{{ section.id }} .pst-foot__main-inner {
    grid-template-columns: repeat(2, 1fr);
    gap: 24px;
  }
  #shopify-section-{{ section.id }} .pst-foot__contact {
    align-items: flex-start;
  }
}
#shopify-section-{{ section.id }} .pst-foot__col-title {
  font-family: 'Outfit', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  color: #F5B731;
  margin: 0 0 14px;
}
#shopify-section-{{ section.id }} .pst-foot__links {
  list-style: none;
  padding: 0;
  margin: 0;
  display: flex;
  flex-direction: column;
  gap: 9px;
}
#shopify-section-{{ section.id }} .pst-foot__link {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.72);
  text-decoration: none;
  transition: color 0.2s;
  line-height: 1.4;
}
#shopify-section-{{ section.id }}
  .pst-foot__link:hover { color: #ffffff; }

/* ── TRUST BAR ── */
#shopify-section-{{ section.id }} .pst-foot__trust {
  background: #0F4872;
  padding: 18px 20px;
}
#shopify-section-{{ section.id }} .pst-foot__trust-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 40px;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-foot__trust-item {
  display: flex;
  align-items: center;
  gap: 8px;
}
#shopify-section-{{ section.id }} .pst-foot__trust-icon {
  font-size: 16px;
}
#shopify-section-{{ section.id }} .pst-foot__trust-text {
  font-family: 'Outfit', sans-serif;
  font-size: 13px;
  font-weight: 700;
  color: #ffffff;
  text-transform: uppercase;
  letter-spacing: 0.5px;
}

/* ── NEWSLETTER ── */
#shopify-section-{{ section.id }} .pst-foot__newsletter {
  background: #061a2e;
  padding: 48px 20px;
}
#shopify-section-{{ section.id }}
  .pst-foot__newsletter-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 40px;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }}
  .pst-foot__newsletter-copy { flex: 1; min-width: 260px; }
#shopify-section-{{ section.id }}
  .pst-foot__newsletter-title {
  font-family: 'Outfit', sans-serif;
  font-size: 22px;
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 8px;
}
#shopify-section-{{ section.id }}
  .pst-foot__newsletter-sub {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 14px;
  color: rgba(255,255,255,0.65);
  margin: 0;
}
#shopify-section-{{ section.id }}
  .pst-foot__newsletter-form { flex: 1; min-width: 280px; }
#shopify-section-{{ section.id }} .pst-foot__form-row {
  display: flex;
  gap: 0;
  border-radius: 8px;
  overflow: hidden;
}
#shopify-section-{{ section.id }} .pst-foot__email-input {
  flex: 1;
  padding: 14px 16px;
  font-family: 'Nunito Sans', sans-serif;
  font-size: 14px;
  border: none;
  outline: none;
  background: rgba(255,255,255,0.1);
  color: #ffffff;
  border-radius: 8px 0 0 8px;
}
#shopify-section-{{ section.id }}
  .pst-foot__email-input::placeholder {
  color: rgba(255,255,255,0.45);
}
#shopify-section-{{ section.id }} .pst-foot__subscribe-btn {
  padding: 14px 24px;
  background: #E91E8C;
  color: #ffffff;
  font-family: 'Outfit', sans-serif;
  font-size: 14px;
  font-weight: 700;
  border: none;
  cursor: pointer;
  border-radius: 0 8px 8px 0;
  transition: background 0.2s;
  white-space: nowrap;
}
#shopify-section-{{ section.id }}
  .pst-foot__subscribe-btn:hover {
  background: #C4186F;
}
#shopify-section-{{ section.id }} .pst-foot__form-message {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 13px;
  margin: 12px 0 0;
}
#shopify-section-{{ section.id }} .pst-foot__form-message--error {
  color: #ffb4b4;
}
#shopify-section-{{ section.id }} .pst-foot__form-message--success {
  color: #7dffb3;
}

/* ── BOTTOM BAR ── */
#shopify-section-{{ section.id }} .pst-foot__bottom {
  background: #061a2e;
  border-top: 1px solid rgba(255,255,255,0.08);
  padding: 20px;
}
#shopify-section-{{ section.id }} .pst-foot__bottom-inner {
  max-width: 1200px;
  margin: 0 auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  flex-wrap: wrap;
  gap: 12px;
}
#shopify-section-{{ section.id }} .pst-foot__copy {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  margin: 0;
}
#shopify-section-{{ section.id }} .pst-foot__policies {
  display: flex;
  gap: 20px;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-foot__policy-link {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 13px;
  color: rgba(255,255,255,0.5);
  text-decoration: none;
  transition: color 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-foot__policy-link:hover {
  color: rgba(255,255,255,0.85);
}
#shopify-section-{{ section.id }} .pst-foot__payments {
  display: flex;
  gap: 6px;
  flex-wrap: wrap;
  align-items: center;
}
#shopify-section-{{ section.id }} .pst-foot__payment-icon {
  height: 24px;
  width: auto;
  border-radius: 3px;
}

/* ── MOBILE ── */

/* Trust bar — 2x2 grid */
@media (max-width: 600px) {
  #shopify-section-{{ section.id }} .pst-foot__trust-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 12px 8px;
    justify-items: center;
  }
  #shopify-section-{{ section.id }} .pst-foot__trust-item {
    font-size: 11px;
    text-align: center;
    flex-direction: column;
    gap: 4px;
  }
}

/* Top bar — stack */
@media (max-width: 600px) {
  #shopify-section-{{ section.id }} .pst-foot__top-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .pst-foot__contact {
    align-items: flex-start;
  }
}

/* Main links — 2 columns */
@media (max-width: 600px) {
  #shopify-section-{{ section.id }} .pst-foot__main-inner {
    grid-template-columns: repeat(2, 1fr);
    gap: 28px 16px;
  }
  #shopify-section-{{ section.id }} .pst-foot__col-title {
    font-size: 10px;
    margin-bottom: 10px;
  }
  #shopify-section-{{ section.id }} .pst-foot__link {
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .pst-foot__links {
    gap: 7px;
  }
  #shopify-section-{{ section.id }} .pst-foot__main {
    padding: 36px 20px 32px;
  }
}

/* Newsletter — stack */
@media (max-width: 600px) {
  #shopify-section-{{ section.id }}
    .pst-foot__newsletter-inner {
    flex-direction: column;
    gap: 20px;
  }
  #shopify-section-{{ section.id }}
    .pst-foot__newsletter-title {
    font-size: 18px;
  }
  #shopify-section-{{ section.id }} .pst-foot__newsletter {
    padding: 36px 20px;
  }
}

/* Bottom bar — stack */
@media (max-width: 600px) {
  #shopify-section-{{ section.id }} .pst-foot__bottom-inner {
    flex-direction: column;
    align-items: flex-start;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .pst-foot__policies {
    gap: 12px;
    flex-wrap: wrap;
  }
}

{%- endstyle -%}

{% schema %}
{
  "name": "Footer",
  "tag": "section",
  "class": "footer-section",
  "settings": [

    {
      "type": "header",
      "content": "Brand"
    },
    {
      "type": "image_picker",
      "id": "footer_logo",
      "label": "Footer Logo"
    },
    {
      "type": "text",
      "id": "tagline",
      "label": "Tagline under logo",
      "default": "Visual Learning Solutions"
    },

    {
      "type": "header",
      "content": "Contact Info"
    },
    {
      "type": "text",
      "id": "phone",
      "label": "Phone Number",
      "default": "(888) 535-4431"
    },
    {
      "type": "text",
      "id": "email",
      "label": "Email Address",
      "default": "orders@perfectschooltools.com"
    },

    {
      "type": "header",
      "content": "Trust Bar"
    },
    {
      "type": "text",
      "id": "trust_1_icon",
      "label": "Trust Item 1 — Icon (emoji)",
      "default": "\u2713"
    },
    {
      "type": "text",
      "id": "trust_1_text",
      "label": "Trust Item 1 — Text",
      "default": "Purchase Orders Accepted"
    },
    {
      "type": "text",
      "id": "trust_2_icon",
      "label": "Trust Item 2 — Icon (emoji)",
      "default": "\uD83D\uDE9A"
    },
    {
      "type": "text",
      "id": "trust_2_text",
      "label": "Trust Item 2 — Text",
      "default": "Fast Shipping"
    },
    {
      "type": "text",
      "id": "trust_3_icon",
      "label": "Trust Item 3 — Icon (emoji)",
      "default": "\uD83D\uDCDE"
    },
    {
      "type": "text",
      "id": "trust_3_text",
      "label": "Trust Item 3 — Text",
      "default": "Unlimited Support"
    },
    {
      "type": "text",
      "id": "trust_4_icon",
      "label": "Trust Item 4 — Icon (emoji)",
      "default": "\uD83C\uDFC6"
    },
    {
      "type": "text",
      "id": "trust_4_text",
      "label": "Trust Item 4 — Text",
      "default": "30+ Years Experience Serving Schools"
    },

    {
      "type": "header",
      "content": "Newsletter"
    },
    {
      "type": "checkbox",
      "id": "newsletter_enable",
      "label": "Show Newsletter Section",
      "default": true
    },
    {
      "type": "text",
      "id": "newsletter_heading",
      "label": "Newsletter Heading",
      "default": "Stay Connected with Perfect School Tools"
    },
    {
      "type": "text",
      "id": "newsletter_subheading",
      "label": "Newsletter Subheading",
      "default": "Get tips, resources, and updates for school educators."
    },
    {
      "type": "text",
      "id": "newsletter_placeholder",
      "label": "Email Input Placeholder",
      "default": "Enter your email"
    },
    {
      "type": "text",
      "id": "newsletter_btn",
      "label": "Subscribe Button Label",
      "default": "Subscribe"
    },

    {
      "type": "header",
      "content": "Bottom Bar"
    },
    {
      "type": "checkbox",
      "id": "payment_enable",
      "label": "Show Payment Icons",
      "default": true
    }

  ],
  "blocks": [
    {
      "type": "link_column",
      "name": "Link Column",
      "settings": [
        {
          "type": "text",
          "id": "col_title",
          "label": "Column Heading",
          "default": "Column"
        },
        {
          "type": "text",
          "id": "link_1_label",
          "label": "Link 1 — Label"
        },
        {
          "type": "url",
          "id": "link_1_url",
          "label": "Link 1 — URL"
        },
        {
          "type": "text",
          "id": "link_2_label",
          "label": "Link 2 — Label"
        },
        {
          "type": "url",
          "id": "link_2_url",
          "label": "Link 2 — URL"
        },
        {
          "type": "text",
          "id": "link_3_label",
          "label": "Link 3 — Label"
        },
        {
          "type": "url",
          "id": "link_3_url",
          "label": "Link 3 — URL"
        },
        {
          "type": "text",
          "id": "link_4_label",
          "label": "Link 4 — Label"
        },
        {
          "type": "url",
          "id": "link_4_url",
          "label": "Link 4 — URL"
        },
        {
          "type": "text",
          "id": "link_5_label",
          "label": "Link 5 — Label"
        },
        {
          "type": "url",
          "id": "link_5_url",
          "label": "Link 5 — URL"
        },
        {
          "type": "text",
          "id": "link_6_label",
          "label": "Link 6 — Label"
        },
        {
          "type": "url",
          "id": "link_6_url",
          "label": "Link 6 — URL"
        },
        {
          "type": "text",
          "id": "link_7_label",
          "label": "Link 7 — Label"
        },
        {
          "type": "url",
          "id": "link_7_url",
          "label": "Link 7 — URL"
        },
        {
          "type": "text",
          "id": "link_8_label",
          "label": "Link 8 — Label"
        },
        {
          "type": "url",
          "id": "link_8_url",
          "label": "Link 8 — URL"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PST Footer",
      "blocks": [
        {
          "type": "link_column",
          "settings": {
            "col_title": "Products",
            "link_1_label": "Poster Makers",
            "link_1_url": "/pages/poster-makers-for-schools",
