      "label": "Secondary Button Label",
      "default": "(888) 535-4431"
    },
    {
      "type": "text",
      "id": "hero_phone",
      "label": "Phone Number (for tel: link)",
      "default": "+18885354431"
    },

    {
      "type": "header",
      "content": "Trust Bar"
    },
    {
      "type": "text",
      "id": "trust_1",
      "label": "Trust Item 1",
      "default": "Purchase Orders Accepted"
    },
    {
      "type": "text",
      "id": "trust_2",
      "label": "Trust Item 2",
      "default": "Fast Shipping"
    },
    {
      "type": "text",
      "id": "trust_3",
      "label": "Trust Item 3",
      "default": "Unlimited Support"
    },
    {
      "type": "text",
      "id": "trust_4",
      "label": "Trust Item 4",
      "default": "30+ Years Experience"
    },

    {
      "type": "header",
      "content": "Section Colors"
    },
    {
      "type": "color",
      "id": "hero_bg_start",
      "label": "Hero Gradient Start",
      "default": "#0A2540"
    },
    {
      "type": "color",
      "id": "hero_bg_end",
      "label": "Hero Gradient End",
      "default": "#0F4872"
    },
    {
      "type": "color",
      "id": "trust_bar_bg",
      "label": "Trust Bar Background",
      "default": "#F5B731"
    },
