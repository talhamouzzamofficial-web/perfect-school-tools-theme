{%- style -%}

/* HERO */
#shopify-section-{{ section.id }} .pst-rs__hero {
  background: linear-gradient(135deg, {{ section.settings.hero_bg_start }}, {{ section.settings.hero_bg_end }});
  padding: {{ section.settings.section_padding }}px 20px {{ section.settings.section_padding | times: 0.75 | round }}px;
  text-align: center;
}
#shopify-section-{{ section.id }} .pst-rs__hero-inner {
  max-width: 800px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .pst-rs__badge {
  display: inline-block;
  background: rgba(233,30,140,0.2);
  color: #E91E8C;
  font-family: 'Outfit', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 20px;
  margin: 0 0 16px;
  border: 1px solid rgba(233,30,140,0.3);
}
#shopify-section-{{ section.id }} .pst-rs__hero-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(28px, 4vw, 46px);
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 16px;
  line-height: 1.15;
}
#shopify-section-{{ section.id }} .pst-rs__hero-sub {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 17px;
  color: rgba(255,255,255,0.8);
  margin: 0 0 28px;
  line-height: 1.6;
}
#shopify-section-{{ section.id }} .pst-rs__hero-btns {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-rs__btn-primary {
  display: inline-block;
  padding: 13px 28px;
  background: #E91E8C;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__btn-primary:hover { background: #C4186F; }
#shopify-section-{{ section.id }} .pst-rs__btn-secondary {
  display: inline-block;
  padding: 12px 28px;
  background: transparent;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.4);
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__btn-secondary:hover {
  border-color: #fff;
  background: rgba(255,255,255,0.1);
}

/* TRUST BAR */
#shopify-section-{{ section.id }} .pst-rs__trust {
  background: {{ section.settings.trust_bar_bg }};
  padding: 14px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__trust-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-rs__trust-item {
  font-family: 'Outfit', sans-serif;
  font-size: 12px;
  font-weight: 700;
  color: #0A2540;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* 3 WAYS TO REORDER */
#shopify-section-{{ section.id }} .pst-rs__ways {
  background: {{ section.settings.section_bg_alt }};
  padding: {{ section.settings.section_padding }}px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__ways-inner {
  max-width: 1100px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .pst-rs__section-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 800;
  color: #0A2540;
  text-align: center;
  margin: 0 0 40px;
}
#shopify-section-{{ section.id }} .pst-rs__ways-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
#shopify-section-{{ section.id }} .pst-rs__way-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 36px 28px;
  text-align: center;
  border: 1px solid rgba(10,37,64,0.07);
  box-shadow: 0 2px 16px rgba(10,37,64,0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__way-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(10,37,64,0.12);
}
#shopify-section-{{ section.id }} .pst-rs__way-icon {
  font-size: 40px;
  margin-bottom: 16px;
  display: block;
}
#shopify-section-{{ section.id }} .pst-rs__way-title {
  font-family: 'Outfit', sans-serif;
  font-size: 20px;
  font-weight: 800;
  color: #0A2540;
  margin: 0 0 12px;
}
#shopify-section-{{ section.id }} .pst-rs__way-contact {
  font-family: 'Outfit', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: #E91E8C;
  text-decoration: none;
  display: block;
  margin-bottom: 10px;
}
#shopify-section-{{ section.id }} .pst-rs__way-desc {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 14px;
  color: #334155;
  line-height: 1.6;
  margin: 0;
}

/* SUPPLY REFERENCE */
#shopify-section-{{ section.id }} .pst-rs__supplies {
  background: #ffffff;
  padding: {{ section.settings.section_padding }}px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__supplies-inner {
  max-width: 1100px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .pst-rs__supplies-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
#shopify-section-{{ section.id }} .pst-rs__supply-card {
  background: {{ section.settings.section_bg_alt }};
  border-radius: 12px;
  padding: 24px 20px;
  border: 1px solid rgba(10,37,64,0.07);
  text-decoration: none;
  display: block;
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__supply-card:hover {
  background: #0A2540;
  border-color: #0A2540;
}
#shopify-section-{{ section.id }} .pst-rs__supply-name {
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #0A2540;
  margin: 0 0 6px;
  transition: color 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__supply-card:hover .pst-rs__supply-name {
  color: #ffffff;
}
#shopify-section-{{ section.id }} .pst-rs__supply-desc {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 13px;
  color: #334155;
  margin: 0;
  transition: color 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__supply-card:hover .pst-rs__supply-desc {
  color: rgba(255,255,255,0.7);
}

/* RELATED PAGES */
#shopify-section-{{ section.id }} .pst-rs__related {
  background: {{ section.settings.section_bg_alt }};
  padding: {{ section.settings.section_padding }}px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__related-inner {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
}
#shopify-section-{{ section.id }} .pst-rs__related-links {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 24px;
}
#shopify-section-{{ section.id }} .pst-rs__related-link {
  display: inline-block;
  padding: 10px 20px;
  background: #ffffff;
  color: #0A2540;
  font-family: 'Outfit', sans-serif;
  font-size: 14px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  border: 1px solid rgba(10,37,64,0.12);
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__related-link:hover {
  background: #0A2540;
  color: #ffffff;
}

/* CTA */
#shopify-section-{{ section.id }} .pst-rs__cta {
  background: linear-gradient(135deg, {{ section.settings.cta_bg_start }}, {{ section.settings.cta_bg_end }});
  padding: {{ section.settings.section_padding }}px 20px;
  text-align: center;
}
#shopify-section-{{ section.id }} .pst-rs__cta-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 800;
  color: #fff;
  margin: 0 0 12px;
}
#shopify-section-{{ section.id }} .pst-rs__cta-sub {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 16px;
  color: rgba(255,255,255,0.85);
  margin: 0 0 28px;
}
#shopify-section-{{ section.id }} .pst-rs__cta-btns {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-rs__cta-btn-white {
  display: inline-block;
  padding: 13px 28px;
  background: #fff;
  color: #E91E8C;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__cta-btn-white:hover { background: #FDF8F0; }
#shopify-section-{{ section.id }} .pst-rs__cta-btn-outline {
  display: inline-block;
  padding: 12px 28px;
  background: transparent;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.6);
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__cta-btn-outline:hover {
  border-color: #fff;
  background: rgba(255,255,255,0.1);
}

/* MOBILE */
@media (max-width: 768px) {

  /* Hero */
  #shopify-section-{{ section.id }} .pst-rs__hero {
    padding: 48px 20px 40px;
  }
  #shopify-section-{{ section.id }} .pst-rs__hero-title {
    font-size: clamp(24px, 7vw, 34px);
  }
  #shopify-section-{{ section.id }} .pst-rs__hero-sub,
  #shopify-section-{{ section.id }} .pst-rs__hero-subtitle {
    font-size: 15px;
  }
  #shopify-section-{{ section.id }} .pst-rs__hero-btns {
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .pst-rs__btn-primary,
  #shopify-section-{{ section.id }} .pst-rs__btn-secondary {
    width: 100%;
    max-width: 300px;
    text-align: center;
  }

  /* Trust bar */
  #shopify-section-{{ section.id }} .pst-rs__trust-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 8px;
    justify-items: center;
  }
  #shopify-section-{{ section.id }} .pst-rs__trust-item {
    font-size: 10px;
    flex-direction: column;
    text-align: center;
    gap: 4px;
  }

  /* Main content grids */
  #shopify-section-{{ section.id }} .pst-rs__ways-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .pst-rs__supplies-grid {
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }

  /* Cards */
  #shopify-section-{{ section.id }} .pst-rs__way-card {
    padding: 24px 18px;
  }
  #shopify-section-{{ section.id }} .pst-rs__way-icon {
    font-size: 32px;
  }
  #shopify-section-{{ section.id }} .pst-rs__way-title {
    font-size: 16px;
  }
  #shopify-section-{{ section.id }} .pst-rs__way-contact {
    font-size: 14px;
    word-break: break-all;
  }

  /* Supply cards */
  #shopify-section-{{ section.id }} .pst-rs__supply-card {
    padding: 16px 12px;
  }
  #shopify-section-{{ section.id }} .pst-rs__supply-name {
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .pst-rs__supply-desc {
    font-size: 12px;
  }

  /* Related links pills */
  #shopify-section-{{ section.id }} .pst-rs__related-links {
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .pst-rs__related-link {
    font-size: 13px;
    padding: 9px 14px;
  }

  /* Section titles */
  #shopify-section-{{ section.id }} .pst-rs__section-title {
    font-size: clamp(20px, 5vw, 26px);
    margin-bottom: 24px;
  }

  /* CTA Banner */
  #shopify-section-{{ section.id }} .pst-rs__cta-title {
    font-size: clamp(20px, 6vw, 28px);
  }
  #shopify-section-{{ section.id }} .pst-rs__cta-sub,
  #shopify-section-{{ section.id }} .pst-rs__cta-subtitle {
    font-size: 14px;
    word-break: break-word;
  }
  #shopify-section-{{ section.id }} .pst-rs__cta-btns {
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .pst-rs__cta-btn-white,
  #shopify-section-{{ section.id }} .pst-rs__cta-btn-outline {
    width: 100%;
    max-width: 300px;
    text-align: center;
  }

  /* Section padding */
  #shopify-section-{{ section.id }} .pst-rs__ways,
  #shopify-section-{{ section.id }} .pst-rs__supplies,
  #shopify-section-{{ section.id }} .pst-rs__related,
  #shopify-section-{{ section.id }} .pst-rs__cta {
    padding: 48px 20px;
  }
}

@media (max-width: 400px) {
  #shopify-section-{{ section.id }} .pst-rs__supplies-grid {
    grid-template-columns: 1fr;
  }
}

{%- endstyle -%}

<!-- HERO -->
<div class="pst-rs__hero">
  <div class="pst-rs__hero-inner">
    <p class="pst-rs__badge">{{ section.settings.hero_badge }}</p>
    <h1 class="pst-rs__hero-title">{{ section.settings.hero_title }}</h1>
    <p class="pst-rs__hero-sub">{{ section.settings.hero_subtitle }}</p>
    <div class="pst-rs__hero-btns">
      <a href="{{ section.settings.hero_btn_primary_url | default: '/pages/contact' }}" class="pst-rs__btn-primary">
        {{ section.settings.hero_btn_primary_label }}
      </a>
      <a href="tel:{{ section.settings.hero_phone }}" class="pst-rs__btn-secondary">
        {{ section.settings.hero_btn_secondary_label }}
      </a>
    </div>
  </div>
</div>

<!-- TRUST BAR -->
<div class="pst-rs__trust">
  <div class="pst-rs__trust-inner">
    <span class="pst-rs__trust-item">&#10003; {{ section.settings.trust_1 }}</span>
    <span class="pst-rs__trust-item">&#128666; {{ section.settings.trust_2 }}</span>
    <span class="pst-rs__trust-item">&#128222; {{ section.settings.trust_3 }}</span>
    <span class="pst-rs__trust-item">&#127942; {{ section.settings.trust_4 }}</span>
  </div>
</div>

<!-- 3 WAYS TO REORDER -->
<div class="pst-rs__ways">
  <div class="pst-rs__ways-inner">
    <h2 class="pst-rs__section-title">Three Ways to Reorder</h2>
    <div class="pst-rs__ways-grid">

      <div class="pst-rs__way-card">
        <span class="pst-rs__way-icon">&#128222;</span>
        <h3 class="pst-rs__way-title">Call Us</h3>
        <a href="tel:{{ section.settings.hero_phone }}" class="pst-rs__way-contact">
          (888) 535-4431
        </a>
        <p class="pst-rs__way-desc">
          Just say "same as last time" — we keep your order history on file
        </p>
      </div>

      <div class="pst-rs__way-card">
        <span class="pst-rs__way-icon">&#9993;</span>
        <h3 class="pst-rs__way-title">Email a PO</h3>
        <a href="mailto:orders@perfectschooltools.com" class="pst-rs__way-contact">
          orders@perfectschooltools.com
        </a>
        <p class="pst-rs__way-desc">
          Attach your purchase order and we'll process it the same day
        </p>
      </div>

      <div class="pst-rs__way-card">
        <span class="pst-rs__way-icon">&#128187;</span>
        <h3 class="pst-rs__way-title">Online</h3>
        <a href="{{ section.settings.hero_btn_primary_url | default: '/pages/contact' }}" class="pst-rs__way-contact">
          Request a Quote
        </a>
        <p class="pst-rs__way-desc">
          Fill out our quick form and we'll send a quote for your approval
        </p>
      </div>

    </div>
  </div>
</div>

<!-- SUPPLY REFERENCE -->
<div class="pst-rs__supplies">
  <div class="pst-rs__supplies-inner">
    <h2 class="pst-rs__section-title">Quick Supply Reference</h2>
    <div class="pst-rs__supplies-grid">
      <a href="/pages/poster-printer-paper" class="pst-rs__supply-card">
        <p class="pst-rs__supply-name">Premium Poster Paper Roll</p>
        <p class="pst-rs__supply-desc">24" x 100' premium bright white</p>
      </a>
      <a href="/pages/poster-printer-paper" class="pst-rs__supply-card">
        <p class="pst-rs__supply-name">Standard Poster Paper Roll</p>
        <p class="pst-rs__supply-desc">24" x 100' standard white</p>
      </a>
      <a href="/pages/poster-printer-ink" class="pst-rs__supply-card">
        <p class="pst-rs__supply-name">Full Color Ink Set (CMYK)</p>
        <p class="pst-rs__supply-desc">Prints 225&ndash;275 posters</p>
      </a>
      <a href="/pages/poster-printer-ink" class="pst-rs__supply-card">
        <p class="pst-rs__supply-name">Individual Ink Cartridge</p>
        <p class="pst-rs__supply-desc">Single C, M, Y, or K cartridge</p>
      </a>
      <a href="/pages/cold-laminator-supplies" class="pst-rs__supply-card">
        <p class="pst-rs__supply-name">25" Lamination Film Roll</p>
        <p class="pst-rs__supply-desc">Cold lamination film</p>
      </a>
      <a href="/pages/poster-maker-supplies" class="pst-rs__supply-card">
        <p class="pst-rs__supply-name">Maintenance Kit</p>
        <p class="pst-rs__supply-desc">Cleaning and maintenance supplies</p>
      </a>
    </div>
  </div>
</div>

<!-- RELATED PAGES -->
<div class="pst-rs__related">
  <div class="pst-rs__related-inner">
    <h2 class="pst-rs__section-title">Related Pages</h2>
    <div class="pst-rs__related-links">
      <a href="/pages/poster-printer-supplies" class="pst-rs__related-link">Full Supply Catalog</a>
      <a href="/pages/poster-printer-paper" class="pst-rs__related-link">Poster Printer Paper</a>
      <a href="/pages/poster-printer-ink" class="pst-rs__related-link">Poster Printer Ink</a>
      <a href="/pages/cold-laminator-supplies" class="pst-rs__related-link">Laminator Supplies</a>
      <a href="/pages/purchase-orders" class="pst-rs__related-link">Purchase Order Process</a>
    </div>
  </div>
</div>

<!-- CTA BANNER -->
<div class="pst-rs__cta">
  <h2 class="pst-rs__cta-title">{{ section.settings.cta_title }}</h2>
  <p class="pst-rs__cta-sub">{{ section.settings.cta_subtitle }}</p>
  <div class="pst-rs__cta-btns">
    <a href="{{ section.settings.cta_btn_primary_url | default: '/pages/contact' }}" class="pst-rs__cta-btn-white">
      {{ section.settings.cta_btn_primary_label }}
    </a>
    <a href="tel:{{ section.settings.hero_phone }}" class="pst-rs__cta-btn-outline">
      {{ section.settings.cta_btn_secondary_label }}
    </a>
  </div>
</div>

{% schema %}
{
  "name": "PST Reorder Supplies",
  "tag": "section",
  "settings": [

    {
      "type": "header",
      "content": "Hero Section"
    },
