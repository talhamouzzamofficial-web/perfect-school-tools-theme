{%- style -%}

/* HERO */
#shopify-section-{{ section.id }} .pst-rs__hero {
  background: linear-gradient(135deg, #0A2540, #0F4872);
  padding: 80px 20px 60px;
  text-align: center;
}
#shopify-section-{{ section.id }} .pst-rs__hero-inner {
  max-width: 800px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .pst-rs__badge {
  display: inline-block;
  background: rgba(233,30,140,0.2);
  color: #E91E8C;
  font-family: 'Outfit', sans-serif;
  font-size: 11px;
  font-weight: 700;
  letter-spacing: 1.5px;
  text-transform: uppercase;
  padding: 5px 14px;
  border-radius: 20px;
  margin: 0 0 16px;
  border: 1px solid rgba(233,30,140,0.3);
}
#shopify-section-{{ section.id }} .pst-rs__hero-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(28px, 4vw, 46px);
  font-weight: 800;
  color: #ffffff;
  margin: 0 0 16px;
  line-height: 1.15;
}
#shopify-section-{{ section.id }} .pst-rs__hero-sub {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 17px;
  color: rgba(255,255,255,0.8);
  margin: 0 0 28px;
  line-height: 1.6;
}
#shopify-section-{{ section.id }} .pst-rs__hero-btns {
  display: flex;
  gap: 12px;
  justify-content: center;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-rs__btn-primary {
  display: inline-block;
  padding: 13px 28px;
  background: #E91E8C;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__btn-primary:hover { background: #C4186F; }
#shopify-section-{{ section.id }} .pst-rs__btn-secondary {
  display: inline-block;
  padding: 12px 28px;
  background: transparent;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.4);
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__btn-secondary:hover {
  border-color: #fff;
  background: rgba(255,255,255,0.1);
}

/* TRUST BAR */
#shopify-section-{{ section.id }} .pst-rs__trust {
  background: #F5B731;
  padding: 14px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__trust-inner {
  max-width: 1100px;
  margin: 0 auto;
  display: flex;
  justify-content: center;
  gap: 40px;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-rs__trust-item {
  font-family: 'Outfit', sans-serif;
  font-size: 12px;
  font-weight: 700;
  color: #0A2540;
  text-transform: uppercase;
  letter-spacing: 0.5px;
  display: flex;
  align-items: center;
  gap: 6px;
}

/* 3 WAYS TO REORDER */
#shopify-section-{{ section.id }} .pst-rs__ways {
  background: #FDF8F0;
  padding: 80px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__ways-inner {
  max-width: 1100px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .pst-rs__section-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 800;
  color: #0A2540;
  text-align: center;
  margin: 0 0 40px;
}
#shopify-section-{{ section.id }} .pst-rs__ways-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 24px;
}
#shopify-section-{{ section.id }} .pst-rs__way-card {
  background: #ffffff;
  border-radius: 16px;
  padding: 36px 28px;
  text-align: center;
  border: 1px solid rgba(10,37,64,0.07);
  box-shadow: 0 2px 16px rgba(10,37,64,0.06);
  transition: transform 0.2s, box-shadow 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__way-card:hover {
  transform: translateY(-4px);
  box-shadow: 0 8px 32px rgba(10,37,64,0.12);
}
#shopify-section-{{ section.id }} .pst-rs__way-icon {
  font-size: 40px;
  margin-bottom: 16px;
  display: block;
}
#shopify-section-{{ section.id }} .pst-rs__way-title {
  font-family: 'Outfit', sans-serif;
  font-size: 20px;
  font-weight: 800;
  color: #0A2540;
  margin: 0 0 12px;
}
#shopify-section-{{ section.id }} .pst-rs__way-contact {
  font-family: 'Outfit', sans-serif;
  font-size: 18px;
  font-weight: 700;
  color: #E91E8C;
  text-decoration: none;
  display: block;
  margin-bottom: 10px;
}
#shopify-section-{{ section.id }} .pst-rs__way-desc {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 14px;
  color: #334155;
  line-height: 1.6;
  margin: 0;
}

/* SUPPLY REFERENCE */
#shopify-section-{{ section.id }} .pst-rs__supplies {
  background: #ffffff;
  padding: 80px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__supplies-inner {
  max-width: 1100px;
  margin: 0 auto;
}
#shopify-section-{{ section.id }} .pst-rs__supplies-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20px;
}
#shopify-section-{{ section.id }} .pst-rs__supply-card {
  background: #FDF8F0;
  border-radius: 12px;
  padding: 24px 20px;
  border: 1px solid rgba(10,37,64,0.07);
  text-decoration: none;
  display: block;
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__supply-card:hover {
  background: #0A2540;
  border-color: #0A2540;
}
#shopify-section-{{ section.id }} .pst-rs__supply-name {
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  color: #0A2540;
  margin: 0 0 6px;
  transition: color 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__supply-card:hover .pst-rs__supply-name {
  color: #ffffff;
}
#shopify-section-{{ section.id }} .pst-rs__supply-desc {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 13px;
  color: #334155;
  margin: 0;
  transition: color 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__supply-card:hover .pst-rs__supply-desc {
  color: rgba(255,255,255,0.7);
}

/* RELATED PAGES */
#shopify-section-{{ section.id }} .pst-rs__related {
  background: #FDF8F0;
  padding: 60px 20px;
}
#shopify-section-{{ section.id }} .pst-rs__related-inner {
  max-width: 1100px;
  margin: 0 auto;
  text-align: center;
}
#shopify-section-{{ section.id }} .pst-rs__related-links {
  display: flex;
  gap: 12px;
  flex-wrap: wrap;
  justify-content: center;
  margin-top: 24px;
}
#shopify-section-{{ section.id }} .pst-rs__related-link {
  display: inline-block;
  padding: 10px 20px;
  background: #ffffff;
  color: #0A2540;
  font-family: 'Outfit', sans-serif;
  font-size: 14px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  border: 1px solid rgba(10,37,64,0.12);
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__related-link:hover {
  background: #0A2540;
  color: #ffffff;
}

/* CTA */
#shopify-section-{{ section.id }} .pst-rs__cta {
  background: linear-gradient(135deg, #E91E8C, #C4186F);
  padding: 60px 20px;
  text-align: center;
}
#shopify-section-{{ section.id }} .pst-rs__cta-title {
  font-family: 'Outfit', sans-serif;
  font-size: clamp(22px, 3vw, 32px);
  font-weight: 800;
  color: #fff;
  margin: 0 0 12px;
}
#shopify-section-{{ section.id }} .pst-rs__cta-sub {
  font-family: 'Nunito Sans', sans-serif;
  font-size: 16px;
  color: rgba(255,255,255,0.85);
  margin: 0 0 28px;
}
#shopify-section-{{ section.id }} .pst-rs__cta-btns {
  display: flex;
  gap: 14px;
  justify-content: center;
  flex-wrap: wrap;
}
#shopify-section-{{ section.id }} .pst-rs__cta-btn-white {
  display: inline-block;
  padding: 13px 28px;
  background: #fff;
  color: #E91E8C;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 700;
  border-radius: 8px;
  text-decoration: none;
  transition: background 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__cta-btn-white:hover { background: #FDF8F0; }
#shopify-section-{{ section.id }} .pst-rs__cta-btn-outline {
  display: inline-block;
  padding: 12px 28px;
  background: transparent;
  color: #fff;
  font-family: 'Outfit', sans-serif;
  font-size: 15px;
  font-weight: 600;
  border-radius: 8px;
  text-decoration: none;
  border: 2px solid rgba(255,255,255,0.6);
  transition: all 0.2s;
}
#shopify-section-{{ section.id }}
  .pst-rs__cta-btn-outline:hover {
  border-color: #fff;
  background: rgba(255,255,255,0.1);
}

/* ── HERO ── */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .pst-rs__hero {
    padding: 48px 20px 40px;
  }
  #shopify-section-{{ section.id }} .pst-rs__hero-title {
    font-size: clamp(24px, 7vw, 34px);
  }
  #shopify-section-{{ section.id }} .pst-rs__hero-sub {
    font-size: 15px;
  }
  #shopify-section-{{ section.id }} .pst-rs__hero-btns {
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .pst-rs__btn-primary,
  #shopify-section-{{ section.id }} .pst-rs__btn-secondary {
    width: 100%;
    max-width: 300px;
    text-align: center;
  }
}

/* ── TRUST BAR ── */
@media (max-width: 600px) {
  #shopify-section-{{ section.id }} .pst-rs__trust-inner {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px 8px;
    justify-items: center;
  }
  #shopify-section-{{ section.id }} .pst-rs__trust-item {
    font-size: 10px;
    flex-direction: column;
    text-align: center;
    gap: 4px;
  }
}

/* ── 3 WAYS TO REORDER ── */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .pst-rs__ways {
    padding: 48px 20px;
  }
  #shopify-section-{{ section.id }} .pst-rs__ways-grid {
    grid-template-columns: 1fr;
    gap: 16px;
  }
  #shopify-section-{{ section.id }} .pst-rs__way-card {
    padding: 28px 20px;
  }
  #shopify-section-{{ section.id }} .pst-rs__way-icon {
    font-size: 32px;
  }
  #shopify-section-{{ section.id }} .pst-rs__way-title {
    font-size: 18px;
  }
  #shopify-section-{{ section.id }} .pst-rs__way-contact {
    font-size: 15px;
    word-break: break-all;
  }
}

/* ── SUPPLY REFERENCE ── */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .pst-rs__supplies {
    padding: 48px 20px;
  }
  #shopify-section-{{ section.id }} .pst-rs__supplies-grid {
    grid-template-columns: 1fr 1fr;
    gap: 12px;
  }
  #shopify-section-{{ section.id }} .pst-rs__supply-card {
    padding: 18px 14px;
  }
  #shopify-section-{{ section.id }} .pst-rs__supply-name {
    font-size: 13px;
  }
  #shopify-section-{{ section.id }} .pst-rs__supply-desc {
    font-size: 12px;
  }
}

@media (max-width: 400px) {
  #shopify-section-{{ section.id }} .pst-rs__supplies-grid {
    grid-template-columns: 1fr;
  }
}

/* ── RELATED LINKS ── */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .pst-rs__related {
    padding: 40px 20px;
  }
  #shopify-section-{{ section.id }} .pst-rs__related-links {
    gap: 8px;
  }
  #shopify-section-{{ section.id }} .pst-rs__related-link {
    font-size: 13px;
    padding: 9px 14px;
  }
}

/* ── CTA BANNER ── */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .pst-rs__cta {
    padding: 48px 20px;
  }
  #shopify-section-{{ section.id }} .pst-rs__cta-title {
    font-size: clamp(20px, 6vw, 28px);
  }
  #shopify-section-{{ section.id }} .pst-rs__cta-sub {
    font-size: 14px;
    word-break: break-word;
  }
  #shopify-section-{{ section.id }} .pst-rs__cta-btns {
    flex-direction: column;
    align-items: center;
    gap: 10px;
  }
  #shopify-section-{{ section.id }} .pst-rs__cta-btn-white,
  #shopify-section-{{ section.id }} .pst-rs__cta-btn-outline {
    width: 100%;
    max-width: 300px;
    text-align: center;
  }
}

/* ── SECTION TITLES ── */
@media (max-width: 768px) {
  #shopify-section-{{ section.id }} .pst-rs__section-title {
    font-size: clamp(20px, 5vw, 26px);
    margin-bottom: 24px;
  }
}

{%- endstyle -%}

<!-- HERO -->
<div class="pst-rs__hero">
  <div class="pst-rs__hero-inner">
