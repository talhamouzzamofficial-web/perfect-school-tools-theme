{%- style -%}
  #shopify-section-{{ section.id }} .pst-stats-bar {
    background-color: #fff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__grid {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
    }
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__item {
    flex: 1 1 0;
    text-align: center;
    padding: 2rem 1.5rem;
    position: relative;
  }

  @media screen and (min-width: 750px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__item:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 25%;
      right: 0;
      width: 1px;
      height: 50%;
      background-color: rgba(15, 72, 114, 0.2);
    }
  }

  @media screen and (max-width: 749px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__item:not(:last-child) {
      border-bottom: 1px solid rgba(15, 72, 114, 0.15);
    }
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__value {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--pst-color-gold, #f5b731);
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__label {
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--pst-color-navy, #0f4872);
    max-width: 16rem;
    margin: 0 auto;
  }
{%- endstyle -%}

<section class="pst-stats-bar">
  <div class="pst-stats-bar__inner">
    <div class="pst-stats-bar__grid">
      {%- for block in section.blocks -%}
        <div class="pst-stats-bar__item" {{ block.shopify_attributes }}>
          <span class="pst-stats-bar__value">{{ block.settings.value | escape }}</span>
          <span class="pst-stats-bar__label">{{ block.settings.label | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST Stats bar",
  "tag": "section",
  "class": "pst-stats-bar-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "default": "30+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Years Serving Schools"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PST Stats bar",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "30+",
            "label": "Years Serving Schools"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "5,000+",
            "label": "Schools Nationwide"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "1,500+",
            "label": "Districts Served"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "100%",
            "label": "Satisfaction Guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
