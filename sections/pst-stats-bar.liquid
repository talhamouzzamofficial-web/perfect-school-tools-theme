{%- style -%}
  #shopify-section-{{ section.id }} .pst-stats-bar {
    background-color: #fff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__grid {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__grid {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 0;
    }

    #shopify-section-{{ section.id }} .pst-stats-bar__item {
      padding: 1.15rem 0.85rem;
      border: 1px solid rgba(15, 72, 114, 0.12);
      margin: 0;
    }

    #shopify-section-{{ section.id }} .pst-stats-bar__item:not(:last-child) {
      border-bottom: none;
    }

    #shopify-section-{{ section.id }} .pst-stats-bar__value {
      font-size: clamp(2.2rem, 6vw, 2.8rem);
      margin-bottom: 0.35rem;
    }

    #shopify-section-{{ section.id }} .pst-stats-bar__label {
      font-size: 1.2rem;
      max-width: none;
    }
  }

  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__grid {
      flex-direction: row;
      align-items: stretch;
      justify-content: center;
      display: flex;
    }
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__item {
    flex: 1 1 0;
    text-align: center;
    padding: 2rem 1.5rem;
    position: relative;
  }

  @media screen and (min-width: 769px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__item:not(:last-child)::after {
      content: '';
      position: absolute;
      top: 25%;
      right: 0;
      width: 1px;
      height: 50%;
      background-color: rgba(15, 72, 114, 0.2);
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__item::after {
      display: none !important;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1024px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__item {
      padding: 1.5rem 1rem;
    }

    #shopify-section-{{ section.id }} .pst-stats-bar__value {
      font-size: clamp(2.6rem, 4vw, 3.2rem);
    }

    #shopify-section-{{ section.id }} .pst-stats-bar__label {
      font-size: 1.3rem;
    }
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-stats-bar__inner {
      padding: 0 1rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__value {
    display: block;
    margin-bottom: 0.5rem;
    font-family: var(--font-heading-family);
    font-size: clamp(3rem, 5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.1;
    color: var(--pst-color-gold, #f5b731);
  }

  #shopify-section-{{ section.id }} .pst-stats-bar__label {
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    font-weight: 600;
    line-height: 1.35;
    color: var(--pst-color-navy, #0f4872);
    max-width: 16rem;
    margin: 0 auto;
  }
{%- endstyle -%}

<section class="pst-stats-bar">
  <div class="pst-stats-bar__inner">
    <div class="pst-stats-bar__grid">
      {%- for block in section.blocks -%}
        <div class="pst-stats-bar__item" {{ block.shopify_attributes }}>
          <span class="pst-stats-bar__value">{{ block.settings.value | escape }}</span>
          <span class="pst-stats-bar__label">{{ block.settings.label | escape }}</span>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST Stats bar",
  "tag": "section",
  "class": "pst-stats-bar-section",
  "max_blocks": 4,
  "settings": [
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 48
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 100,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 48
    }
  ],
  "blocks": [
    {
      "type": "stat",
      "name": "Stat",
      "settings": [
        {
          "type": "text",
          "id": "value",
          "label": "Number",
          "default": "30+"
        },
        {
          "type": "text",
          "id": "label",
          "label": "Label",
          "default": "Years Experience Serving Schools"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PST Stats bar",
      "blocks": [
        {
          "type": "stat",
          "settings": {
            "value": "30+",
            "label": "Years Experience Serving Schools"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "K–12 Focused",
            "label": "Built exclusively for schools and districts"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "Nationwide",
            "label": "Serving schools in all 50 states"
          }
        },
        {
          "type": "stat",
          "settings": {
            "value": "100%",
            "label": "Satisfaction Guarantee"
          }
        }
      ]
    }
  ]
}
{% endschema %}
