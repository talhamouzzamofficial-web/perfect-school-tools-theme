{%- style -%}
  #shopify-section-{{ section.id }} .pst-features {
    background-color: var(--pst-color-warm-white, #fdf8f0);
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pst-features__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  #shopify-section-{{ section.id }} .pst-features__header {
    text-align: center;
    max-width: 72rem;
    margin: 0 auto 4rem;
  }

  #shopify-section-{{ section.id }} .pst-features__title {
    margin: 0 0 1.2rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.8rem, 4.5vw, 3.8rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--pst-color-navy, #0f4872);
  }

  #shopify-section-{{ section.id }} .pst-features__subtitle {
    margin: 0;
    font-family: var(--font-body-family);
    font-size: 1.75rem;
    line-height: 1.55;
    font-weight: 400;
    color: var(--pst-color-slate, #334155);
  }

  #shopify-section-{{ section.id }} .pst-features__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-features__inner {
      padding: 0 1rem;
    }

    #shopify-section-{{ section.id }} .pst-features__card {
      width: 100%;
      max-width: none;
    }
  }

  @media screen and (min-width: 769px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .pst-features__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pst-features__grid {
      grid-template-columns: repeat(3, 1fr);
      gap: 2.4rem 2rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-features__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2.2rem 2rem;
    background-color: #fff;
    border-radius: 0.6rem;
    box-shadow: 0 2px 12px rgba(10, 37, 64, 0.08);
    border: 1px solid rgba(15, 72, 114, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .pst-features__card:hover {
    transform: translateY(-6px);
    box-shadow: 0 12px 28px rgba(10, 37, 64, 0.14);
  }

  #shopify-section-{{ section.id }} .pst-features__icon {
    display: block;
    margin-bottom: 1.2rem;
    font-size: 2.6rem;
    line-height: 1;
  }

  #shopify-section-{{ section.id }} .pst-features__card-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: 1.65rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pst-color-primary-dark-navy, #0a2540);
  }

  #shopify-section-{{ section.id }} .pst-features__card-text {
    margin: 0;
    flex-grow: 1;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    line-height: 1.55;
    font-weight: 400;
    color: var(--pst-color-slate, #334155);
  }
{%- endstyle -%}

<section class="pst-features">
  <div class="pst-features__inner">
    <header class="pst-features__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="pst-features__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="pst-features__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div class="pst-features__grid">
      {%- for block in section.blocks -%}
        <article class="pst-features__card" {{ block.shopify_attributes }}>
          {%- if block.settings.icon != blank -%}
            <span class="pst-features__icon" aria-hidden="true">{{ block.settings.icon | escape }}</span>
          {%- endif -%}
          {%- if block.settings.title != blank -%}
            <h3 class="pst-features__card-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="pst-features__card-text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST Features grid",
  "tag": "section",
  "class": "pst-features-section",
  "max_blocks": 12,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Built for the Way Schools Buy"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "We understand the unique purchasing process of schools and districts."
    },
    {
      "type": "header",
      "content": "Spacing"
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "Feature",
      "settings": [
        {
          "type": "text",
          "id": "icon",
          "label": "Icon",
          "default": "✓",
          "info": "Emoji or short symbol"
        },
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Feature title"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Description text."
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PST Features grid",
      "blocks": [
        {
          "type": "feature",
          "settings": {
            "icon": "✓",
            "title": "Purchase Orders Welcome",
            "text": "We gladly accept school purchase orders. Simply email your PO and we'll process your order immediately."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🏫",
            "title": "District-Wide Pricing",
            "text": "Special pricing for district-level purchases. Contact us for volume discounts."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "📞",
            "title": "Unlimited Support",
            "text": "Every system includes unlimited phone and web support."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🎨",
            "title": "Free Digital Resources",
            "text": "Access thousands of ready-to-print educational poster templates."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🚚",
            "title": "Fast, Free Shipping",
            "text": "Free shipping on qualifying orders. Most systems ship within 2-3 business days."
          }
        },
        {
          "type": "feature",
          "settings": {
            "icon": "🛡",
            "title": "Warranty & Protection",
            "text": "Every system comes with a warranty and our satisfaction guarantee."
          }
        }
      ]
    }
  ]
}
{% endschema %}
