{%- style -%}
  #shopify-section-{{ section.id }} {
    overflow-x: hidden;
    max-width: 100%;
  }

  #shopify-section-{{ section.id }} .pst-for-role {
    background-color: #fff;
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }

  #shopify-section-{{ section.id }} .pst-for-role__inner {
    max-width: var(--page-width);
    margin: 0 auto;
    padding: 0 2rem;
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-for-role__inner {
      padding: 0 1rem;
    }
  }

  #shopify-section-{{ section.id }} .pst-for-role__header {
    text-align: center;
    max-width: 52rem;
    margin: 0 auto 3.5rem;
  }

  #shopify-section-{{ section.id }} .pst-for-role__title {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: clamp(2.6rem, 4vw, 3.6rem);
    font-weight: 800;
    line-height: 1.15;
    color: var(--pst-color-navy, #0f4872);
  }

  #shopify-section-{{ section.id }} .pst-for-role__subtitle {
    margin: 0;
    font-size: clamp(1.45rem, 2.2vw, 1.75rem);
    line-height: 1.55;
    font-weight: 500;
    color: var(--pst-color-slate, #334155);
  }

  #shopify-section-{{ section.id }} .pst-for-role__grid {
    display: grid;
    grid-template-columns: 1fr;
    gap: 2rem;
  }

  @media screen and (min-width: 769px) and (max-width: 1023px) {
    #shopify-section-{{ section.id }} .pst-for-role__grid {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (min-width: 1024px) {
    #shopify-section-{{ section.id }} .pst-for-role__grid {
      grid-template-columns: repeat(4, 1fr);
      gap: 1.75rem;
      align-items: stretch;
    }
  }

  #shopify-section-{{ section.id }} .pst-for-role__card {
    display: flex;
    flex-direction: column;
    height: 100%;
    padding: 2rem 1.75rem;
    background-color: var(--pst-color-warm-white, #fdf8f0);
    border-radius: 0.6rem;
    box-shadow: 0 2px 12px rgba(10, 37, 64, 0.08);
    border: 1px solid rgba(15, 72, 114, 0.06);
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  #shopify-section-{{ section.id }} .pst-for-role__card:hover {
    transform: translateY(-4px);
    box-shadow: 0 12px 28px rgba(10, 37, 64, 0.12);
  }

  #shopify-section-{{ section.id }} .pst-for-role__card-title {
    margin: 0 0 1rem;
    font-family: var(--font-heading-family);
    font-size: 1.6rem;
    font-weight: 700;
    line-height: 1.25;
    color: var(--pst-color-primary-dark-navy, #0a2540);
  }

  #shopify-section-{{ section.id }} .pst-for-role__card-text {
    margin: 0 0 1.5rem;
    flex-grow: 1;
    font-family: var(--font-body-family);
    font-size: 1.45rem;
    line-height: 1.55;
    color: var(--pst-color-slate, #334155);
  }

  #shopify-section-{{ section.id }} .pst-for-role__btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-height: 4rem;
    padding: 0 1.25rem;
    font-size: 1.35rem;
    font-weight: 700;
    text-decoration: none;
    text-align: center;
    border-radius: 0.55rem;
    border: 2px solid var(--pst-color-navy, #0f4872);
    color: var(--pst-color-navy, #0f4872);
    background-color: transparent;
    transition: background-color 0.3s ease, color 0.3s ease, border-color 0.3s ease;
  }

  #shopify-section-{{ section.id }} .pst-for-role__btn:hover,
  #shopify-section-{{ section.id }} .pst-for-role__btn:focus {
    background-color: var(--pst-color-navy, #0f4872);
    color: #fff;
    border-color: var(--pst-color-navy, #0f4872);
  }

  @media screen and (max-width: 768px) {
    #shopify-section-{{ section.id }} .pst-for-role__title {
      font-size: clamp(2.2rem, 5vw, 2.8rem);
    }

    #shopify-section-{{ section.id }} .pst-for-role__subtitle {
      font-size: 1.45rem;
    }

    #shopify-section-{{ section.id }} .pst-for-role__card {
      padding: 1.65rem 1.25rem;
    }

    #shopify-section-{{ section.id }} .pst-for-role__card-text {
      font-size: 1.35rem;
    }

    #shopify-section-{{ section.id }} .pst-for-role__btn {
      width: 100%;
      max-width: 100%;
    }
  }
{%- endstyle -%}

<section class="pst-for-role">
  <div class="pst-for-role__inner">
    <header class="pst-for-role__header">
      {%- if section.settings.heading != blank -%}
        <h2 class="pst-for-role__title">{{ section.settings.heading | escape }}</h2>
      {%- endif -%}
      {%- if section.settings.subtitle != blank -%}
        <p class="pst-for-role__subtitle">{{ section.settings.subtitle | escape }}</p>
      {%- endif -%}
    </header>

    <div class="pst-for-role__grid">
      {%- for block in section.blocks -%}
        <article class="pst-for-role__card" {{ block.shopify_attributes }}>
          {%- if block.settings.title != blank -%}
            <h3 class="pst-for-role__card-title">{{ block.settings.title | escape }}</h3>
          {%- endif -%}
          {%- if block.settings.text != blank -%}
            <p class="pst-for-role__card-text">{{ block.settings.text | escape }}</p>
          {%- endif -%}
          {%- if block.settings.button_label != blank and block.settings.button_link != blank -%}
            <a class="pst-for-role__btn" href="{{ block.settings.button_link }}">
              {{- block.settings.button_label | escape -}}
            </a>
          {%- endif -%}
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "PST For your role",
  "tag": "section",
  "class": "pst-for-your-role-section",
  "max_blocks": 8,
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "For Your Role"
    },
    {
      "type": "textarea",
      "id": "subtitle",
      "label": "Subtitle",
      "default": "Resources tailored to how your school buys and uses visual tools."
    },
    {
      "type": "range",
      "id": "padding_top",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding top",
      "default": 72
    },
    {
      "type": "range",
      "id": "padding_bottom",
      "min": 24,
      "max": 120,
      "step": 4,
      "unit": "px",
      "label": "Padding bottom",
      "default": 72
    }
  ],
  "blocks": [
    {
      "type": "role",
      "name": "Role card",
      "settings": [
        {
          "type": "text",
          "id": "title",
          "label": "Title",
          "default": "Administrators"
        },
        {
          "type": "textarea",
          "id": "text",
          "label": "Description",
          "default": "Streamline visual communication across your entire school or district."
        },
        {
          "type": "text",
          "id": "button_label",
          "label": "Button label",
          "default": "Learn More"
        },
        {
          "type": "url",
          "id": "button_link",
          "label": "Button link"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "PST For your role",
      "blocks": [
        {
          "type": "role",
          "settings": {
            "title": "Administrators",
            "text": "Streamline visual communication across your entire school or district. Manage budgets, approve purchases, and equip every department with professional printing tools.",
            "button_label": "Learn More",
            "button_link": "/pages/for-administrators"
          }
        },
        {
          "type": "role",
          "settings": {
            "title": "Media Specialists",
            "text": "Equip your library or media center with poster makers, award systems, and laminators built for student displays and literacy programs.",
            "button_label": "Learn More",
            "button_link": "/pages/for-media-specialists"
          }
        },
        {
          "type": "role",
          "settings": {
            "title": "Bookkeepers",
            "text": "We gladly accept school purchase orders. Get clear invoicing, Net terms, and a straightforward reorder process for your district.",
            "button_label": "Learn More",
            "button_link": "/pages/for-bookkeepers"
          }
        },
        {
          "type": "role",
          "settings": {
            "title": "Teachers",
            "text": "Create classroom visuals and student recognition in minutes with tools designed for busy educators.",
            "button_label": "Learn More",
            "button_link": "/pages/for-teachers"
          }
        }
      ]
    }
  ]
}
{% endschema %}
