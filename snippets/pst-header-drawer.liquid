{% comment %}
  Mobile / tablet menu — PST nav (matches desktop pst-header).
{% endcomment %}

{%- liquid
  assign drawer_cta_url = pst_drawer_cta_url
  assign drawer_cta_label = pst_drawer_cta_label | default: 'Request a Quote'
  if pst_drawer_show_cta == false
    assign drawer_show_cta = false
  else
    assign drawer_show_cta = true
  endif
  assign drawer_cta_bg = pst_drawer_cta_bg | default: '#E91E8C'
  assign drawer_cta_fg = pst_drawer_cta_fg | default: '#ffffff'
-%}

{%- style -%}
  /* Overlay: dark scrim + blur */
  #Details-pst-menu-drawer[open] > summary::before {
    background: rgba(0, 0, 0, 0.5) !important;
    backdrop-filter: blur(2px);
    -webkit-backdrop-filter: blur(2px);
  }

  #menu-drawer-pst.pst-drawer--pst {
    width: 85vw !important;
    max-width: 360px !important;
    padding: 0 !important;
    background: #fff !important;
    background-color: #fff !important;
    border: none !important;
    filter: none !important;
    box-shadow: 4px 0 24px rgba(10, 37, 64, 0.12);
  }

  .js details[open].menu-opening > #menu-drawer-pst.pst-drawer--pst,
  .js details[open] > #menu-drawer-pst.pst-drawer--pst {
    transition:
      transform 0.3s ease,
      visibility 0.3s ease !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__inner-container {
    padding: 0 !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__navigation-container {
    grid-template-rows: auto;
    align-content: start;
    overflow-x: hidden;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__masthead {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px 12px;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__brand {
    display: flex;
    align-items: center;
    flex: 1;
    min-width: 0;
    text-decoration: none;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__logo-img {
    width: 80px !important;
    max-width: 80px !important;
    height: auto !important;
    display: block;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__brand-text {
    font-family: var(--font-heading-family);
    font-weight: 800;
    font-size: 1.1rem;
    color: #0a2540;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__close-btn {
    flex-shrink: 0;
    width: 40px;
    height: 40px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: 0;
    border: none;
    background: transparent;
    color: #0a2540;
    cursor: pointer;
    border-radius: 8px;
    transition: background 0.2s ease;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__close-btn:hover {
    background: #f1f5f9;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__close-btn svg {
    width: 22px;
    height: 22px;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__divider {
    border: none;
    border-top: 1px solid #e8e8e8;
    margin: 0;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__cta {
    display: block;
    width: calc(100% - 32px);
    max-width: none;
    box-sizing: border-box;
    margin: 16px;
    padding: 14px 20px;
    background: var(--pst-drawer-cta-bg, #e91e8c) !important;
    color: var(--pst-drawer-cta-fg, #ffffff) !important;
    text-align: center;
    font-weight: 600;
    font-size: 15px;
    text-decoration: none;
    border-radius: 8px;
    border: none;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__cta:hover {
    filter: brightness(1.05);
    color: var(--pst-drawer-cta-fg, #ffffff) !important;
  }

  /* List / nav reset */
  #menu-drawer-pst.pst-drawer--pst .header__menu-item,
  #menu-drawer-pst.pst-drawer--pst .header__menu-item a,
  #menu-drawer-pst.pst-drawer--pst .menu-drawer__menu,
  #menu-drawer-pst.pst-drawer--pst .menu-drawer__menu li,
  #menu-drawer-pst.pst-drawer--pst .menu-drawer__menu ul {
    list-style: none !important;
    list-style-type: none !important;
    padding-left: 0 !important;
    margin-left: 0 !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__menu {
    padding: 0 !important;
    margin: 0 !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__navigation {
    padding: 0 !important;
    margin: 0 !important;
  }

  #menu-drawer-pst.pst-drawer--pst .js .menu-drawer__menu li {
    margin-bottom: 0 !important;
    list-style: none !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__menu-item {
    padding: 0 !important;
    margin: 0 !important;
    list-style: none !important;
    font-size: 1.5rem;
  }

  #menu-drawer-pst.pst-drawer--pst a.pst-drawer__text-link {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 14px 20px !important;
    font-size: 15px !important;
    font-weight: 500 !important;
    color: #0a2540 !important;
    text-decoration: none !important;
    border-bottom: 1px solid #f1f5f9;
    width: 100%;
    box-sizing: border-box;
  }

  #menu-drawer-pst.pst-drawer--pst a.pst-drawer__text-link::after {
    content: '→';
    font-size: 14px;
    color: #64748b;
    flex-shrink: 0;
  }

  #menu-drawer-pst.pst-drawer--pst a.pst-drawer__text-link:hover {
    background: #f8fafc !important;
    color: #e91e8c !important;
  }

  #menu-drawer-pst.pst-drawer--pst a.pst-drawer__text-link--sub {
    padding: 12px 20px 12px 32px !important;
    font-size: 14px !important;
    font-weight: 500 !important;
    color: #64748b !important;
  }

  #menu-drawer-pst.pst-drawer--pst a.pst-drawer__text-link--sub::after {
    content: none !important;
  }

  #menu-drawer-pst.pst-drawer--pst a.pst-drawer__text-link--sub:hover {
    color: #e91e8c !important;
    background: #f8fafc !important;
  }

  /* Parent row (Shop) */
  #menu-drawer-pst.pst-drawer--pst details summary.menu-drawer__menu-item {
    display: flex !important;
    align-items: center;
    justify-content: space-between;
    padding: 14px 20px !important;
    font-size: 15px !important;
    font-weight: 500 !important;
    color: #0a2540 !important;
    border-bottom: 1px solid #f1f5f9;
    list-style: none !important;
    cursor: pointer;
    width: 100%;
    box-sizing: border-box;
  }

  #menu-drawer-pst.pst-drawer--pst details summary.menu-drawer__menu-item::-webkit-details-marker {
    display: none;
  }

  #menu-drawer-pst.pst-drawer--pst details summary.menu-drawer__menu-item .svg-wrapper {
    display: none !important;
  }

  #menu-drawer-pst.pst-drawer--pst details summary.menu-drawer__menu-item::after {
    content: '▾';
    font-size: 12px;
    color: #64748b;
    flex-shrink: 0;
  }

  #menu-drawer-pst.pst-drawer--pst details summary.menu-drawer__menu-item:hover {
    background: #f8fafc;
    color: #e91e8c !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__close-button {
    margin: 0 !important;
    padding: 14px 20px !important;
    font-size: 14px !important;
    font-weight: 600;
    color: #0a2540 !important;
    border-bottom: 1px solid #f1f5f9;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__inner-submenu {
    padding: 0 !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__inner-submenu .menu-drawer__menu {
    padding: 0 !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__inner-submenu .menu-drawer__menu-item {
    padding: 0 !important;
  }

  /* Bottom: account + cart */
  #menu-drawer-pst.pst-drawer--pst .pst-drawer__bottom {
    display: flex;
    flex-direction: row;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 16px 20px;
    border-top: 1px solid #e8e8e8;
    margin-top: 0;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__bottom-link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    flex: 1;
    justify-content: center;
    font-size: 14px;
    font-weight: 600;
    color: #0a2540 !important;
    text-decoration: none !important;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__bottom-link .svg-wrapper {
    width: 22px;
    height: 22px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  #menu-drawer-pst.pst-drawer--pst .pst-drawer__bottom-link:hover {
    color: #e91e8c !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__utility-links {
    padding: 12px 20px 16px !important;
    background: #fff !important;
    margin: 0 !important;
    border-top: 1px solid #f1f5f9;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer__utility-links a.menu-drawer__account {
    display: none !important;
  }

  #menu-drawer-pst.pst-drawer--pst .menu-drawer .list-social {
    margin: 8px 0 0 !important;
    justify-content: center !important;
  }
{%- endstyle -%}

<header-drawer data-breakpoint="tablet">
  <details id="Details-pst-menu-drawer" class="menu-drawer-container">
    <summary
      class="header__icon header__icon--menu header__icon--summary link focus-inset"
      aria-label="{{ 'sections.header.menu' | t }}"
    >
      <span>
        {{- 'icon-hamburger.svg' | inline_asset_content -}}
        {{- 'icon-close.svg' | inline_asset_content -}}
      </span>
    </summary>
    <div
      id="menu-drawer-pst"
      class="gradient menu-drawer motion-reduce pst-drawer pst-drawer--pst pst-drawer--panel color-{{ section.settings.menu_color_scheme }}"
      style="--pst-drawer-cta-bg: {{ drawer_cta_bg }}; --pst-drawer-cta-fg: {{ drawer_cta_fg }};"
    >
      <div class="menu-drawer__inner-container pst-drawer__inner">
        <div class="menu-drawer__navigation-container pst-drawer__nav-container">
          <div class="pst-drawer__masthead">
            <a href="{{ routes.root_url }}" class="pst-drawer__brand focus-inset">
              {%- if settings.logo != blank -%}
                {%- assign drawer_logo_alt = settings.logo.alt | default: shop.name | escape -%}
                {%- assign drawer_logo_h = 80 | times: 1.0 | divided_by: settings.logo.aspect_ratio | round -%}
                {{
                  settings.logo
                  | image_url: width: 240
                  | image_tag:
                    class: 'pst-drawer__logo-img',
                    width: 80,
                    height: drawer_logo_h,
                    alt: drawer_logo_alt,
                    loading: 'lazy'
                }}
              {%- else -%}
                <span class="pst-drawer__brand-text">{{ shop.name | escape }}</span>
              {%- endif -%}
            </a>
            <button
              type="button"
              class="pst-drawer__close-btn"
              aria-label="{{ 'accessibility.close' | t }}"
            >
              <span class="svg-wrapper">{{ 'icon-close.svg' | inline_asset_content }}</span>
            </button>
          </div>

          <hr class="pst-drawer__divider" aria-hidden="true">

          {%- if drawer_show_cta and drawer_cta_url != blank -%}
            <a href="{{ drawer_cta_url }}" class="pst-drawer__cta">
              {{ drawer_cta_label | escape }}
            </a>
          {%- endif -%}

          <nav class="menu-drawer__navigation pst-drawer__navigation" aria-label="{{ 'sections.header.menu' | t }}">
            <ul class="menu-drawer__menu has-submenu list-menu pst-drawer__menu-root" role="list">
              <li>
                <a
                  href="https://perfectposter.com/pages/postermaker"
                  class="menu-drawer__menu-item list-menu__item link link--text focus-inset pst-drawer__text-link"
                >
                  Poster Makers
                </a>
              </li>
              <li>
                <a
                  href="https://perfectposter.com/pages/perfect-awards-systems"
                  class="menu-drawer__menu-item list-menu__item link link--text focus-inset pst-drawer__text-link"
                >
                  Awards Systems
                </a>
              </li>
              <li>
                <a
                  href="https://perfectposter.com/collections/lamination"
                  class="menu-drawer__menu-item list-menu__item link link--text focus-inset pst-drawer__text-link"
                >
                  Laminators
                </a>
              </li>
              <li>
                <details id="Details-pst-drawer-shop">
                  <summary class="menu-drawer__menu-item list-menu__item link link--text focus-inset">
                    Shop
                    <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                    <span class="svg-wrapper">{{- 'icon-caret.svg' | inline_asset_content -}}</span>
                  </summary>
                  <div class="menu-drawer__submenu has-submenu gradient motion-reduce" tabindex="-1">
                    <div class="menu-drawer__inner-submenu">
                      <button type="button" class="menu-drawer__close-button link link--text focus-inset" aria-expanded="true">
                        <span class="svg-wrapper">{{- 'icon-arrow.svg' | inline_asset_content -}}</span>
                        Shop
                      </button>
                      <ul class="menu-drawer__menu list-menu" role="list" tabindex="-1">
                        <li>
                          <a
                            href="https://perfectposter.com/collections/paper-media"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset pst-drawer__text-link pst-drawer__text-link--sub"
                          >
                            Poster Paper &amp; Materials
                          </a>
                        </li>
                        <li>
                          <a
                            href="https://perfectposter.com/collections/ink"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset pst-drawer__text-link pst-drawer__text-link--sub"
                          >
                            Poster Maker Ink
                          </a>
                        </li>
                        <li>
                          <a
                            href="https://perfectposter.com/collections/lamination"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset pst-drawer__text-link pst-drawer__text-link--sub"
                          >
                            Lamination Supplies
                          </a>
                        </li>
                        <li>
                          <a
                            href="https://perfectposter.com/collections/maintenance"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset pst-drawer__text-link pst-drawer__text-link--sub"
                          >
                            Maintenance Supplies
                          </a>
                        </li>
                        <li>
                          <a
                            href="https://perfectposter.com/collections/awards-maker-labels"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset pst-drawer__text-link pst-drawer__text-link--sub"
                          >
                            Award System Supplies
                          </a>
                        </li>
                        <li>
                          <a
                            href="https://perfectposter.com/collections/perfect-bundles"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset pst-drawer__text-link pst-drawer__text-link--sub"
                          >
                            Bundled Supply Packages
                          </a>
                        </li>
                        <li>
                          <a
                            href="https://perfectposter.com/collections/current-specials"
                            class="menu-drawer__menu-item link link--text list-menu__item focus-inset pst-drawer__text-link pst-drawer__text-link--sub"
                          >
                            Current Specials
                          </a>
                        </li>
                      </ul>
                    </div>
                  </div>
                </details>
              </li>
              <li>
                <a
                  href="https://perfectposter.com/collections/free-poster-template-downloads"
                  class="menu-drawer__menu-item list-menu__item link link--text focus-inset pst-drawer__text-link"
                >
                  Free Resources
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.root_url }}pages/about"
                  class="menu-drawer__menu-item list-menu__item link link--text focus-inset pst-drawer__text-link"
                >
                  About Us
                </a>
              </li>
              <li>
                <a
                  href="{{ routes.root_url }}pages/contact"
                  class="menu-drawer__menu-item list-menu__item link link--text focus-inset pst-drawer__text-link"
                >
                  Contact
                </a>
              </li>
            </ul>
          </nav>

          <div class="pst-drawer__bottom">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="pst-drawer__bottom-link"
                rel="nofollow"
              >
                <span class="svg-wrapper">{{ 'icon-account.svg' | inline_asset_content }}</span>
                <span>
                  {%- liquid
                    if customer
                      echo 'customer.account_fallback' | t
                    else
                      echo 'customer.log_in' | t
                    endif
                  -%}
                </span>
              </a>
            {%- endif -%}
            <a href="{{ routes.cart_url }}" class="pst-drawer__bottom-link pst-drawer__bottom-cart">
              {% if cart == empty %}
                <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
              {% else %}
                <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
              {% endif %}
              <span>{{ 'templates.cart.cart' | t }} ({{ cart.item_count }})</span>
            </a>
          </div>

          <div class="menu-drawer__utility-links">
            {%- if shop.customer_accounts_enabled -%}
              <a
                href="{%- if customer -%}{{ routes.account_url }}{%- else -%}{{ routes.account_login_url }}{%- endif -%}"
                class="menu-drawer__account link focus-inset h5 medium-hide large-up-hide"
                rel="nofollow"
              >
                {%- if section.settings.enable_customer_avatar -%}
                  <account-icon>
                    {%- if customer and customer.has_avatar? -%}
                      {{ customer | avatar }}
                    {%- else -%}
                      <span class="svg-wrapper">
                        {{- 'icon-account.svg' | inline_asset_content -}}
                      </span>
                    {%- endif -%}
                  </account-icon>
                {%- else -%}
                  <span class="svg-wrapper">
                    {{- 'icon-account.svg' | inline_asset_content -}}
                  </span>
                {%- endif -%}
                {%- liquid
                  if customer
                    echo 'customer.account_fallback' | t
                  else
                    echo 'customer.log_in' | t
                  endif
                -%}
              </a>
            {%- endif -%}
            {%- if localization.available_countries or localization.available_languages -%}
              <div class="menu-drawer__localization header-localization">
                {%- if localization.available_countries and localization.available_countries.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'PstHeaderCountryMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="PstHeaderCountryMobileLabel">
                          {{ 'localization.country_label' | t }}
                        </h2>
                        {%- render 'country-localization', localPosition: 'PstHeaderCountryMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {% endif %}

                {%- if localization.available_languages and localization.available_languages.size > 1 -%}
                  <localization-form>
                    {%- form 'localization', id: 'PstHeaderLanguageMobileForm', class: 'localization-form' -%}
                      <div>
                        <h2 class="visually-hidden" id="PstHeaderLanguageMobileLabel">
                          {{ 'localization.language_label' | t }}
                        </h2>
                        {%- render 'language-localization', localPosition: 'PstHeaderLanguageMobile' -%}
                      </div>
                    {%- endform -%}
                  </localization-form>
                {%- endif -%}
              </div>
            {%- endif -%}
            <ul class="list list-social list-unstyled" role="list">
              {%- if settings.social_twitter_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_twitter_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-twitter.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.twitter' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_facebook_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_facebook_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-facebook.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.facebook' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_pinterest_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_pinterest_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-pinterest.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.pinterest' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_instagram_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_instagram_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-instagram.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.instagram' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tiktok_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tiktok_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-tiktok.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.tiktok' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_tumblr_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_tumblr_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-tumblr.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.tumblr' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_snapchat_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_snapchat_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-snapchat.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.snapchat' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_youtube_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_youtube_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-youtube.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.youtube' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
              {%- if settings.social_vimeo_link != blank -%}
                <li class="list-social__item">
                  <a href="{{ settings.social_vimeo_link }}" class="list-social__link link">
                    <span class="svg-wrapper">{{- 'icon-vimeo.svg' | inline_asset_content -}}</span>
                    <span class="visually-hidden">{{ 'general.social.links.vimeo' | t }}</span>
                  </a>
                </li>
              {%- endif -%}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </details>
</header-drawer>

<script>
  (function () {
    var root = document.getElementById('Details-pst-menu-drawer');
    if (!root) return;
    var btn = root.querySelector('.pst-drawer__close-btn');
    if (!btn) return;
    btn.addEventListener('click', function (e) {
      e.preventDefault();
      root.removeAttribute('open');
    });
  })();
</script>
